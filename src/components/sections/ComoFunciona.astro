---
import PhoneMockup from '../PhoneMockup.astro';

interface Step {
  screenshot: string;
  alt: string;
  number: number;
  time: string;
  title: string;
  description: string;
}

const steps: Step[] = [
  {
    screenshot: '06-mi-turno.png',
    alt: 'Pantalla Mi turno mostrando el turno abierto del dependiente',
    number: 1,
    time: '8:00 AM',
    title: 'El dependiente abre su turno.',
    description: 'Llega, abre el teléfono, inicia el turno y está listo para vender.'
  },
  {
    screenshot: '02-nueva-venta.png',
    alt: 'Pantalla de nueva venta con productos en el carrito',
    number: 2,
    time: 'Durante el día',
    title: 'Vende y cobra.',
    description: 'Efectivo, transferencia o mixto, con el cambio calculado y el stock descontado automáticamente.'
  },
  {
    screenshot: '05-cuadres.png',
    alt: 'Pantalla de cuadres pendientes de aprobación',
    number: 3,
    time: 'Al cerrar',
    title: 'Cierra y rinde cuentas.',
    description: 'Envía su cuadre. Tú lo apruebas o lo rechazas desde tu casa.'
  }
];
---

<section class="como-funciona" id="como-funciona">
  <div class="container">
    <h2>Así se trabaja un día con MiPyUtil.</h2>
    <p class="section-lead">Desde que abre la tienda hasta que se aprueba el cuadre.</p>

    <div class="timeline-progress" role="progressbar" aria-label="Progreso del flujo de trabajo" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100">
      <div class="timeline-bar"></div>
      <span class="timeline-dot" style="--dot-pos: 16.7%" aria-hidden="true"></span>
      <span class="timeline-dot" style="--dot-pos: 50%" aria-hidden="true"></span>
      <span class="timeline-dot" style="--dot-pos: 83.3%" aria-hidden="true"></span>
    </div>

    <div class="steps">
      {steps.map(step => (
        <div class="step">
          <div class="step-visual">
            <PhoneMockup screenshot={step.screenshot} alt={step.alt} />
          </div>
          <div class="step-content">
            <div class="step-meta">
              <span class="step-number" aria-hidden="true">{step.number}</span>
              <span class="step-time">{step.time}</span>
            </div>
            <h3>{step.title}</h3>
            <p>{step.description}</p>
          </div>
        </div>
      ))}
    </div>

    <p class="section-close">
      <svg class="revert-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <polyline points="1 4 1 10 7 10"></polyline>
        <path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"></path>
      </svg>
      Si rechazas un cuadre, el stock se revierte automáticamente. Nadie se queda con el beneficio de la duda.
    </p>
  </div>
</section>

<script>
  const observeTimeline = () => {
    const stepsContainer = document.querySelector('.como-funciona .steps');
    const progressBar = document.querySelector<HTMLElement>('.timeline-bar');
    const progressContainer = document.querySelector('.timeline-progress');
    const dots = Array.from(document.querySelectorAll('.timeline-dot'));
    const thresholds = [16.7, 50, 83.3];

    if (!stepsContainer || !progressBar || !progressContainer) return;

    let ticking = false;

    const update = () => {
      ticking = false;
      const stepsRect = stepsContainer.getBoundingClientRect();
      const viewportHeight = window.innerHeight;

      // El progreso se llena mientras los pasos cruzan el viewport
      const start = viewportHeight * 0.75;
      const end = viewportHeight * 0.25;
      const totalDistance = stepsRect.height + (start - end);
      const currentDistance = start - stepsRect.top;

      const progress = Math.min(100, Math.max(0, (currentDistance / totalDistance) * 100));

      progressBar.style.transform = `scaleX(${progress / 100})`;
      progressContainer.setAttribute('aria-valuenow', Math.round(progress).toString());

      dots.forEach((dot, i) => {
        dot.classList.toggle('active', progress >= thresholds[i]);
      });

      // La barra flotante solo se ve mientras se está dentro de los pasos
      const isInsideSteps = stepsRect.top < viewportHeight * 0.7 && stepsRect.bottom > 140;
      progressContainer.classList.toggle('is-sticky-active', isInsideSteps);
    };

    const requestUpdate = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    };

    update();
    window.addEventListener('scroll', requestUpdate, { passive: true });
    window.addEventListener('resize', requestUpdate);
  };

  const observeSteps = () => {
    const stepObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('step-active');
            stepObserver.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.4 }
    );

    document.querySelectorAll('.step').forEach((step) => stepObserver.observe(step));
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
      observeTimeline();
      observeSteps();
    });
  } else {
    observeTimeline();
    observeSteps();
  }
</script>

<style>
  .como-funciona h2 {
    margin-bottom: clamp(var(--space-sm), 3vw, var(--space-md));
    max-width: 26ch;
  }

  .section-lead {
    font-size: clamp(var(--fs-body), 2.5vw, var(--fs-lead));
    line-height: var(--lh-lead);
    color: var(--ink-muted);
    margin-bottom: clamp(var(--space-xl), 6vw, var(--space-2xl));
  }

  .timeline-progress {
    position: sticky;
    top: calc(76px + env(safe-area-inset-top, 0px));
    z-index: 50;
    max-width: min(600px, 90vw);
    height: clamp(6px, 1.5vw, 8px);
    background: var(--board-panel);
    border-radius: var(--radius-sm);
    box-shadow: inset 0 0 0 1px var(--line-strong), var(--shadow-soft);
    margin: 0 auto clamp(var(--space-xl), 5vw, var(--space-2xl)) auto;
    opacity: 0;
    transform: translateY(-6px);
    transition: opacity 300ms ease, transform 300ms ease;
    pointer-events: none;
  }

  .timeline-progress.is-sticky-active {
    opacity: 1;
    transform: translateY(0);
  }

  .timeline-bar {
    height: 100%;
    background: var(--accent);
    border-radius: inherit;
    transform: scaleX(0);
    transform-origin: left;
  }

  .timeline-dot {
    position: absolute;
    top: 50%;
    left: var(--dot-pos);
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--plate);
    border: 2px solid var(--line-strong);
    transform: translate(-50%, -50%);
    transition: background-color var(--dur-routine) ease, border-color var(--dur-routine) ease;
  }

  .timeline-dot.active {
    background: var(--accent);
    border-color: var(--accent);
  }

  .steps {
    display: grid;
    gap: clamp(var(--space-2xl), 8vw, var(--space-section-sm));
  }

  .step {
    display: grid;
    gap: clamp(var(--space-lg), 5vw, var(--space-xl));
    align-items: center;
  }

  .step-visual {
    order: 2;
  }

  .step-content {
    order: 1;
  }

  .step-meta {
    display: flex;
    align-items: center;
    gap: clamp(var(--space-sm), 3vw, var(--space-md));
    margin-bottom: clamp(var(--space-sm), 3vw, var(--space-md));
    flex-wrap: wrap;
  }

  .step-number {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: clamp(36px, 9vw, 40px);
    height: clamp(36px, 9vw, 40px);
    background: var(--accent);
    color: var(--accent-on);
    border-radius: var(--radius-md);
    font-size: var(--fs-title);
    font-weight: 800;
    line-height: 1;
    flex-shrink: 0;
    font-variant-numeric: tabular-nums;
  }

  .step-time {
    font-size: clamp(var(--fs-caption), 2vw, var(--fs-label));
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink-muted);
    white-space: nowrap;
  }

  .step h3 {
    margin-bottom: clamp(var(--space-xs), 2vw, var(--space-sm));
    font-size: clamp(var(--fs-title), 2.5vw, 1.375rem);
  }

  .step p {
    color: var(--ink-muted);
    font-size: clamp(0.9375rem, 2.5vw, var(--fs-body));
    line-height: 1.6;
  }

  .section-close {
    margin-top: clamp(var(--space-lg), 5vw, var(--space-xl));
    font-size: clamp(var(--fs-body), 2.5vw, var(--fs-lead));
    font-weight: 600;
    line-height: var(--lh-lead);
    max-width: 60ch;
    display: flex;
    align-items: flex-start;
    gap: var(--space-sm);
    color: var(--ink-muted);
  }

  .revert-icon {
    width: clamp(20px, 5vw, 24px);
    height: clamp(20px, 5vw, 24px);
    flex-shrink: 0;
    color: var(--accent);
    margin-top: 2px;
  }

  @media (min-width: 48rem) {
    .step {
      grid-template-columns: 1fr 1fr;
      gap: clamp(var(--space-xl), 5vw, var(--space-3xl));
    }

    .step-visual {
      order: unset;
    }

    .step-content {
      order: unset;
    }

    .step:nth-child(even) .step-visual {
      order: 2;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .step.step-active .step-number {
      animation: step-pop 300ms var(--ease-out-expo);
    }
  }

  @keyframes step-pop {
    0% {
      transform: scale(1);
      box-shadow: 0 0 0 0 color-mix(in srgb, var(--accent) 0%, transparent);
    }
    40% {
      transform: scale(1.1);
      box-shadow: 0 0 0 6px color-mix(in srgb, var(--accent) 18%, transparent);
    }
    100% {
      transform: scale(1);
      box-shadow: 0 0 0 0 color-mix(in srgb, var(--accent) 0%, transparent);
    }
  }
</style>
