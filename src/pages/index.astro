---
/**
 * THESIS: reemplaza el "SaaS oscuro genérico" heredado (violeta, negro, glow) con
 * el objeto que el dueño ya usa a diario: el tablón de precios curtido por el sol.
 * OWN-WORLD: tablón (#121210 en apagón, #E7DFC9 de día), panel, placas, tinta
 * cálida, acento ámbar/óxido. Anton solo en el h1; Archivo en todo lo demás.
 * Radios casi rectos, sombra estampada única en el CTA principal y el plan
 * recomendado. Cada cifra de negocio es una placa dl real.
 * STORY: el dueño reconoce el tablón que ya usa, ve que se actualiza solo, y
 * entiende que su equipo tiene su propio panel de turno.
 * FIRST VIEWPORT: titular, párrafo, descarga, y dos teléfonos con dos roles
 * (la app del dueño y la del equipo), sin internet.
 * FORM: dirección 6 de 7 por resonancia (pizarra de precios de bodega), seed
 * 4ef913d4, scope direction, mode persuade, candidate-count 7, assigned index 6.
 * EVOLUCIÓN: cada sección con su propia estructura y su propia demostración
 * (teléfono con cobro tocable, tablero de inventario con búsqueda, recibo de
 * ganancia), en lugar de repetir la misma plantilla texto + teléfono.
 */

import Layout from '../layouts/Layout.astro';
import Hero from '../components/sections/Hero.astro';
import Problema from '../components/sections/Problema.astro';
import ComoFunciona from '../components/sections/ComoFunciona.astro';
import Ventas from '../components/sections/Ventas.astro';
import Inventario from '../components/sections/Inventario.astro';
import Ganancias from '../components/sections/Ganancias.astro';
import Precios from '../components/sections/Precios.astro';
import Descarga from '../components/sections/Descarga.astro';
import FAQ from '../components/sections/FAQ.astro';
---

<Layout
  title="MiPyUtil: inventario, ventas y turnos sin internet"
  description="Inventario, ventas y turnos. Todo sin internet."
>
  <Hero />
  <Problema />
  <ComoFunciona />
  <Ventas />
  <Inventario />
  <Ganancias />
  <Precios />
  <Descarga />
  <FAQ />
</Layout>
