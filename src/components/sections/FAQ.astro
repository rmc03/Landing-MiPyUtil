---
interface FAQItem {
  question: string;
  answer: string;
}

const faqs: FAQItem[] = [
  {
    question: '¿Necesita internet?',
    answer: 'No para operar: vender, cobrar y cerrar turno funcionan 100% sin conexión. Cuando hay internet, los datos se sincronizan solos entre los teléfonos de tu equipo, pero nunca tienes que esperar por eso para seguir vendiendo. <strong>Funciona con apagones</strong> y sin conexión a Etecsa.'
  },
  {
    question: '¿Cuándo y cómo se paga?',
    answer: 'Tienes <strong>14 días gratis</strong> para desplegarla en tu negocio sin compromiso. Si decides continuar, la facturación mensual se liquida en moneda nacional desde <strong>1.500 CUP/mes</strong> (con oferta de entrada a <strong>1.200 CUP</strong> el primer mes) mediante <strong>Transferencia bancaria</strong> (Transfermóvil / EnZona). Para licencias anuales con tarifa preferencial (desde <strong>$20 USD/año</strong>), el pago se procesa directamente a través de <strong>Tarjeta Clásica</strong>. Ningún cargo se ejecuta antes de finalizar tu prueba.'
  },
  {
    question: '¿Sirve si no tengo Play Store?',
    answer: 'Sí: la APK se instala directa. Se comparte por <strong>WhatsApp, Telegram o Zapya</strong> y se instala como cualquier APK, sin cuenta de Google.'
  },
  {
    question: '¿Es solo para puntos de venta?',
    answer: 'No: inventario, ventas, turnos y cuadres sirven para cualquier tienda o negocio de servicio, como <strong>cafeterías, talleres, ferreterías, tiendas de ropa, almacenes</strong>, lo que vendas con mercancía y empleados.'
  },
  {
    question: '¿Puedo ver las ventas de cada dependiente?',
    answer: 'Sí: turnos, cuadres e historial por empleado. Cada uno rinde cuentas al cerrar, y <strong>tú decides desde tu casa</strong> si apruebas o rechazas.'
  },
  {
    question: '¿Cómo empiezo?',
    answer: 'Descargas la app para tu dispositivo (Android o Windows), la instalas y empiezas tu prueba gratis de 14 días sin ningún cobro. <a href="https://wa.me/5353770707?text=Hola,%20quisiera%20ayuda%20para%20configurar%20la%20app%20MiPyUtil" target="_blank" rel="noopener noreferrer">Escríbenos por WhatsApp</a> si quieres ayuda para configurarla. <strong>Te respondemos en menos de 1 hora</strong> en horario de trabajo.'
  }
];
---

<section id="faq" class="faq">
  <div class="container">
    <h2>Preguntas frecuentes</h2>

    <div class="faq-list">
      {faqs.map((faq, i) => (
        <div class="faq-item">
          <button
            type="button"
            class="faq-question"
            id={`faq-question-${i}`}
            aria-expanded="false"
            aria-controls={`faq-panel-${i}`}
          >
            <span class="faq-question-text">{faq.question}</span>
          </button>
          <div
            class="faq-panel"
            id={`faq-panel-${i}`}
            role="region"
            aria-labelledby={`faq-question-${i}`}
            inert
          >
            <p set:html={faq.answer} />
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  const faqItems = Array.from(document.querySelectorAll('.faq-item'));

  faqItems.forEach((item) => {
    const button = item.querySelector('.faq-question');
    const panel = item.querySelector('.faq-panel');

    if (!button || !panel) return;

    button.addEventListener('click', () => {
      const isOpen = item.classList.contains('open');
      item.classList.toggle('open', !isOpen);
      button.setAttribute('aria-expanded', String(!isOpen));
      panel.toggleAttribute('inert', isOpen);
    });
  });
</script>

<style is:global>
  .faq {
    background: var(--surface);
    padding: clamp(var(--space-2xl), 8vw, var(--space-3xl)) 0;
  }

  .faq .container {
    max-width: 1120px;
    margin: 0 auto;
    padding: 0 clamp(16px, 4vw, 24px);
  }

  .faq h2 {
    text-align: center;
    margin-bottom: clamp(var(--space-xl), 6vw, var(--space-2xl));
    font-size: clamp(var(--fs-title), 4vw, var(--fs-headline));
  }

  .faq-list {
    max-width: 800px;
    margin: 0 auto;
  }

  .faq-item {
    border-bottom: 1px solid var(--line);
    padding: 0;
    background: var(--surface);
    transition: background var(--dur-routine) ease;
  }

  .faq-item:first-child {
    border-top: 1px solid var(--line);
  }
  
  .faq-item:hover {
    background: var(--surface-secondary);
  }

  button.faq-question {
    width: 100%;
    min-height: 56px;
    padding: clamp(var(--space-md), 4vw, var(--space-lg)) clamp(var(--space-sm), 3vw, var(--space-md));
    background: none;
    border: none;
    border-radius: 0;
    appearance: none;
    -webkit-appearance: none;
    -moz-appearance: none;
    font-family: var(--font-family);
    font-size: clamp(var(--fs-body), 2.5vw, var(--fs-title));
    font-weight: 600;
    line-height: var(--lh-title);
    color: var(--ink);
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    user-select: none;
    text-align: left;
    transition: color var(--dur-routine) ease;
    margin: 0;
    box-shadow: none;
    outline: 0;
    gap: clamp(var(--space-sm), 3vw, var(--space-md));
  }

  button.faq-question::after {
    content: '+';
    font-size: clamp(var(--fs-title), 4vw, var(--fs-xl));
    font-weight: 300;
    color: var(--primary-light);
    flex-shrink: 0;
    transition: transform var(--dur-routine) var(--ease-out-expo);
    min-width: 28px;
    text-align: center;
  }

  .faq-item.open button.faq-question::after {
    transform: rotate(45deg);
  }

  button.faq-question:hover {
    color: var(--primary-light);
  }

  button.faq-question:focus-visible {
    outline: 2px solid var(--primary-light) !important;
    outline-offset: 4px;
    border-radius: var(--radius-xs);
  }

  .faq-question-text {
    flex: 1;
    word-wrap: break-word;
    overflow-wrap: break-word;
  }

  .faq-panel {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows var(--dur-overlay) var(--ease-out-expo);
  }

  .faq-item.open .faq-panel {
    grid-template-rows: 1fr;
  }

  .faq-panel p {
    overflow: hidden;
    min-height: 0;
    padding: clamp(var(--space-sm), 3vw, var(--space-md)) clamp(var(--space-sm), 3vw, var(--space-md)) clamp(var(--space-md), 4vw, var(--space-lg)) clamp(var(--space-sm), 3vw, var(--space-md));
    color: var(--ink-secondary);
    font-size: clamp(0.9375rem, 2.5vw, var(--fs-body));
    line-height: 1.7;
    opacity: 0;
    transform: translateY(-4px);
    transition: opacity var(--dur-routine) ease, transform var(--dur-routine) var(--ease-out-expo);
  }

  .faq-item.open .faq-panel p {
    opacity: 1;
    transform: translateY(0);
  }

  .faq-panel strong {
    color: var(--primary-light);
    font-weight: 600;
  }

  .faq-panel a {
    color: var(--primary-light);
    text-decoration: underline;
    transition: color 200ms ease;
  }

  .faq-panel a:hover {
    color: var(--primary-pale);
  }

  @media (min-width: 48rem) {
    button.faq-question {
      min-height: 64px;
    }
  }
</style>
