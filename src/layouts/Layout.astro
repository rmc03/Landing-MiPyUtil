---
export interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    
    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400..800&display=swap"
      rel="stylesheet"
    />
    
    <!-- Theme initialization script (prevent FOUC) -->
    <script is:inline>
      const theme = localStorage.getItem('theme') || 
                   (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      document.documentElement.setAttribute('data-theme', theme);
    </script>
  </head>
  <body>
    <!-- Skip link for keyboard navigation -->
    <a href="#main-content" class="skip-link">
      Saltar al contenido principal
    </a>
    
    <nav class="nav">
      <div class="nav-container">
        <a href="/" class="logo">MiPyUtil</a>
        
        <button class="nav-toggle" aria-label="Abrir menú de navegación" aria-expanded="false">
          <svg class="hamburger" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
        </button>

        <div class="nav-menu">
          <a href="#hero">Resumen</a>
          <a href="#inventario">Inventario</a>
          <a href="#ventas">Ventas</a>
          <a href="#cuadre">Cuadre</a>
          <a href="#precios">Precios</a>
          <a href="#descarga" class="nav-cta">
            <svg class="nav-cta-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="7 10 12 15 17 10"></polyline>
              <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            Descargar APK
          </a>
        </div>
        
        <button class="theme-toggle" aria-label="Cambiar tema claro/oscuro">
          <svg class="sun-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="5"></circle>
            <line x1="12" y1="1" x2="12" y2="3"></line>
            <line x1="12" y1="21" x2="12" y2="23"></line>
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
            <line x1="1" y1="12" x2="3" y2="12"></line>
            <line x1="21" y1="12" x2="23" y2="12"></line>
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
          </svg>
          <svg class="moon-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
          </svg>
        </button>
      </div>
    </nav>

    <main id="main-content">
      <slot />
    </main>

    <footer class="footer">
      <div class="footer-container">
        <div class="footer-brand">
          <h3 class="footer-logo">MiPyUtil</h3>
          <p class="footer-tagline">Tu mipyme, organizada.</p>
          <p class="footer-desc">Inventario, ventas y turnos. Todo sin internet.</p>
        </div>

        <div class="footer-links">
          <a href="#">WhatsApp</a>
          <a href="#">Telegram</a>
          <a href="#">Canal de Telegram</a>
        </div>

        <p class="footer-note">
          Aplicación en desarrollo activo. Funcionalidades mostradas según el estado actual del producto.
        </p>
      </div>
    </footer>

    <style>
      /* === SKIP LINK === */
      .skip-link {
        position: absolute;
        top: -40px;
        left: 0;
        background: var(--primary);
        color: white;
        padding: 8px 16px;
        text-decoration: none;
        border-radius: 0 0 var(--radius-xs) 0;
        z-index: 1000;
        transition: top 200ms ease;
        font-weight: 600;
      }
      
      .skip-link:focus {
        top: 0;
      }
      
      /* === NAV === */
      .nav {
        position: sticky;
        top: 0;
        z-index: 100;
        background: var(--surface);
        backdrop-filter: blur(12px);
        border-bottom: 1px solid var(--line);
      }

      .nav-container {
        max-width: 1120px;
        margin: 0 auto;
        padding: clamp(12px, 3vw, 16px) clamp(16px, 4vw, 24px);
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: clamp(12px, 3vw, 24px);
      }

      .logo {
        font-size: var(--fs-title);
        font-weight: 800;
        color: var(--ink);
        text-decoration: none;
        transition: color 200ms ease;
      }
      
      .logo:hover {
        color: var(--primary);
      }

      .nav-toggle {
        display: block;
        background: none;
        border: none;
        cursor: pointer;
        min-width: 44px;
        min-height: 44px;
        padding: 10px;
        color: var(--ink);
        transition: color 200ms ease;
        order: 2;
      }
      
      .nav-toggle:hover {
        color: var(--primary);
      }

      .hamburger {
        width: 24px;
        height: 24px;
      }

      .nav-menu {
        display: flex;
        flex-direction: column;
        gap: 16px;
        position: fixed;
        top: 65px;
        left: 0;
        right: 0;
        background: var(--surface);
        border-top: 1px solid var(--line);
        padding: 24px;
        max-height: calc(100vh - 65px);
        overflow-y: auto;
        transform: translateY(-100%);
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
        transition: transform var(--dur-routine) var(--ease-out-expo),
                    opacity var(--dur-routine) ease,
                    visibility var(--dur-routine);
        z-index: 99;
      }

      .nav-menu.open {
        transform: translateY(0);
        opacity: 1;
        visibility: visible;
        pointer-events: auto;
      }

      .nav-menu a {
        font-size: clamp(var(--fs-small), 2.5vw, var(--fs-body));
        font-weight: 500;
        color: var(--ink);
        text-decoration: none;
        transition: color 200ms ease;
      }

      .nav-menu a:hover {
        color: var(--primary);
      }
      
      .theme-toggle {
        background: var(--surface-secondary);
        border: 1px solid var(--line);
        border-radius: var(--radius-md);
        min-width: 44px;
        min-height: 44px;
        padding: 12px;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 200ms ease;
        color: var(--ink);
        flex-shrink: 0;
        order: 3;
      }
      
      .theme-toggle:hover {
        background: var(--hover-overlay);
        border-color: var(--primary);
        color: var(--primary);
      }
      
      .theme-toggle:focus-visible {
        outline: 2px solid var(--primary);
        outline-offset: 2px;
      }
      
      .theme-toggle svg {
        width: 20px;
        height: 20px;
      }
      
      /* Ocultar en móvil - se usa prefers-color-scheme automático */
      @media (max-width: 767px) {
        .theme-toggle {
          display: none;
        }
      }
      
      [data-theme="light"] .moon-icon,
      [data-theme="dark"] .sun-icon {
        display: none;
      }
      
      [data-theme="light"] .sun-icon,
      [data-theme="dark"] .moon-icon {
        display: block;
      }

      .nav-cta {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        background: var(--primary);
        color: white !important;
        padding: clamp(8px, 2vw, 10px) clamp(16px, 4vw, 20px);
        border-radius: var(--radius-pill);
        font-weight: 600;
        transition: all 200ms ease;
        font-size: clamp(var(--fs-small), 2.5vw, var(--fs-body));
        text-align: center;
      }

      .nav-cta:hover {
        background: var(--primary-deep);
      }

      .nav-cta-icon {
        width: 18px;
        height: 18px;
        flex-shrink: 0;
        transition: transform var(--dur-routine) var(--ease-out-expo);
      }

      @media (prefers-reduced-motion: no-preference) {
        .nav-cta:hover .nav-cta-icon,
        .nav-cta:focus-visible .nav-cta-icon {
          transform: translateY(2px);
        }
      }

      @media (min-width: 768px) {
        .nav-toggle {
          display: none;
        }

        .nav-menu {
          display: flex;
          position: static;
          flex-direction: row;
          align-items: center;
          gap: clamp(20px, 4vw, 32px);
          background: transparent;
          border: none;
          padding: 0;
          transform: none;
          opacity: 1;
          visibility: visible;
          pointer-events: auto;
          max-height: none;
          overflow-y: visible;
        }
      }

      /* === FOOTER === */
      .footer {
        background: var(--surface-elevated);
        color: var(--ink);
        padding: 64px 0 32px;
        border-top: 1px solid var(--line);
      }

      .footer-container {
        max-width: 1120px;
        margin: 0 auto;
        padding: 0 24px;
        text-align: center;
      }

      .footer-logo {
        font-size: var(--fs-xl);
        font-weight: 800;
        color: var(--ink);
        margin-bottom: 8px;
      }

      .footer-tagline {
        font-size: var(--fs-title);
        font-weight: 600;
        color: var(--ink);
        margin-bottom: 4px;
        max-width: none; /* el p global (70ch) anclaba la caja a la izquierda y descuadraba el centro */
      }

      .footer-desc {
        font-size: var(--fs-small);
        color: var(--ink-secondary);
        margin-bottom: 32px;
        max-width: none; /* ídem */
      }

      .footer-links {
        display: flex;
        justify-content: center;
        gap: 24px;
        margin-bottom: 32px;
        flex-wrap: wrap;
      }

      .footer-links a {
        color: var(--primary);
        text-decoration: none;
        font-weight: 500;
        transition: color 200ms ease;
      }

      .footer-links a:hover {
        color: var(--primary-light);
      }

      .footer-note {
        font-size: var(--fs-small);
        color: var(--muted);
        max-width: 60ch;
        margin: 0 auto;
      }
    </style>

    <script>
      // Nav toggle para mobile
      const navToggle = document.querySelector('.nav-toggle') as HTMLButtonElement;
      const navMenu = document.querySelector('.nav-menu') as HTMLDivElement;

      if (navToggle && navMenu) {
        navToggle.addEventListener('click', () => {
          const isOpen = navMenu.classList.contains('open');
          navMenu.classList.toggle('open');
          navToggle.setAttribute('aria-expanded', (!isOpen).toString());
          
          // Lock/unlock scroll
          if (!isOpen) {
            document.body.style.overflow = 'hidden';
          } else {
            document.body.style.overflow = '';
          }
        });

        document.querySelectorAll('.nav-menu a').forEach((link) => {
          link.addEventListener('click', () => {
            navMenu.classList.remove('open');
            navToggle.setAttribute('aria-expanded', 'false');
            document.body.style.overflow = '';
          });
        });
        
        // Cerrar con Escape
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && navMenu.classList.contains('open')) {
            navMenu.classList.remove('open');
            navToggle.setAttribute('aria-expanded', 'false');
            document.body.style.overflow = '';
            navToggle.focus();
          }
        });
      }
      
      // Theme toggle (solo desktop)
      const themeToggle = document.querySelector('.theme-toggle') as HTMLButtonElement;

      if (themeToggle) {
        themeToggle.addEventListener('click', () => {
          const applyTheme = () => {
            const currentTheme = document.documentElement.getAttribute('data-theme');
            const newTheme = currentTheme === 'dark' ? 'light' : 'dark';

            document.documentElement.setAttribute('data-theme', newTheme);
            localStorage.setItem('theme', newTheme);
          };

          const docWithTransition = document as Document & { startViewTransition?: (callback: () => void) => void };
          const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

          if (docWithTransition.startViewTransition && !reduceMotion) {
            docWithTransition.startViewTransition(applyTheme);
          } else {
            applyTheme();
          }
        });
      }
    </script>
  </body>
</html>
