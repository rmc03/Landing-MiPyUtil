---
/**
 * PhoneMockup: marco de teléfono con una pantalla de la app.
 *
 * La pantalla es HTML dibujado (AppScreen) con datos de ejemplo. Si existe una
 * captura real en public/screens/ con el nombre de la pantalla (ver
 * src/lib/screens.ts), se usa esa en su lugar y no hay que tocar nada más.
 *
 * `peek` recorta el teléfono a su mitad superior con un fundido: sirve para
 * asomarlo en móvil sin gastar un alto de pantalla completo.
 * El slot permite meter otro contenido en la pantalla (ver ComoFunciona).
 */
import AppScreen from './ui/AppScreen.astro';
import { realScreenshot } from '../lib/screens';
import type { Screen } from '../lib/screens';

export interface Props {
  screen?: Screen;
  alt: string;
  time?: string;
  /** Mi turno: `inicio` = turno recién abierto (no hay captura real de ese estado). */
  state?: 'activo' | 'inicio';
  compact?: boolean;
  peek?: boolean;
  interactive?: boolean;
}

const { screen, alt, time, state = 'activo', compact = false, peek = false, interactive = false } = Astro.props;

const hasSlot = Astro.slots.has('default');
const shot = !hasSlot && screen && state === 'activo' ? realScreenshot(screen) : undefined;
const decorative = !(interactive && !shot);
---

<div class:list={['phone-mockup', { compact, peek }]}>
  <div class="phone-frame">
    <div class="phone-notch"></div>
    <div class="phone-screen" role={decorative ? 'img' : undefined} aria-label={decorative ? alt : undefined}>
      {hasSlot ? (
        <slot />
      ) : shot ? (
        <img class="phone-shot" src={`/screens/${shot}`} alt="" width="1080" height="2340" loading="lazy" decoding="async" />
      ) : (
        screen && <AppScreen screen={screen} time={time} state={state} interactive={interactive} />
      )}
    </div>
  </div>
</div>

<style>
  /* Marco de teléfono: un objeto físico, no una superficie de UI, así que su
     radio es propio y proporcional al ancho (DESIGN.md, Phone Mockup). El
     bisel no repinta su color con el tema: un teléfono no se "ilumina" porque
     el tablón cambió de tema. Sin hover ni flotado: no es un control. */
  .phone-mockup {
    --phone-w: min(72vw, 270px);
    width: min(var(--phone-w), 100%);
    margin-inline: auto;
  }

  .phone-mockup.compact {
    --phone-w: min(60vw, 220px);
  }

  .phone-frame {
    position: relative;
    width: 100%;
    aspect-ratio: 9 / 19.5;
    padding: 3.4%;
    border-radius: 13% / 6%;
    background: var(--bezel);
    box-shadow: var(--shadow-soft);
  }

  /* `top` en % se mide contra la altura del marco; el relleno (3.4 %) contra su
     ancho. 3.4 % del ancho = 1.57 % de la altura (9 / 19.5), que deja la
     muesca pegada al borde superior de la pantalla. */
  .phone-notch {
    position: absolute;
    top: 1.57%;
    left: 50%;
    z-index: 2;
    width: 30%;
    height: 2.1%;
    min-height: 6px;
    transform: translateX(-50%);
    border-radius: 0 0 999px 999px;
    background: var(--bezel);
  }

  .phone-screen {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    border-radius: 10.5% / 4.8%;
    background: var(--board);
    container-type: inline-size;
  }

  .phone-shot {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Asomado: mitad superior del teléfono, apagada hacia abajo. */
  .phone-mockup.peek {
    aspect-ratio: 9 / 10.4;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to bottom, #000 58%, transparent);
    mask-image: linear-gradient(to bottom, #000 58%, transparent);
  }

  @media (min-width: 40rem) {
    .phone-mockup {
      --phone-w: 270px;
    }

    .phone-mockup.compact {
      --phone-w: 230px;
    }
  }

  @media (min-width: 64rem) {
    .phone-mockup {
      --phone-w: 300px;
    }

    .phone-mockup.compact {
      --phone-w: 250px;
    }
  }
</style>
