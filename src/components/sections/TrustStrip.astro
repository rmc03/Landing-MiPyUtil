---
const items = [
  { text: '14 días de prueba gratis.' },
  { text: 'Cuadre de caja diario.' },
  { text: 'Dueño y equipo, un sistema.' },
  { text: 'Sin Play Store, directa.' }
];
---

<div class="trust-strip">
  <span class="screw screw--tl" aria-hidden="true"></span>
  <span class="screw screw--tr" aria-hidden="true"></span>
  <span class="screw screw--bl" aria-hidden="true"></span>
  <span class="screw screw--br" aria-hidden="true"></span>
  <div class="container">
    <ul>
      {items.map((item) => (
        <li>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
          <span>{item.text}</span>
        </li>
      ))}
    </ul>
  </div>
</div>

<style>
  /* Riel atornillado, no una franja del mismo fondo del hero: placa propia
     a todo el ancho. Los remaches van en las esquinas de la placa —la placa
     llega al borde de la pantalla, así que sus extremos son esos bordes—, no
     en los del contenedor de texto: ahí quedaban cortados por la mitad en
     móvil y flotando en medio de la franja en pantallas anchas. */
  .trust-strip {
    position: relative;
    background: var(--plate);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    /* space-lg, no space-md: con los remaches a 10px de cada esquina, el
       relleno de 16px los dejaba rozando el primer y el último check. */
    padding: var(--space-lg) 0;
  }

  .trust-strip .screw {
    position: absolute;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--screw);
  }

  .trust-strip .screw--tl { top: 10px; left: 10px; }
  .trust-strip .screw--tr { top: 10px; right: 10px; }
  .trust-strip .screw--bl { bottom: 10px; left: 10px; }
  .trust-strip .screw--br { bottom: 10px; right: 10px; }

  .trust-strip ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-sm) var(--space-lg);
  }

  .trust-strip li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-sm);
    font-size: var(--fs-small);
    font-weight: 600;
    color: var(--ink-muted);
    line-height: 1.35;
  }

  .trust-strip li svg {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    color: var(--accent);
    margin-top: 2px;
  }

  @media (min-width: 40rem) {
    .trust-strip ul {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
