---
/**
 * FloatingCards: notificaciones de actividad viva alrededor del teléfono del hero.
 * Cada card es una mini-historia del producto: una venta, un cuadre, una alerta
 * de inventario, la promesa offline y una métrica del día. Decorativo (aria-hidden):
 * la información ya vive en el copy y en las placas reales de la página.
 *
 * Solo en tablet/desktop (48rem+): sus offsets en porcentaje negativo desbordan
 * en móvil, donde el hero se queda solo con el texto (ver Hero.astro).
 *
 * MOTION: entrance con stagger + float continuo con duraciones distintas por card
 * (sensación orgánica), count-up en la métrica. Todo respeta prefers-reduced-motion
 * y se pausa fuera del viewport (IntersectionObserver).
 */

const cards = [
  {
    id: 'ventas',
    position: 'tr',
    tone: 'accent',
    icon: 'trend',
    title: 'Ventas hoy',
    metric: true
  },
  {
    id: 'cuadre',
    position: 'tl',
    tone: 'accent',
    icon: 'check-circle',
    title: 'Cuadre aprobado'
  },
  {
    id: 'offline',
    position: 'mr',
    tone: 'accent',
    icon: 'wifi-off',
    title: 'Sin conexión',
    subtitle: 'todo guardado'
  },
  {
    id: 'inventario',
    position: 'bl',
    tone: 'accent',
    icon: 'alert',
    title: 'Inventario bajo:',
    subtitle: 'Cascos'
  },
  {
    id: 'venta',
    position: 'br',
    tone: 'success',
    icon: 'check',
    title: 'Venta registrada',
    subtitle: '$18'
  }
];
---

<div class="floating-cards" aria-hidden="true">
  {cards.map((card) => (
    <div class={`card card-${card.position} tone-${card.tone}`}>
      <div class="card-bob">
        <span class="icon-chip">
          {card.icon === 'trend' && (
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="22 7 13.5 15.5 8.5 10.5 2 17"></polyline>
              <polyline points="16 7 22 7 22 13"></polyline>
            </svg>
          )}
          {card.icon === 'check-circle' && (
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
              <polyline points="22 4 12 14.01 9 11.01"></polyline>
            </svg>
          )}
          {card.icon === 'wifi-off' && (
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 13a10 10 0 0 1 14 0"></path>
              <path d="M8.5 16.5a5 5 0 0 1 7 0"></path>
              <path d="M2 8.82a15 15 0 0 1 20 0"></path>
              <line x1="2" y1="2" x2="22" y2="22"></line>
            </svg>
          )}
          {card.icon === 'alert' && (
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"></path>
              <line x1="12" y1="9" x2="12" y2="13"></line>
              <line x1="12" y1="17" x2="12.01" y2="17"></line>
            </svg>
          )}
          {card.icon === 'check' && (
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
          )}
        </span>
        <span class="card-text">
          <span class="card-title">{card.title}</span>
          {card.metric && (
            <span class="card-value metric-count" data-target="47">0</span>
          )}
          {!card.metric && card.subtitle && (
            <span class="card-value">{card.subtitle}</span>
          )}
        </span>
      </div>
    </div>
  ))}
</div>

<script>
  const cardsEl = document.querySelector<HTMLElement>('.floating-cards');
  const counter = cardsEl ? cardsEl.querySelector<HTMLElement>('.metric-count') : null;
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (counter && cardsEl) {
    const target = parseInt(counter.dataset.target || '0', 10) || 0;

    if (reducedMotion || !('IntersectionObserver' in window)) {
      counter.textContent = target.toString();
    } else {
      let started = false;

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            cardsEl.classList.toggle('ambient-paused', !entry.isIntersecting);

            if (entry.isIntersecting && !started) {
              started = true;
              const duration = 1200;
              const start = performance.now();

              const tick = (now: number) => {
                const progress = Math.min((now - start) / duration, 1);
                const eased = 1 - Math.pow(1 - progress, 3);
                counter.textContent = Math.round(target * eased).toString();
                if (progress < 1) {
                  requestAnimationFrame(tick);
                }
              };

              requestAnimationFrame(tick);
            }
          });
        },
        { threshold: 0.1 }
      );

      observer.observe(cardsEl);
    }
  }
</script>

<style>
  .floating-cards {
    display: none;
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 2;
  }

  @media (min-width: 48rem) {
    .floating-cards {
      display: block;
    }
  }

  .card {
    position: absolute;
    background: var(--plate);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    padding: 10px 14px;
    /* impeccable-disable-line flat-surface -- excepción intencional: las cards flotantes
       necesitan elevación para leerse como "flotando"; la regla flat-by-default rige el resto */
    box-shadow: var(--shadow-soft);
  }

  .card-bob {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .icon-chip {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: var(--radius-sm);
    flex-shrink: 0;
  }

  .icon-chip svg {
    width: 17px;
    height: 17px;
  }

  .card-text {
    display: flex;
    flex-direction: column;
    line-height: 1.25;
  }

  .card-title {
    font-size: var(--fs-small);
    font-weight: 600;
    color: var(--ink-muted);
    white-space: nowrap;
  }

  .card-value {
    font-size: var(--fs-title);
    font-weight: 700;
    color: var(--ink);
    white-space: nowrap;
  }

  /* === Posiciones alrededor del teléfono === */
  .card-tl {
    top: 22%;
    inset-inline-start: -2%;
  }

  .card-tr {
    top: 6%;
    inset-inline-end: -2%;
  }

  .card-mr {
    top: 40%;
    inset-inline-end: -2%;
  }

  .card-bl {
    bottom: 18%;
    inset-inline-start: -3%;
  }

  .card-br {
    bottom: 2%;
    inset-inline-end: -3%;
  }

  /* === Tonos (chip de icono): un solo acento, éxito reservado a confirmación === */
  .tone-accent .icon-chip {
    background: color-mix(in srgb, var(--accent) 14%, transparent);
    color: var(--accent);
  }

  .tone-success .icon-chip {
    background: color-mix(in srgb, var(--success) 14%, transparent);
    color: var(--success);
  }

  @media (min-width: 64rem) {
    .card-tl {
      inset-inline-start: -4%;
    }

    .card-tr {
      inset-inline-end: -4%;
    }

    .card-mr {
      inset-inline-end: -4%;
    }

    .card-bl {
      inset-inline-start: -5%;
    }

    .card-br {
      inset-inline-end: -5%;
    }
  }

  /* === MOTION === */
  @media (prefers-reduced-motion: no-preference) {
    .card {
      animation: card-in 600ms var(--ease-out-expo) both;
    }

    .card-tl { animation-delay: 250ms; }
    .card-tr { animation-delay: 350ms; }
    .card-mr { animation-delay: 450ms; }
    .card-bl { animation-delay: 550ms; }
    .card-br { animation-delay: 650ms; }

    .card-bob {
      animation: card-float 5s ease-in-out infinite;
    }

    .card-tl .card-bob { animation-duration: 4.6s; animation-delay: 0.6s; }
    .card-tr .card-bob { animation-duration: 5.2s; animation-delay: 1s; }
    .card-mr .card-bob { animation-duration: 5.5s; animation-delay: 0.2s; }
    .card-bl .card-bob { animation-duration: 4.9s; animation-delay: 0.4s; }
    .card-br .card-bob { animation-duration: 5.8s; animation-delay: 0.8s; }

    .floating-cards.ambient-paused .card-bob,
    .floating-cards.ambient-paused .card {
      animation-play-state: paused;
    }
  }

  @keyframes card-in {
    from {
      opacity: 0;
      transform: translateY(14px) scale(0.96);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @keyframes card-float {
    0%, 100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-5px);
    }
  }
</style>
