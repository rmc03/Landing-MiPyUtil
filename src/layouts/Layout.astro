---
export interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

import Analytics from '@vercel/analytics/astro';
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content={description} />
    <title>{title}</title>

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/icon.png" />

    <!-- Google Fonts: Anton (display, un solo uso por página) + Archivo (todo lo demás) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Anton&family=Archivo:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <!-- Tema: claro por defecto, oscuro solo si el visitante ya lo eligió antes.
         Se resuelve antes del primer paint para no parpadear. -->
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem('mipyutil-theme');
          if (saved === 'dark') {
            document.documentElement.setAttribute('data-theme', 'dark');
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <!-- Skip link for keyboard navigation -->
    <a href="#main-content" class="skip-link">
      Saltar al contenido principal
    </a>

    <nav class="nav">
      <div class="nav-container">
        <a href="/" class="logo">MiPyUtil</a>

        <div class="nav-actions">
          <button
            type="button"
            class="theme-toggle"
            id="theme-toggle"
            aria-pressed="false"
            aria-label="Cambiar a modo apagón"
          >
            <svg class="theme-icon theme-icon--sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="5"></circle>
              <path d="M12 1v2M12 21v2M4.2 4.2l1.4 1.4M18.4 18.4l1.4 1.4M1 12h2M21 12h2M4.2 19.8l1.4-1.4M18.4 5.6l1.4-1.4"></path>
            </svg>
            <svg class="theme-icon theme-icon--moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path>
            </svg>
            <span class="theme-label">Modo día</span>
          </button>

          <button class="nav-toggle" aria-label="Abrir menú de navegación" aria-expanded="false">
            <svg class="hamburger" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="3" y1="12" x2="21" y2="12"></line>
              <line x1="3" y1="6" x2="21" y2="6"></line>
              <line x1="3" y1="18" x2="21" y2="18"></line>
            </svg>
          </button>
        </div>

        <div class="nav-menu">
          <a href="#hero">Resumen</a>
          <a href="#inventario">Inventario</a>
          <a href="#ventas">Ventas</a>
          <a href="#ganancias">Ganancias</a>
          <a href="#precios">Precios</a>
          <a href="#descarga" class="nav-cta">
            Descargar
          </a>
        </div>
      </div>
    </nav>

    <main id="main-content">
      <slot />
    </main>

    <footer class="footer">
      <div class="footer-container">
        <div class="footer-brand">
          <p class="footer-logo">MiPyUtil</p>
          <p class="footer-tagline">Tu MiPyME, organizada.</p>
          <p class="footer-desc">Inventario, ventas y turnos. Todo sin internet.</p>
        </div>

        <div class="footer-links">
          <a href="https://wa.me/5353770707?text=Hola,%20me%20gustar%C3%ADa%20hacer%20una%20consulta%20sobre%20MiPyUtil" target="_blank" rel="noopener noreferrer">WhatsApp</a>
          <a href="https://t.me/MipyUtil" target="_blank" rel="noopener noreferrer">Canal de Telegram</a>
        </div>

        <p class="footer-note">
          Aplicación en desarrollo activo. Funcionalidades mostradas según el estado actual del producto.
        </p>
      </div>
    </footer>

    <style>
      /* === SKIP LINK === */
      .skip-link {
        position: absolute;
        top: -40px;
        left: 0;
        background: var(--accent);
        color: var(--accent-on);
        padding: 8px 16px;
        text-decoration: none;
        border-radius: 0 0 var(--radius-sm) 0;
        z-index: 1000;
        transition: top 200ms ease;
        font-weight: 700;
      }

      .skip-link:focus {
        top: 0;
      }

      /* === NAV ===
         Fondo sólido del tablón, sin blur de vidrio (ver DESIGN.md). */
      .nav {
        position: sticky;
        top: 0;
        z-index: 1000;
        background: var(--board);
        border-bottom: 1px solid var(--line);
      }

      .nav-container {
        max-width: 1120px;
        margin: 0 auto;
        padding:
          calc(clamp(12px, 3vw, 16px) + env(safe-area-inset-top, 0px))
          clamp(16px, 4vw, 24px)
          clamp(12px, 3vw, 16px);
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: clamp(12px, 3vw, 24px);
      }

      .logo {
        font-family: var(--font-body);
        font-size: var(--fs-title);
        font-weight: 800;
        color: var(--ink);
        text-decoration: none;
        transition: color var(--dur-routine) ease;
      }

      .logo:hover {
        color: var(--accent);
      }

      .nav-actions {
        display: flex;
        align-items: center;
        gap: var(--space-sm);
        order: 2;
      }

      /* === THEME TOGGLE === */
      .theme-toggle {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: transparent;
        border: 1.5px solid var(--line-strong);
        border-radius: var(--radius-md);
        padding: 8px 10px;
        min-height: 44px;
        min-width: 44px;
        color: var(--ink);
        font-family: var(--font-body);
        font-size: var(--fs-label);
        font-weight: 700;
        cursor: pointer;
        transition: border-color var(--dur-routine) ease, color var(--dur-routine) ease;
      }

      .theme-toggle:hover {
        border-color: var(--accent);
        color: var(--accent);
      }

      .theme-toggle:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 2px;
      }

      .theme-icon {
        width: 18px;
        height: 18px;
        flex-shrink: 0;
      }

      .theme-icon--moon {
        display: none;
      }

      :global([data-theme='dark']) .theme-icon--sun {
        display: none;
      }

      :global([data-theme='dark']) .theme-icon--moon {
        display: block;
      }

      .theme-label {
        white-space: nowrap;
      }

      @media (max-width: 26.5rem) {
        .theme-label {
          position: absolute;
          width: 1px;
          height: 1px;
          padding: 0;
          margin: -1px;
          overflow: hidden;
          clip: rect(0 0 0 0);
          white-space: nowrap;
          border: 0;
        }
      }

      .nav-toggle {
        display: block;
        background: none;
        border: none;
        cursor: pointer;
        min-width: 44px;
        min-height: 44px;
        padding: 10px;
        color: var(--ink);
        transition: color var(--dur-routine) ease;
      }

      .nav-toggle:hover {
        color: var(--accent);
      }

      .hamburger {
        width: 24px;
        height: 24px;
      }

      .nav-menu {
        display: flex;
        flex-direction: column;
        gap: 4px;
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        background: var(--board);
        border-bottom: 1px solid var(--line);
        box-shadow: var(--shadow-soft);
        padding: 24px;
        max-height: calc(100vh - 24px);
        max-height: calc(100dvh - 24px);
        overflow-y: auto;
        transform: translateY(-100%);
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
        transition: transform var(--dur-routine) var(--ease-out-expo),
                    opacity var(--dur-routine) ease,
                    visibility var(--dur-routine);
        z-index: 999;
        order: 3;
      }

      .nav-menu.open {
        transform: translateY(0);
        opacity: 1;
        visibility: visible;
        pointer-events: auto;
      }

      .nav-menu a {
        font-size: clamp(var(--fs-small), 2.5vw, var(--fs-body));
        font-weight: 600;
        color: var(--ink);
        text-decoration: none;
        padding: 10px 8px;
        border-radius: var(--radius-sm);
      }

      .nav-menu a:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 2px;
      }

      .nav-menu a:hover {
        color: var(--accent);
      }

      .nav-cta {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        background: var(--accent);
        color: var(--accent-on) !important;
        padding: 12px 20px;
        border-radius: var(--radius-md);
        font-weight: 800;
        margin-top: 4px;
      }

      .nav-cta:hover {
        background: var(--accent-deep);
      }

      @media (min-width: 48rem) {
        .nav-toggle {
          display: none;
        }

        .nav-menu {
          display: flex;
          position: static;
          flex-direction: row;
          align-items: center;
          gap: clamp(18px, 3vw, 28px);
          background: transparent;
          box-shadow: none;
          border: none;
          padding: 0;
          transform: none;
          opacity: 1;
          visibility: visible;
          pointer-events: auto;
          max-height: none;
          overflow-y: visible;
          order: unset;
        }

        .nav-menu a {
          padding: 6px 2px;
        }

        .nav-cta {
          padding: 10px 18px;
          margin-top: 0;
        }

        .nav-actions {
          order: unset;
        }
      }

      /* === FOOTER === */
      .footer {
        background: var(--board-panel);
        color: var(--ink);
        padding: 64px 0 calc(32px + env(safe-area-inset-bottom, 0px));
        border-top: 1px solid var(--line);
      }

      .footer-container {
        max-width: 1120px;
        margin: 0 auto;
        padding: 0 clamp(16px, 4vw, 24px);
        text-align: center;
      }

      .footer-logo {
        font-family: var(--font-body);
        font-size: var(--fs-title);
        font-weight: 800;
        color: var(--ink);
        margin-bottom: 8px;
      }

      .footer-tagline {
        font-size: var(--fs-title);
        font-weight: 700;
        color: var(--ink);
        margin-bottom: 4px;
        max-width: none;
      }

      .footer-desc {
        font-size: var(--fs-small);
        color: var(--ink-muted);
        margin-bottom: 32px;
        max-width: none;
      }

      .footer-links {
        display: flex;
        justify-content: center;
        gap: 24px;
        margin-bottom: 32px;
        flex-wrap: wrap;
      }

      .footer-links a {
        color: var(--ink);
        font-weight: 700;
        padding: 12px 10px;
        margin: -12px -10px;
        border-bottom: 2px solid transparent;
      }

      .footer-links a:hover {
        color: var(--accent);
        border-bottom-color: var(--accent);
      }

      .footer-note {
        font-size: var(--fs-small);
        color: var(--ink-muted);
        max-width: 60ch;
        margin: 0 auto;
      }
    </style>

    <script>
      // Nav toggle para mobile
      const navToggle = document.querySelector('.nav-toggle') as HTMLButtonElement;
      const navMenu = document.querySelector('.nav-menu') as HTMLDivElement;

      if (navToggle && navMenu) {
        navToggle.addEventListener('click', () => {
          const isOpen = navMenu.classList.contains('open');
          navMenu.classList.toggle('open');
          navToggle.setAttribute('aria-expanded', (!isOpen).toString());

          if (!isOpen) {
            document.body.style.overflow = 'hidden';
          } else {
            document.body.style.overflow = '';
          }
        });

        document.querySelectorAll<HTMLAnchorElement>('.nav-menu a').forEach((link) => {
          link.addEventListener('click', (e) => {
            const href = link.getAttribute('href');
            const isAnchor = href?.startsWith('#');

            navMenu.classList.remove('open');
            navToggle.setAttribute('aria-expanded', 'false');
            document.body.style.overflow = '';

            if (isAnchor) {
              const targetId = href && href.length > 1 ? href.slice(1) : null;
              const targetEl = targetId ? document.getElementById(targetId) : null;

              if (targetEl) {
                e.preventDefault();
                const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
                requestAnimationFrame(() => {
                  targetEl.scrollIntoView({ behavior: prefersReducedMotion ? 'auto' : 'smooth', block: 'start' });
                });
                history.pushState(null, '', href);
              }
            }
          });
        });

        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && navMenu.classList.contains('open')) {
            navMenu.classList.remove('open');
            navToggle.setAttribute('aria-expanded', 'false');
            document.body.style.overflow = '';
            navToggle.focus();
          }
        });
      }

      // Interruptor de tema: sol / apagón. Claro por defecto, se activa a mano,
      // persiste en localStorage. Ver DESIGN.md, componente Theme Toggle.
      const themeToggle = document.getElementById('theme-toggle') as HTMLButtonElement;

      if (themeToggle) {
        const applyLabel = () => {
          const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
          themeToggle.setAttribute('aria-pressed', String(isDark));
          themeToggle.setAttribute('aria-label', isDark ? 'Cambiar a modo día' : 'Cambiar a modo apagón');
          const label = themeToggle.querySelector('.theme-label');
          if (label) label.textContent = isDark ? 'Modo apagón' : 'Modo día';
        };

        applyLabel();

        themeToggle.addEventListener('click', () => {
          const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
          if (isDark) {
            document.documentElement.removeAttribute('data-theme');
            try { localStorage.setItem('mipyutil-theme', 'light'); } catch (e) {}
          } else {
            document.documentElement.setAttribute('data-theme', 'dark');
            try { localStorage.setItem('mipyutil-theme', 'dark'); } catch (e) {}
          }
          applyLabel();
        });
      }
    </script>
    <Analytics />
  </body>
</html>
