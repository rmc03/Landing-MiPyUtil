---
export interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content={description} />
    <title>{title}</title>
    
    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/icon.png" />
    
    <!-- Google Fonts: Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400..800&display=swap"
      rel="stylesheet"
    />
    
    <!-- Force dark theme -->
    <script is:inline>
      document.documentElement.setAttribute('data-theme', 'dark');
    </script>
  </head>
  <body>
    <!-- Skip link for keyboard navigation -->
    <a href="#main-content" class="skip-link">
      Saltar al contenido principal
    </a>
    
    <nav class="nav">
      <div class="nav-container">
        <a href="/" class="logo">
          <img src="/icon.png" alt="" class="logo-icon" />
          MiPyUtil
        </a>
        
        <button class="nav-toggle" aria-label="Abrir menú de navegación" aria-expanded="false">
          <svg class="hamburger" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
        </button>

        <div class="nav-menu">
          <a href="#hero">Resumen</a>
          <a href="#inventario">Inventario</a>
          <a href="#ventas">Ventas</a>
          <a href="#ganancias">Ganancias</a>
          <a href="#precios">Precios</a>
          <a href="https://github.com/rmc03/Landing-MiPyUtil/releases/latest/download/MiPyUtil.apk" class="nav-cta" target="_blank" rel="noopener">
            <svg class="nav-cta-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="7 10 12 15 17 10"></polyline>
              <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            Descargar APK
          </a>
        </div>
        

      </div>
    </nav>

    <main id="main-content">
      <slot />
    </main>

    <footer class="footer">
      <div class="footer-container">
        <div class="footer-brand">
          <h3 class="footer-logo">MiPyUtil</h3>
          <p class="footer-tagline">Tu MiPyME, organizada.</p>
          <p class="footer-desc">Inventario, ventas y turnos. Todo sin internet.</p>
        </div>

        <div class="footer-links">
          <a href="#">WhatsApp</a>
          <a href="https://t.me/MipyUtil">Canal de Telegram</a>
        </div>

        <p class="footer-note">
          Aplicación en desarrollo activo. Funcionalidades mostradas según el estado actual del producto.
        </p>
      </div>
    </footer>

    <style>
      /* === SKIP LINK === */
      .skip-link {
        position: absolute;
        top: -40px;
        left: 0;
        background: var(--primary);
        color: white;
        padding: 8px 16px;
        text-decoration: none;
        border-radius: 0 0 var(--radius-xs) 0;
        z-index: 1000;
        transition: top 200ms ease;
        font-weight: 600;
      }
      
      .skip-link:focus {
        top: 0;
      }
      
      /* === NAV === */
      .nav {
        position: sticky;
        top: 0;
        z-index: 1000;
        background: rgba(22, 22, 31, 0.92);
        -webkit-backdrop-filter: blur(12px);
        backdrop-filter: blur(12px);
      }

      .nav-container {
        max-width: 1120px;
        margin: 0 auto;
        padding:
          calc(clamp(12px, 3vw, 16px) + env(safe-area-inset-top, 0px))
          clamp(16px, 4vw, 24px)
          clamp(12px, 3vw, 16px);
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: clamp(12px, 3vw, 24px);
      }

      .logo {
        font-size: var(--fs-title);
        font-weight: 800;
        color: var(--ink);
        text-decoration: none;
        transition: color 200ms ease;
        display: flex;
        align-items: center;
        gap: 8px;
      }
      
      .logo-icon {
        width: 28px;
        height: 28px;
        object-fit: contain;
      }
      
      .logo:hover {
        color: var(--primary-light);
      }

      .nav-toggle {
        display: block;
        background: none;
        border: none;
        cursor: pointer;
        min-width: 44px;
        min-height: 44px;
        padding: 10px;
        color: var(--ink);
        transition: color 200ms ease;
        order: 2;
      }
      
      .nav-toggle:hover {
        color: var(--primary-light);
      }

      .hamburger {
        width: 24px;
        height: 24px;
      }

      .nav-menu {
        display: flex;
        flex-direction: column;
        gap: 4px;
        /* Anclado al nav real (top: 100%), no a 65px fijos: sobrevive al zoom
           y a la altura del safe-area sin desalinearse */
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        background: var(--surface);
        box-shadow: 0 12px 32px rgba(10, 10, 22, 0.5);
        padding: 24px;
        max-height: calc(100vh - 24px);
        max-height: calc(100dvh - 24px);
        overflow-y: auto;
        transform: translateY(-100%);
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
        transition: transform var(--dur-routine) var(--ease-out-expo),
                    opacity var(--dur-routine) ease,
                    visibility var(--dur-routine);
        z-index: 999;
        border: none;
        outline: none;
      }

      .nav-menu.open {
        transform: translateY(0);
        opacity: 1;
        visibility: visible;
        pointer-events: auto;
      }

      .nav-menu a {
        font-size: clamp(var(--fs-small), 2.5vw, var(--fs-body));
        font-weight: 500;
        color: var(--ink);
        text-decoration: none;
        transition: color 200ms ease;
        border: none;
        outline: none;
      }
      
      .nav-menu a:focus-visible {
        outline: 2px solid var(--primary-light);
        outline-offset: 4px;
        border-radius: 4px;
      }

      .nav-menu a:hover {
        color: var(--primary-light);
      }

      /* En móvil los enlaces del menú necesitan área táctil de 44px */
      @media (max-width: 47.999rem) {
        .nav-menu a {
          padding: 10px 8px;
        }

        .nav-menu .nav-cta {
          padding: 12px 20px;
        }
      }
      

      .nav-cta {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        background: var(--primary);
        color: white;
        padding: clamp(8px, 2vw, 10px) clamp(16px, 4vw, 20px);
        border-radius: var(--radius-pill);
        font-weight: 600;
        transition: all 200ms ease;
        font-size: clamp(var(--fs-small), 2.5vw, var(--fs-body));
        text-align: center;
        white-space: nowrap;
      }
      
      .nav-cta:focus-visible {
        outline: 2px solid var(--primary-light);
        outline-offset: 2px;
      }

      .nav-cta:hover {
        background: var(--primary-deep);
        color: white;
      }

      .nav-cta-icon {
        width: 18px;
        height: 18px;
        flex-shrink: 0;
        transition: transform var(--dur-routine) var(--ease-out-expo);
      }

      @media (prefers-reduced-motion: no-preference) {
        .nav-cta:hover .nav-cta-icon,
        .nav-cta:focus-visible .nav-cta-icon {
          transform: translateY(2px);
        }
      }

      @media (min-width: 48rem) {
        .nav-toggle {
          display: none;
        }

        .nav-menu {
          display: flex;
          position: static;
          flex-direction: row;
          align-items: center;
          gap: clamp(20px, 4vw, 32px);
          background: transparent;
          box-shadow: none;
          border: none;
          outline: none;
          padding: 0;
          transform: none;
          opacity: 1;
          visibility: visible;
          pointer-events: auto;
          max-height: none;
          overflow-y: visible;
        }
      }

      /* Tablets estrechas (48–60rem): comprimir el nav para que la fila completa
         entre sin desbordar antes de colapsar al menú hamburguesa */
      @media (min-width: 48rem) and (max-width: 59.999rem) {
        .nav-container {
          gap: 16px;
        }

        .nav-menu {
          gap: 16px;
        }
      }

      /* === FOOTER === */
      .footer {
        background: var(--surface-elevated);
        color: var(--ink);
        padding: 64px 0 calc(32px + env(safe-area-inset-bottom, 0px));
        border-top: 1px solid var(--line);
      }

      .footer-container {
        max-width: 1120px;
        margin: 0 auto;
        padding: 0 clamp(16px, 4vw, 24px);
        text-align: center;
      }

      .footer-logo {
        font-size: var(--fs-xl);
        font-weight: 800;
        color: var(--ink);
        margin-bottom: 8px;
      }

      .footer-tagline {
        font-size: var(--fs-title);
        font-weight: 600;
        color: var(--ink);
        margin-bottom: 4px;
        max-width: none; /* el p global (70ch) anclaba la caja a la izquierda y descuadraba el centro */
      }

      .footer-desc {
        font-size: var(--fs-small);
        color: var(--ink-secondary);
        margin-bottom: 32px;
        max-width: none; /* ídem */
      }

      .footer-links {
        display: flex;
        justify-content: center;
        gap: 24px;
        margin-bottom: 32px;
        flex-wrap: wrap;
      }

      .footer-links a {
        color: var(--primary-light);
        text-decoration: none;
        font-weight: 500;
        transition: color 200ms ease;
        /* Área táctil 44px sin cambiar el ritmo visual (margen negativo) */
        padding: 12px 10px;
        margin: -12px -10px;
      }

      .footer-links a:hover {
        color: var(--primary-pale);
      }

      .footer-note {
        font-size: var(--fs-small);
        color: var(--muted);
        max-width: 60ch;
        margin: 0 auto;
      }
    </style>

    <script>
      // Nav toggle para mobile
      const navToggle = document.querySelector('.nav-toggle') as HTMLButtonElement;
      const navMenu = document.querySelector('.nav-menu') as HTMLDivElement;

      if (navToggle && navMenu) {
        navToggle.addEventListener('click', () => {
          const isOpen = navMenu.classList.contains('open');
          navMenu.classList.toggle('open');
          navToggle.setAttribute('aria-expanded', (!isOpen).toString());
          
          // Lock/unlock scroll
          if (!isOpen) {
            document.body.style.overflow = 'hidden';
          } else {
            document.body.style.overflow = '';
          }
        });

        document.querySelectorAll<HTMLAnchorElement>('.nav-menu a').forEach((link) => {
          link.addEventListener('click', (e) => {
            const href = link.getAttribute('href');
            const isAnchor = href?.startsWith('#');

            // Cerrar el menú y liberar el scroll ANTES de saltar al ancla
            navMenu.classList.remove('open');
            navToggle.setAttribute('aria-expanded', 'false');
            document.body.style.overflow = '';

            if (isAnchor) {
              const targetId = href && href.length > 1 ? href.slice(1) : null;
              const targetEl = targetId ? document.getElementById(targetId) : null;

              if (targetEl) {
                e.preventDefault();
                const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
                requestAnimationFrame(() => {
                  targetEl.scrollIntoView({ behavior: prefersReducedMotion ? 'auto' : 'smooth', block: 'start' });
                });
                history.pushState(null, '', href);
              }
            }
          });
        });
        
        // Cerrar con Escape
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && navMenu.classList.contains('open')) {
            navMenu.classList.remove('open');
            navToggle.setAttribute('aria-expanded', 'false');
            document.body.style.overflow = '';
            navToggle.focus();
          }
        });
      }
      

    </script>
  </body>
</html>
