---
export interface Props {
  screenshot: string;
  alt: string;
}

const { screenshot, alt } = Astro.props;
const screenshotPath = `/screens/${screenshot}`;
---

<div class="phone-mockup">
  <div class="phone-frame">
    <div class="phone-notch"></div>
    <div class="phone-screen">
      <img
        src={screenshotPath}
        alt={alt}
        loading="lazy"
        onerror="this.src='/screens/placeholder.svg'; this.alt='Placeholder: ' + this.alt"
      />
    </div>
  </div>
</div>

<style>
  .phone-mockup {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
  }

  .phone-frame {
    position: relative;
    width: 100%;
    max-width: 320px;
    aspect-ratio: 9 / 19.5;
    background: var(--ink);
    border-radius: var(--radius-phone);
    padding: 12px;
    box-shadow: var(--shadow-subtle);
  }

  .dark-band .phone-frame {
    background: white;
  }

  .phone-notch {
    position: absolute;
    top: 12px;
    left: 50%;
    transform: translateX(-50%);
    width: 120px;
    height: 24px;
    background: var(--background);
    border-radius: 0 0 16px 16px;
    z-index: 2;
  }

  .dark-band .phone-notch {
    background: var(--surface);
  }

  .phone-screen {
    width: 100%;
    height: 100%;
    background: var(--surface);
    border-radius: calc(var(--radius-phone) - 8px);
    overflow: hidden;
    position: relative;
  }

  .phone-screen img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  @media (min-width: 768px) {
    .phone-frame {
      max-width: 280px;
    }
  }

  @media (min-width: 1024px) {
    .phone-frame {
      max-width: 320px;
    }
  }
</style>
