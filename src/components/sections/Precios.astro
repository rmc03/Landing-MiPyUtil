---
// src/components/sections/Precios.astro
// Precios como filas de un tablón: límites en filas etiqueta/valor, el toggle
// de facturación es un control de dos placas (nunca una píldora deslizante).
//
// Los planes mensuales cuestan en USD y se pueden pagar en CUP al cambio de
// elTOQUE. La tasa la sirve la función pública `tasa-publica` de Supabase
// (ver supabase/functions/tasa-publica). El HTML ya trae los precios en USD;
// el script de abajo añade los montos en CUP cuando llega la tasa. Si la tasa
// no llega o está vieja, esos montos desaparecen y se manda a WhatsApp.
import Button from '../ui/Button.astro';

const plans = [
  {
    name: 'Gratuito',
    monthlyPrice: null,
    monthlyIntro: null,
    annualPrice: null,
    recommended: false,
    free: true,
    limits: [
      { label: 'Productos', value: '30' },
      { label: 'Dependientes', value: '3' },
      { label: 'Administradores', value: '1' }
    ],
    features: []
  },
  {
    name: 'Básico',
    monthlyPrice: '2',
    monthlyIntro: '1',
    annualPrice: '15',
    recommended: false,
    free: false,
    limits: [
      { label: 'Productos', value: '75' },
      { label: 'Dependientes', value: '3' },
      { label: 'Administradores', value: '2' }
    ],
    features: []
  },
  {
    name: 'Negocio',
    monthlyPrice: '3',
    monthlyIntro: '2',
    annualPrice: '20',
    recommended: true,
    free: false,
    limits: [
      { label: 'Productos', value: '150' },
      { label: 'Dependientes', value: '5' },
      { label: 'Administradores', value: '3' }
    ],
    features: []
  },
  {
    name: 'Pro',
    monthlyPrice: '4',
    monthlyIntro: '3',
    annualPrice: '30',
    recommended: false,
    free: false,
    limits: [
      { label: 'Productos', value: '300' },
      { label: 'Dependientes', value: '8' },
      { label: 'Administradores', value: '4' }
    ],
    features: ['Atención prioritaria.']
  }
];

const WHATSAPP_NUMBER = '5353770707';

// Función pública de Supabase (solo lectura): devuelve el dólar de elTOQUE y su antigüedad.
const TASA_URL =
  import.meta.env.PUBLIC_TASA_URL ?? 'https://sqnrvtwrvgxszkxuuyjb.supabase.co/functions/v1/tasa-publica';
// Pasadas estas horas sin actualizarse, la landing oculta los montos en CUP.
const HORAS_TASA_VIEJA = 24;

const pasos = [
  { titulo: 'Elige tu plan', texto: 'Se abre WhatsApp con el plan ya escrito.' },
  { titulo: 'Te confirmamos el monto', texto: 'En CUP y con la tasa de hoy, antes de que transfieras.' },
  { titulo: 'Transfieres y te activamos', texto: 'Pagas por Transfermóvil o EnZona y subimos tu plan.' }
];

const mensajeMensual = (nombre: string, intro: string | null, precio: string | null) =>
  `Hola, me interesa el plan mensual ${nombre} de la app MiPyUtil. Vi $${intro} USD el primer mes y $${precio} USD al mes después.`;
---

<section
  id="precios"
  class="precios-section"
  data-billing="monthly"
  data-tasa-estado="cargando"
  data-tasa-url={TASA_URL}
  data-tasa-max-horas={HORAS_TASA_VIEJA}
  data-whatsapp={WHATSAPP_NUMBER}
>
  <noscript><style is:inline>.cup-hoy { display: none; } .tasa-cargando { display: none; }</style></noscript>
  <div class="container">
    <div class="section-header">
      <h2>Elige tu plan</h2>
      <p class="subtitle">Empieza gratis. Mejora cuando lo necesites. Despliegue inmediato, acceso total a inventario y soporte directo.</p>
    </div>

    <div class="billing-toggle" role="group" aria-label="Frecuencia de pago">
      <button type="button" class="billing-option" data-billing="monthly" aria-pressed="true">Mensual</button>
      <button type="button" class="billing-option" data-billing="annual" aria-pressed="false">
        Anual
        <span class="save-chip">Grandes descuentos</span>
      </button>
    </div>

    <div class="cambio-banner cambio-only">
      <div class="cambio-monedas" aria-hidden="true">
        <span>USD</span>
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 8h15l-4-4"/><path d="M20 16H5l4 4"/></svg>
        <span>CUP</span>
      </div>
      <div class="cambio-texto">
        <h3 class="cambio-titulo">Pagas en CUP, al cambio del día</h3>
        <p>Los planes cuestan en dólares y los puedes pagar en pesos cubanos al cambio de elTOQUE. Te confirmamos el monto por WhatsApp antes de que transfieras.</p>
        <p class="tasa-linea" aria-live="polite">
          <span class="tasa-cargando">Consultando la tasa de hoy…</span>
          <span class="tasa-lista">Hoy: 1 USD = <strong class="tasa-valor"></strong> CUP · elTOQUE · actualizada <time class="tasa-hora"></time></span>
          <span class="tasa-sin">No pudimos consultar la tasa ahora. Te la damos por WhatsApp.</span>
        </p>
      </div>
      <Button
        variant="secondary"
        href={`https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent('Hola, quisiera pagar un plan de la app MiPyUtil en CUP. ¿Me confirman la tasa de hoy?')}`}
        icon="whatsapp"
        target="_blank"
        class="cambio-cta"
      >
        Preguntar por WhatsApp
      </Button>
    </div>

    <div class="pricing-grid">
      {plans.map((plan) => (
        <div class:list={['pricing-card', { recommended: plan.recommended }]}>
          <div class="card-header">
            <h3 class="plan-name">{plan.name}</h3>
            {plan.recommended && <span class="badge">Recomendado</span>}
          </div>

          {plan.free ? (
            <div class="card-price card-price--free">
              <span class="free-prefix">Para siempre</span>
              <strong class="free-label">Gratis</strong>
              <span class="free-sublabel">Sin tarjeta ni transferencia</span>
            </div>
          ) : (
            <div class="card-price" data-billing="monthly">
              <div class="intro-offer">
                <span class="intro-prefix">1.<sup>er</sup> mes:</span>
                <strong class="intro-amount">${plan.monthlyIntro}</strong>
                <span class="intro-currency">USD</span>
              </div>
              <p class="cup-hoy cup-hoy--intro" data-usd={plan.monthlyIntro}>≈ <span class="cup-num"></span> CUP hoy</p>
              <div class="price-row">
                <span class="price-prefix" data-monthly-text="luego " data-annual-text="">luego </span>
                <span class="currency" data-monthly-currency="$" data-annual-currency="$" aria-hidden="true">$</span>
                <span class="amount" data-monthly={plan.monthlyPrice} data-annual={plan.annualPrice}>
                  <span class="amount-register" data-value={plan.monthlyPrice}>{plan.monthlyPrice}</span>
                </span>
                <span class="currency-unit" data-monthly-text=" USD" data-annual-text=" USD"> USD</span>
                <span class="period" data-monthly-text="/ mes" data-annual-text="/ año">/ mes</span>
              </div>
              <p class="cup-hoy" data-usd={plan.monthlyPrice}>≈ <span class="cup-num"></span> CUP / mes hoy</p>
              <div class="payment-method-tag">
                <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="payment-tag-icon" aria-hidden="true"><rect width="20" height="14" x="2" y="5" rx="2"/><line x1="2" x2="22" y1="10" y2="10"/></svg>
                <span class="payment-tag-text" data-monthly-text="USD o CUP al cambio" data-annual-text="Tarjeta Clásica (USD)">USD o CUP al cambio</span>
              </div>
              <span class="price-status" aria-live="polite"></span>
            </div>
          )}

          <dl class="card-limits">
            {plan.limits.map((limit) => (
              <div class="limit-row">
                <dt>{limit.label}</dt>
                <dd>{limit.value}</dd>
              </div>
            ))}
          </dl>

          {/* Siempre presente: cada tarjeta necesita las mismas 5 filas para el subgrid */}
          <div class:list={['card-features', { 'card-features--empty': plan.features.length === 0 }]}>
            {plan.features.length > 0 && (
              <ul>
                {plan.features.map((feature) => (
                  <li>
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="check-icon" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>
                    {feature}
                  </li>
                ))}
              </ul>
            )}
          </div>

          <div class="card-action">
            {plan.free ? (
              <Button
                variant="secondary"
                href="#descarga"
                icon="download"
                fullWidth
                class="plan-cta-btn"
              >
                Empezar gratis
              </Button>
            ) : (
              <Button
                variant={plan.recommended ? 'primary' : 'secondary'}
                href={`https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(mensajeMensual(plan.name, plan.monthlyIntro, plan.monthlyPrice))}`}
                icon="whatsapp"
                target="_blank"
                fullWidth
                class="plan-cta-btn"
                data-plan-name={plan.name}
                data-plan-intro={plan.monthlyIntro}
                data-plan-price={plan.monthlyPrice}
              >
                Elegir plan
              </Button>
            )}
          </div>
        </div>
      ))}
    </div>

    <div class="pasos cambio-only">
      <h3 class="pasos-titulo">Así pagas en moneda nacional</h3>
      <ol class="pasos-lista">
        {pasos.map((paso, i) => (
          <li>
            <span class="paso-n">{i + 1}</span>
            <div>
              <strong>{paso.titulo}</strong>
              <p>{paso.texto}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .precios-section {
    padding: clamp(var(--space-2xl), 8vw, var(--space-section-lg)) 0;
  }

  .section-header {
    margin-bottom: clamp(var(--space-lg), 5vw, var(--space-xl));
    max-width: 60ch;
  }

  .section-header h2 {
    margin-bottom: clamp(var(--space-xs), 2vw, var(--space-sm));
  }

  .subtitle {
    font-size: clamp(var(--fs-body), 2.5vw, var(--fs-lead));
    color: var(--ink-muted);
    line-height: 1.6;
  }

  /* === Toggle de facturación: dos placas, nunca una píldora === */
  .billing-toggle {
    display: inline-flex;
    gap: 2px;
    background: var(--board-panel);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    padding: 3px;
    margin: 0 0 clamp(var(--space-xl), 5vw, var(--space-2xl));
    max-width: calc(100vw - 32px);
    overflow-x: auto;
  }

  .billing-option {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: clamp(4px, 1vw, 8px);
    background: transparent;
    border: none;
    border-radius: var(--radius-sm);
    padding: clamp(9px, 2vw, 11px) clamp(14px, 3vw, 20px);
    min-height: 44px;
    font-family: var(--font-body);
    font-size: clamp(var(--fs-caption), 2vw, var(--fs-small));
    font-weight: 700;
    color: var(--ink-muted);
    cursor: pointer;
    white-space: nowrap;
    transition: background-color var(--dur-routine) ease, color var(--dur-routine) ease;
  }

  .billing-option[aria-pressed='true'] {
    background: var(--plate);
    color: var(--ink);
    box-shadow: var(--shadow-soft);
  }

  .billing-option:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .save-chip {
    display: inline-block;
    font-size: var(--fs-caption);
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--accent);
    background: var(--board);
    border-radius: var(--radius-sm);
    padding: 3px 8px;
    white-space: nowrap;
  }

  .billing-option[aria-pressed='true'] .save-chip {
    background: var(--accent);
    color: var(--accent-on);
  }

  .pricing-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(var(--space-md), 4vw, var(--space-lg));
  }

  .pricing-card {
    position: relative;
    background: var(--plate);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: clamp(var(--space-lg), 5vw, var(--space-xl));
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .pricing-card.recommended {
    border-color: var(--accent);
    box-shadow: var(--shadow-stamp);
  }

  .badge {
    position: absolute;
    top: 0;
    left: clamp(var(--space-lg), 5vw, var(--space-xl));
    transform: translateY(-50%);
    display: inline-block;
    background: var(--accent);
    color: var(--accent-on);
    font-size: var(--fs-caption);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 4px 10px;
    border-radius: var(--radius-sm);
    white-space: nowrap;
  }

  .card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
    margin-bottom: var(--space-lg);
  }

  .plan-name {
    font-size: clamp(var(--fs-title), 2.5vw, 1.375rem);
    font-weight: 700;
    color: var(--ink);
  }

  .card-price {
    margin-bottom: clamp(var(--space-md), 4vw, var(--space-lg));
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .intro-offer {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 2px;
  }

  .card-price[data-billing='annual'] .intro-offer {
    display: none;
  }

  .intro-prefix {
    flex-basis: 100%;
    color: var(--accent);
    font-size: var(--fs-small);
    font-weight: 700;
  }

  .intro-amount {
    color: var(--accent);
    font-size: clamp(1.75rem, 4.5vw, 2.25rem);
    font-weight: 800;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .intro-currency {
    color: var(--accent);
    font-size: clamp(0.9375rem, 2vw, 1.0625rem);
    font-weight: 700;
  }

  .price-row {
    display: flex;
    align-items: baseline;
    gap: 2px 5px;
    flex-wrap: wrap;
  }

  .price-prefix {
    font-size: var(--fs-small);
    color: var(--ink-muted);
  }

  .card-price[data-billing='annual'] .price-prefix {
    display: none;
  }

  .currency {
    font-size: clamp(1.5rem, 4vw, var(--fs-stat));
    font-weight: 700;
    color: var(--ink);
    /* Pegado al monto: "$2", no "$ 2" */
    margin-right: -4px;
  }

  .amount {
    font-size: clamp(1.5rem, 4vw, var(--fs-stat));
    font-weight: 800;
    color: var(--ink);
    line-height: 1;
    font-variant-numeric: tabular-nums;
    position: relative;
  }

  .currency-unit {
    font-size: var(--fs-small);
    font-weight: 600;
    color: var(--ink-muted);
  }

  .card-price[data-billing='monthly'] .price-row {
    margin-top: 2px;
  }

  .card-price[data-billing='monthly'] .price-row .price-prefix,
  .card-price[data-billing='monthly'] .price-row .currency,
  .card-price[data-billing='monthly'] .price-row .amount,
  .card-price[data-billing='monthly'] .price-row .currency-unit {
    font-size: clamp(0.875rem, 2vw, 0.95rem);
    font-weight: 500;
    color: var(--ink-muted);
  }

  .card-price[data-billing='annual'] .price-row .currency,
  .card-price[data-billing='annual'] .price-row .amount {
    font-size: clamp(1.75rem, 4.5vw, 2.25rem);
    font-weight: 800;
    color: var(--ink);
  }

  .card-price[data-billing='annual'] .price-row .currency-unit {
    font-size: clamp(0.9375rem, 2vw, 1.0625rem);
    font-weight: 700;
    color: var(--ink-muted);
    margin-left: 2px;
  }

  .amount-register {
    display: inline-block;
    transition: opacity 200ms ease-out, transform 200ms ease-out;
  }

  .amount-register.transitioning {
    opacity: 0;
    transform: translateY(-8px);
  }

  .period {
    font-size: var(--fs-small);
    color: var(--ink-muted);
    transition: opacity 200ms ease-out;
  }

  .period.transitioning,
  .currency-unit.transitioning,
  .payment-tag-text.transitioning {
    opacity: 0;
  }

  .payment-method-tag {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 8px;
    padding: 4px 8px;
    background: var(--board-panel);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    width: fit-content;
  }

  .payment-tag-icon {
    color: var(--accent);
    flex-shrink: 0;
  }

  .payment-tag-text {
    font-size: var(--fs-caption);
    font-weight: 500;
    color: var(--ink-muted);
    transition: opacity 200ms ease-out;
  }

  .price-status {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  .card-limits {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--line);
    margin: 0 0 var(--space-lg);
  }

  .limit-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    padding: var(--space-md) 0;
    border-bottom: 1px solid var(--line);
  }

  .limit-row dt {
    font-size: var(--fs-small);
    color: var(--ink-muted);
  }

  .limit-row dd {
    font-size: var(--fs-small);
    font-weight: 700;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }

  .card-features {
    margin-bottom: var(--space-lg);
    flex-grow: 1;
  }

  .card-features ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .card-features li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-xs);
    font-size: var(--fs-body);
    color: var(--ink);
  }

  .check-icon {
    color: var(--accent);
    flex-shrink: 0;
  }

  .card-action {
    margin-top: auto;
    align-self: end;
  }

  .card-features--empty {
    margin-bottom: 0;
  }

  /* === Bloque de precio del plan Gratuito: mismo ritmo que "1.er mes / monto / luego…" === */
  .card-price--free {
    gap: 4px;
  }

  .free-prefix {
    color: var(--accent);
    font-size: var(--fs-small);
    font-weight: 700;
  }

  .free-label {
    font-size: clamp(1.75rem, 4.5vw, 2.25rem);
    font-weight: 800;
    color: var(--accent);
    line-height: 1;
  }

  .free-sublabel {
    margin-top: 2px;
    font-size: clamp(0.875rem, 2vw, 0.95rem);
    font-weight: 500;
    color: var(--ink-muted);
  }

  /* === Pago en moneda nacional ===
     Solo aplica al plan mensual: el anual sigue siendo Tarjeta Clásica (USD),
     por eso todo lo marcado .cambio-only se oculta en modo anual. */
  .precios-section[data-billing='annual'] .cambio-only {
    display: none;
  }

  .cambio-banner {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-md);
    align-items: center;
    background: var(--plate);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-lg);
    padding: clamp(var(--space-md), 4vw, var(--space-lg));
    margin-bottom: clamp(var(--space-lg), 5vw, var(--space-xl));
  }

  .cambio-monedas {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    width: fit-content;
    color: var(--ink-muted);
  }

  .cambio-monedas span {
    background: var(--board);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-sm);
    padding: 6px 12px;
    color: var(--ink);
    font-weight: 800;
    letter-spacing: 0.04em;
  }

  .cambio-monedas span:last-child {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--accent-on);
  }

  .cambio-titulo {
    font-size: clamp(var(--fs-title), 2.5vw, 1.375rem);
    font-weight: 800;
    margin-bottom: var(--space-xs);
  }

  .cambio-texto p {
    color: var(--ink-muted);
    max-width: 62ch;
  }

  .tasa-linea {
    margin-top: var(--space-sm);
    min-height: 1.6em;
    font-size: var(--fs-small);
    font-variant-numeric: tabular-nums;
  }

  .tasa-linea strong {
    color: var(--ink);
    font-weight: 800;
  }

  /* Un solo texto visible según el estado de la consulta de la tasa */
  .tasa-cargando,
  .tasa-lista,
  .tasa-sin {
    display: none;
  }

  .precios-section[data-tasa-estado='cargando'] .tasa-cargando,
  .precios-section[data-tasa-estado='listo'] .tasa-lista,
  .precios-section[data-tasa-estado='sin-tasa'] .tasa-sin {
    display: inline;
  }

  /* Equivalente en CUP bajo cada precio. Mientras se consulta la tasa conserva
     su espacio (sin saltos de layout); si la tasa no llega, desaparece. */
  .cup-hoy {
    margin: 0;
    font-size: var(--fs-small);
    font-weight: 700;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }

  .cup-hoy--intro {
    color: var(--accent);
  }

  .precios-section[data-tasa-estado='cargando'] .cup-hoy {
    visibility: hidden;
  }

  .precios-section[data-tasa-estado='sin-tasa'] .cup-hoy,
  .card-price[data-billing='annual'] .cup-hoy {
    display: none;
  }

  /* En mensual la etiqueta de pago es el mensaje: aceptas CUP al cambio */
  .card-price[data-billing='monthly'] .payment-method-tag {
    background: var(--accent);
    border-color: var(--accent);
  }

  .card-price[data-billing='monthly'] .payment-tag-icon,
  .card-price[data-billing='monthly'] .payment-tag-text {
    color: var(--accent-on);
  }

  .card-price[data-billing='monthly'] .payment-tag-text {
    font-weight: 700;
  }

  /* Los tres pasos: aquí el orden sí es información */
  .pasos {
    margin-top: clamp(var(--space-lg), 5vw, var(--space-2xl));
    padding-top: var(--space-lg);
    border-top: 1px solid var(--line-strong);
  }

  .pasos-titulo {
    font-size: clamp(var(--fs-title), 2.5vw, 1.375rem);
    font-weight: 800;
    margin-bottom: var(--space-md);
  }

  .pasos-lista {
    list-style: none;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-md);
  }

  .pasos-lista li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-md);
    align-items: start;
    background: var(--plate);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: var(--space-md);
  }

  .paso-n {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-md);
    background: var(--accent);
    color: var(--accent-on);
    font-weight: 800;
    font-variant-numeric: tabular-nums;
  }

  .pasos-lista strong {
    display: block;
    line-height: 1.3;
    margin-bottom: 2px;
  }

  .pasos-lista p {
    font-size: var(--fs-small);
    color: var(--ink-muted);
  }

  @media (min-width: 52rem) {
    .cambio-banner {
      grid-template-columns: auto 1fr auto;
      gap: var(--space-lg);
    }

    .pasos-lista {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  /* 2 columnas en tablet; 4 solo cuando el contenedor está a su ancho máximo */
  @media (min-width: 40rem) {
    .pricing-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      /* row-gap 0: el gap del padre se heredaría entre las filas internas del subgrid */
      row-gap: 0;
      column-gap: var(--space-lg);
    }

    /* Subgrid: cabecera, precio, límites, extras y botón alineados entre tarjetas */
    .pricing-card {
      display: grid;
      grid-template-rows: subgrid;
      grid-row: span 5;
      row-gap: 0;
      height: auto;
      margin-bottom: var(--space-xl);
    }
  }

  @media (min-width: 72rem) {
    .pricing-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      column-gap: var(--space-md);
    }

    .pricing-card {
      padding: var(--space-lg);
      margin-bottom: 0;
    }

    .badge {
      left: var(--space-lg);
    }
  }
</style>

<script>
  interface Tasa {
    usd: number;
    tomadaEn: string;
    edadSeg: number;
    recibidoMs: number;
  }

  const CLAVE_CACHE = 'mipyutil:tasa-usd';
  // Una tasa guardada en el navegador se reutiliza este tiempo sin volver a pedirla.
  const VIGENCIA_CACHE_MS = 10 * 60 * 1000;
  const ESPERA_MAX_MS = 4000;

  // Monto con separador de miles "." y coma decimal, sin redondear: solo se
  // limpia el error de coma flotante a centavos (2266.5 sale "2.266,5").
  const formatoMonto = (n: number): string => {
    const [entera, decimales] = (Math.round(n * 100) / 100).toFixed(2).split('.');
    const miles = entera.replace(/\B(?=(\d{3})+(?!\d))/g, '.');
    const dec = decimales.replace(/0+$/, '');
    return dec ? `${miles},${dec}` : miles;
  };

  // Fecha y hora de Cuba a partir del instante que manda el servidor: no depende
  // del reloj del teléfono, que en Cuba suele estar mal puesto.
  const textoHora = (iso: string): string =>
    new Intl.DateTimeFormat('es', {
      timeZone: 'America/Havana',
      day: 'numeric',
      month: 'short',
      hour: 'numeric',
      minute: '2-digit',
      hour12: true
    }).format(new Date(iso));

  const validar = (x: any): Tasa | null => {
    const usd = Number(x?.usd);
    const edadSeg = Number(x?.edadSeg);
    const recibidoMs = Number(x?.recibidoMs);
    if (!Number.isFinite(usd) || usd <= 0) return null;
    if (!Number.isFinite(edadSeg) || edadSeg < 0 || !Number.isFinite(recibidoMs)) return null;
    if (typeof x?.tomadaEn !== 'string' || Number.isNaN(Date.parse(x.tomadaEn))) return null;
    return { usd, tomadaEn: x.tomadaEn, edadSeg, recibidoMs };
  };

  const leerCache = (): Tasa | null => {
    try {
      const crudo = localStorage.getItem(CLAVE_CACHE);
      return crudo ? validar(JSON.parse(crudo)) : null;
    } catch {
      return null;
    }
  };

  // Antigüedad de la tasa: la que calculó el servidor al responder, más lo que
  // pasó desde entonces en este navegador (diferencia de relojes propios, válida
  // aunque la fecha del teléfono esté mal).
  const edadActualSeg = (t: Tasa): number => t.edadSeg + Math.max(0, (Date.now() - t.recibidoMs) / 1000);

  const pedirTasa = async (url: string): Promise<Tasa | null> => {
    const controlador = new AbortController();
    const temporizador = setTimeout(() => controlador.abort(), ESPERA_MAX_MS);
    try {
      const res = await fetch(url, { signal: controlador.signal });
      if (!res.ok) return null;
      const cuerpo = await res.json();
      const tasa = validar({
        usd: cuerpo?.usd,
        tomadaEn: cuerpo?.tomada_en,
        edadSeg: cuerpo?.edad_seg,
        recibidoMs: Date.now()
      });
      if (tasa) {
        try {
          localStorage.setItem(CLAVE_CACHE, JSON.stringify(tasa));
        } catch {
          /* sin almacenamiento: se pide de nuevo la próxima vez */
        }
      }
      return tasa;
    } catch {
      return null;
    } finally {
      clearTimeout(temporizador);
    }
  };

  // Tasa fresca de la caché local si la hay; si no, la pide. Si la consulta falla
  // devuelve la última guardada (aunque sea vieja) para que quien decide sea la
  // regla de antigüedad máxima, no la red.
  const obtenerTasa = async (url: string): Promise<Tasa | null> => {
    const guardada = leerCache();
    if (guardada) {
      const transcurrido = Date.now() - guardada.recibidoMs;
      if (transcurrido >= 0 && transcurrido < VIGENCIA_CACHE_MS) return guardada;
    }
    return (await pedirTasa(url)) ?? guardada;
  };

  document.addEventListener('DOMContentLoaded', () => {
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const TRANSITION_DURATION = 250;

    const seccion = document.querySelector<HTMLElement>('#precios');
    const group = document.querySelector('.billing-toggle');
    if (!seccion || !group) return;

    const whatsapp = seccion.dataset.whatsapp ?? '';
    const tasaUrl = seccion.dataset.tasaUrl ?? '';
    const maxEdadSeg = Number(seccion.dataset.tasaMaxHoras ?? 24) * 3600;

    const options = Array.from(group.querySelectorAll<HTMLElement>('.billing-option'));
    const registers = Array.from(document.querySelectorAll<HTMLElement>('.amount-register'));
    const periods = Array.from(document.querySelectorAll<HTMLElement>('.period'));
    const pricePrefixes = Array.from(document.querySelectorAll<HTMLElement>('.price-prefix'));
    const currencies = Array.from(document.querySelectorAll<HTMLElement>('.currency'));
    const currencyUnits = Array.from(document.querySelectorAll<HTMLElement>('.currency-unit'));
    const paymentTagTexts = Array.from(document.querySelectorAll<HTMLElement>('.payment-tag-text'));
    const cardPrices = Array.from(document.querySelectorAll<HTMLElement>('.card-price'));
    const statuses = Array.from(document.querySelectorAll<HTMLElement>('.price-status'));
    const planButtons = Array.from(document.querySelectorAll<HTMLAnchorElement>('.plan-cta-btn'));
    const cupLines = Array.from(document.querySelectorAll<HTMLElement>('.cup-hoy'));
    const valorTasa = seccion.querySelector<HTMLElement>('.tasa-valor');
    const horaTasa = seccion.querySelector<HTMLTimeElement>('.tasa-hora');

    // Solo hay tasa cuando es reciente; si no, la página queda en USD y WhatsApp.
    let tasa: Tasa | null = null;
    let isTransitioning = false;

    const mensajeWhatsApp = (btn: HTMLAnchorElement): string => {
      const nombre = btn.dataset.planName ?? '';
      if (seccion.dataset.billing === 'annual') {
        return `Hola, me interesa el plan anual ${nombre} de la app MiPyUtil`;
      }
      let mensaje = `Hola, me interesa el plan mensual ${nombre} de la app MiPyUtil. Vi $${btn.dataset.planIntro} USD el primer mes y $${btn.dataset.planPrice} USD al mes después.`;
      if (tasa) {
        mensaje += ` Tasa que vi: 1 USD = ${formatoMonto(tasa.usd)} CUP (elTOQUE, ${textoHora(tasa.tomadaEn)}).`;
      }
      return mensaje;
    };

    const actualizarEnlaces = () => {
      planButtons.forEach((btn) => {
        if (btn.dataset.planName) {
          btn.href = `https://wa.me/${whatsapp}?text=${encodeURIComponent(mensajeWhatsApp(btn))}`;
        }
      });
    };

    const aplicarTasa = (nueva: Tasa | null) => {
      const vigente = nueva !== null && edadActualSeg(nueva) <= maxEdadSeg;
      tasa = vigente ? nueva : null;
      seccion.dataset.tasaEstado = tasa ? 'listo' : 'sin-tasa';

      if (tasa) {
        const { usd, tomadaEn } = tasa;
        if (valorTasa) valorTasa.textContent = formatoMonto(usd);
        if (horaTasa) {
          horaTasa.textContent = textoHora(tomadaEn);
          horaTasa.dateTime = tomadaEn;
        }
        cupLines.forEach((linea) => {
          const num = linea.querySelector<HTMLElement>('.cup-num');
          if (num) num.textContent = formatoMonto(Number(linea.dataset.usd) * usd);
        });
      }
      actualizarEnlaces();
    };

    const consultarTasa = async () => {
      if (!tasaUrl) return aplicarTasa(null);
      aplicarTasa(await obtenerTasa(tasaUrl));
    };

    consultarTasa();

    // Pestaña abierta por horas: al volver a ella se renueva la tasa si ya venció la caché.
    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'visible') consultarTasa();
    });

    const applyBilling = async (mode: string) => {
      if (isTransitioning) return;

      const isAnnual = mode === 'annual';
      const currentMode = options.find((opt) => opt.getAttribute('aria-pressed') === 'true');
      if (currentMode?.dataset.billing === mode) return;

      isTransitioning = true;

      options.forEach((opt) => {
        opt.setAttribute('aria-pressed', String(opt.dataset.billing === mode));
      });

      const swap = () => {
        registers.forEach((register) => {
          const amount = register.closest<HTMLElement>('.amount');
          const newValue = isAnnual ? (amount?.dataset.annual || '') : (amount?.dataset.monthly || '');
          register.textContent = newValue;
          register.dataset.value = newValue;
        });

        pricePrefixes.forEach((prefix) => {
          prefix.textContent = isAnnual ? (prefix.dataset.annualText || '') : (prefix.dataset.monthlyText || '');
        });

        currencies.forEach((curr) => {
          curr.textContent = isAnnual ? (curr.dataset.annualCurrency || '') : (curr.dataset.monthlyCurrency || '');
        });

        currencyUnits.forEach((unit) => {
          unit.textContent = isAnnual ? (unit.dataset.annualText || '') : (unit.dataset.monthlyText || '');
        });

        periods.forEach((period) => {
          const text = isAnnual ? period.dataset.annualText : period.dataset.monthlyText;
          period.textContent = text || period.textContent || '';
        });

        paymentTagTexts.forEach((tag) => {
          tag.textContent = isAnnual ? (tag.dataset.annualText || '') : (tag.dataset.monthlyText || '');
        });
      };

      if (!reduceMotion) {
        registers.forEach((r) => r.classList.add('transitioning'));
        periods.forEach((p) => p.classList.add('transitioning'));
        currencyUnits.forEach((u) => u.classList.add('transitioning'));
        paymentTagTexts.forEach((t) => t.classList.add('transitioning'));

        await new Promise((resolve) => setTimeout(resolve, 200));
        swap();
        void registers[0]?.offsetHeight;

        registers.forEach((r) => r.classList.remove('transitioning'));
        periods.forEach((p) => p.classList.remove('transitioning'));
        currencyUnits.forEach((u) => u.classList.remove('transitioning'));
        paymentTagTexts.forEach((t) => t.classList.remove('transitioning'));
      } else {
        swap();
      }

      seccion.dataset.billing = mode;
      cardPrices.forEach((el) => {
        el.dataset.billing = mode;
      });

      statuses.forEach((status) => {
        const card = status.closest<HTMLElement>('.card-price');
        const amount = card?.querySelector<HTMLElement>('.amount');
        const period = card?.querySelector<HTMLElement>('.period');
        const price = isAnnual ? (amount?.dataset.annual || '') : (amount?.dataset.monthly || '');
        const suffix = isAnnual ? (period?.dataset.annualText || '') : (period?.dataset.monthlyText || '');
        status.textContent = `$${price} USD ${suffix}`.trim();
      });

      actualizarEnlaces();

      await new Promise((resolve) => setTimeout(resolve, TRANSITION_DURATION));
      isTransitioning = false;
    };

    options.forEach((opt) => {
      opt.addEventListener('click', () => applyBilling(opt.dataset.billing || ''));
    });
  });
</script>
