---
import Button from '../ui/Button.astro';

const stats = [
  { value: '~30 MB', label: 'Tamaño total' },
  { value: '~2 min', label: 'Descarga con señal de Etecsa' },
  { value: 'Android 8+', label: 'Cualquier teléfono reciente' }
];
---

<section id="descarga" class="descarga dark-band">
  <div class="container">
    <h2>Instálala en segundos, sin Play Store.</h2>
    <p class="lead">
      La APK se comparte directo por WhatsApp, Telegram o Zapya. Se instala en cualquier 
      Android y queda lista para el primer turno.
    </p>

    <div class="download-stats">
      {stats.map(stat => (
        <div class="stat">
          <div class="stat-value">{stat.value}</div>
          <div class="stat-label">{stat.label}</div>
        </div>
      ))}
    </div>

    <div class="cta-group">
      <Button variant="primary" icon="download" class="btn-full-width">Descargar APK <span class="size-badge">~30 MB</span></Button>
      <p class="cta-divider">O escríbenos por:</p>
      <div class="secondary-ctas">
        <Button variant="secondary" icon="whatsapp">Contacto WhatsApp</Button>
        <Button variant="secondary" type="link" href="https://t.me/MipyUtil" icon="telegram">Canal de Telegram</Button>
      </div>
    </div>
  </div>
</section>

<style>
  .dark-band {
    color: var(--ink);
    text-align: center;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .dark-band h2,
  .dark-band p {
    color: var(--ink);
  }

  .dark-band a {
    color: var(--primary-light);
    font-weight: 600;
  }

  .dark-band a:hover {
    color: var(--primary-light);
    text-decoration: underline;
  }

  .descarga h2 {
    margin-bottom: clamp(var(--space-md), 4vw, var(--space-lg));
    font-size: clamp(var(--fs-title), 4vw, var(--fs-headline));
  }

  .lead {
    font-size: clamp(var(--fs-body), 2.5vw, var(--fs-lead));
    line-height: var(--lh-lead);
    margin: 0 auto clamp(var(--space-lg), 5vw, var(--space-xl));
    max-width: 70ch;
    color: var(--ink-secondary);
  }

  .download-stats {
    display: grid;
    gap: clamp(var(--space-md), 4vw, var(--space-lg));
    max-width: 900px;
    margin: clamp(var(--space-xl), 6vw, var(--space-2xl)) auto;
    grid-template-columns: 1fr;
  }

  .stat {
    background: var(--surface);
    padding: var(--space-lg);
    border-radius: var(--radius-lg);
    border: 1px solid var(--line);
    transition: border-color 200ms ease;
    text-align: center;
  }
  
  .stat:hover {
    border-color: var(--primary-light);
  }

  .stat-value {
    font-size: clamp(var(--fs-xl), 4vw, var(--fs-stat));
    font-weight: 700;
    line-height: 1.15;
    color: var(--primary-light);
    margin-bottom: clamp(var(--space-xs), 2vw, var(--space-sm));
    font-variant-numeric: tabular-nums;
  }

  .stat-label {
    font-size: clamp(var(--fs-caption), 2vw, var(--fs-small));
    color: var(--ink-secondary);
    line-height: 1.4;
  }

  .cta-group {
    display: flex;
    flex-direction: column;
    gap: clamp(var(--space-xs), 2vw, var(--space-sm));
    margin-bottom: clamp(var(--space-lg), 5vw, var(--space-xl));
    align-items: stretch;
    width: 100%;
    max-width: 500px;
    margin-left: auto;
    margin-right: auto;
  }
  
  .cta-group :global(.btn-full-width) {
    width: 100%;
  }
  
  .cta-divider {
    font-size: clamp(var(--fs-caption), 2vw, var(--fs-small));
    color: var(--ink-secondary);
    margin: clamp(var(--space-xs), 2vw, var(--space-sm)) 0;
    text-align: center;
  }

  .secondary-ctas {
    display: flex;
    flex-direction: column;
    gap: clamp(var(--space-xs), 2vw, var(--space-sm));
    width: 100%;
  }
  
  .secondary-ctas :global(.btn) {
    flex: 1;
  }
  
  .size-badge {
    opacity: 0.8;
    font-size: clamp(var(--fs-caption), 2vw, var(--fs-small));
    font-weight: 500;
  }

  @media (min-width: 40rem) {
    .secondary-ctas {
      flex-direction: row;
      gap: var(--space-md);
    }

    .cta-group {
      gap: var(--space-sm);
    }

    .download-stats {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-lg);
    }

    .stat {
      padding: var(--space-xl);
    }
  }

  @media (min-width: 48rem) {
    .download-stats {
      gap: var(--space-xl);
    }
  }

  .descarga-note {
    font-size: clamp(var(--fs-caption), 2vw, var(--fs-small));
  }
</style>
