---
interface Props {
  variant?: 'primary' | 'secondary';
  icon?: 'download' | 'whatsapp' | 'telegram';
  href?: string;
  type?: 'button' | 'link';
  onClick?: string;
  disabled?: boolean;
  loading?: boolean;
  fullWidth?: boolean;
  class?: string;
}

const { 
  variant = 'primary', 
  icon,
  href = '#', 
  type = 'link',
  onClick,
  disabled = false,
  loading = false,
  fullWidth = false,
  class: className 
} = Astro.props;
---

{type === 'button' ? (
  <button 
    class={`btn btn-${variant} ${fullWidth ? 'btn-full' : ''} ${className || ''}`}
    onclick={onClick}
    type="button"
    disabled={disabled || loading}
    aria-busy={loading}
  >
    {loading && (
      <svg class="spinner" viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="12" cy="12" r="10" stroke="currentColor" fill="none" stroke-width="3" stroke-dasharray="63" stroke-dashoffset="0">
          <animate attributeName="stroke-dashoffset" from="0" to="63" dur="1s" repeatCount="indefinite" />
        </circle>
      </svg>
    )}
    <span class:list={{ 'btn-content': true, 'loading': loading }}>
      {icon === 'download' && (
        <svg class="btn-icon btn-icon--download" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
          <polyline points="7 10 12 15 17 10"></polyline>
          <line x1="12" y1="15" x2="12" y2="3"></line>
        </svg>
      )}
      {icon === 'whatsapp' && (
        <svg class="btn-icon btn-icon--whatsapp" viewBox="0 0 24 24" aria-hidden="true">
          <path fill="currentColor" d="M19.05 4.91A9.816 9.816 0 0 0 12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01zm-7.01 15.24c-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.264 8.264 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.24-8.24 2.2 0 4.27.86 5.82 2.42a8.183 8.183 0 0 1 2.41 5.83c.02 4.54-3.68 8.23-8.22 8.23zm4.52-6.16c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.12-.17.25-.64.81-.78.97-.14.17-.29.19-.54.06-.25-.12-1.05-.39-1.99-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.02-.38.11-.51.11-.11.25-.29.37-.43s.17-.25.25-.41c.08-.17.04-.31-.02-.43s-.56-1.34-.76-1.84c-.2-.48-.41-.42-.56-.43h-.48c-.17 0-.43.06-.66.31-.22.25-.86.85-.86 2.07 0 1.22.89 2.4 1.01 2.56.12.17 1.75 2.67 4.23 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.67-1.18.21-.58.21-1.07.14-1.18s-.22-.16-.47-.28z"/>
        </svg>
      )}
      {icon === 'telegram' && (
        <svg class="btn-icon btn-icon--telegram" viewBox="0 0 24 24" aria-hidden="true">
          <path fill="currentColor" d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69a.2.2 0 0 0-.05-.18c-.06-.05-.14-.03-.21-.02-.09.02-1.49.95-4.22 2.79-.4.27-.76.41-1.08.4-.36-.01-1.04-.2-1.55-.37-.63-.2-1.12-.31-1.08-.66.02-.18.27-.36.74-.55 2.92-1.27 4.86-2.11 5.83-2.51 2.78-1.16 3.35-1.36 3.73-1.36.08 0 .27.02.39.12.1.08.13.19.14.27-.01.06.01.24 0 .38z"/>
        </svg>
      )}
      <slot />
    </span>
  </button>
) : (
  <a href={href} class={`btn btn-${variant} ${fullWidth ? 'btn-full' : ''} ${className || ''}`}>
    <span class="btn-content">
      {icon === 'download' && (
        <svg class="btn-icon btn-icon--download" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
          <polyline points="7 10 12 15 17 10"></polyline>
          <line x1="12" y1="15" x2="12" y2="3"></line>
        </svg>
      )}
      {icon === 'whatsapp' && (
        <svg class="btn-icon btn-icon--whatsapp" viewBox="0 0 24 24" aria-hidden="true">
          <path fill="currentColor" d="M19.05 4.91A9.816 9.816 0 0 0 12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01zm-7.01 15.24c-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.264 8.264 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.24-8.24 2.2 0 4.27.86 5.82 2.42a8.183 8.183 0 0 1 2.41 5.83c.02 4.54-3.68 8.23-8.22 8.23zm4.52-6.16c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.12-.17.25-.64.81-.78.97-.14.17-.29.19-.54.06-.25-.12-1.05-.39-1.99-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.02-.38.11-.51.11-.11.25-.29.37-.43s.17-.25.25-.41c.08-.17.04-.31-.02-.43s-.56-1.34-.76-1.84c-.2-.48-.41-.42-.56-.43h-.48c-.17 0-.43.06-.66.31-.22.25-.86.85-.86 2.07 0 1.22.89 2.4 1.01 2.56.12.17 1.75 2.67 4.23 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.67-1.18.21-.58.21-1.07.14-1.18s-.22-.16-.47-.28z"/>
        </svg>
      )}
      {icon === 'telegram' && (
        <svg class="btn-icon btn-icon--telegram" viewBox="0 0 24 24" aria-hidden="true">
          <path fill="currentColor" d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69a.2.2 0 0 0-.05-.18c-.06-.05-.14-.03-.21-.02-.09.02-1.49.95-4.22 2.79-.4.27-.76.41-1.08.4-.36-.01-1.04-.2-1.55-.37-.63-.2-1.12-.31-1.08-.66.02-.18.27-.36.74-.55 2.92-1.27 4.86-2.11 5.83-2.51 2.78-1.16 3.35-1.36 3.73-1.36.08 0 .27.02.39.12.1.08.13.19.14.27-.01.06.01.24 0 .38z"/>
        </svg>
      )}
      <slot />
    </span>
  </a>
)}

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: clamp(6px, 1.5vw, 8px);
    padding: clamp(10px, 2.5vw, 12px) clamp(18px, 4vw, 24px);
    font-size: clamp(0.9375rem, 2.5vw, var(--fs-body));
    font-weight: 600;
    font-family: var(--font-family);
    border-radius: var(--radius-md);
    transition: background-color var(--dur-routine) ease, 
                border-color var(--dur-routine) ease, 
                color var(--dur-routine) ease, 
                box-shadow var(--dur-routine) ease,
                transform var(--dur-feedback) ease;
    text-align: center;
    cursor: pointer;
    border: 2px solid transparent;
    position: relative;
    text-decoration: none;
    line-height: 1.4;
    letter-spacing: -0.01em;
    /* Sin nowrap: a 200% de zoom o en pantallas estrechas el texto envuelve
       en vez de desbordar la página */
    white-space: normal;
    min-height: 44px;
  }
  
  .btn-full {
    width: 100%;
  }

  .btn:active {
    transform: translateY(1px);
  }
  
  /* Área táctil mínima para puntero grueso */
  @media (pointer: coarse) {
    .btn {
      min-height: 48px;
      padding: 12px 20px;
    }
  }
  
  .btn[disabled] {
    opacity: 0.5;
    cursor: not-allowed;
    pointer-events: none;
  }

  /* === PRIMARY === */
  .btn-primary {
    background: var(--primary);
    color: white;
    border-color: var(--primary);
  }

  .btn-primary:hover {
    background: var(--primary-deep);
    border-color: var(--primary-deep);
    color: white;
    box-shadow: var(--shadow-elevated);
  }

  /* === SECONDARY === */
  .btn-secondary {
    background: var(--surface);
    color: var(--ink);
    border-color: var(--line-strong);
  }

  .btn-secondary:hover {
    background: var(--surface-secondary);
    color: var(--primary-light);
    border-color: var(--primary-light);
  }

  /* Dark band overrides */
  :global(.dark-band) .btn-secondary {
    background: var(--hover-overlay);
    color: var(--ink);
    border-color: var(--line);
  }

  :global(.dark-band) .btn-secondary:hover {
    background: var(--active-overlay);
    color: var(--primary-light);
    border-color: var(--primary-light);
  }

  /* === SPINNER === */
  .spinner {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
  }
  
  /* === CONTENT === */
  .btn-content {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
  }

  .btn-content.loading {
    opacity: 0.6;
  }

  /* === ICONS === */
  .btn-icon {
    width: clamp(18px, 4vw, 20px);
    height: clamp(18px, 4vw, 20px);
    flex-shrink: 0;
    transition: transform var(--dur-routine) var(--ease-out-expo);
  }

  /* Icon colors: inherit from button text */
  .btn-primary .btn-icon {
    color: white;
  }

  .btn-secondary .btn-icon {
    color: var(--ink-secondary);
  }

  .btn-secondary:hover .btn-icon {
    color: var(--primary-light);
  }

  :global(.dark-band) .btn-secondary .btn-icon {
    color: var(--ink-secondary);
  }

  :global(.dark-band) .btn-secondary:hover .btn-icon {
    color: var(--primary-light);
  }

  /* === FOCUS === */
  .btn:focus-visible {
    outline: 2px solid var(--primary-light);
    outline-offset: 2px;
  }

  /* === MOTION === */
  @media (prefers-reduced-motion: no-preference) {
    .btn:hover .btn-icon--download,
    .btn:focus-visible .btn-icon--download {
      transform: translateY(2px);
    }

    .btn:hover .btn-icon--whatsapp,
    .btn:focus-visible .btn-icon--whatsapp {
      transform: translateX(2px);
    }

    .btn:hover .btn-icon--telegram,
    .btn:focus-visible .btn-icon--telegram {
      transform: translate(1px, -1px);
    }
  }
  
  /* Touch feedback for mobile */
  @media (hover: none) and (pointer: coarse) {
    .btn:active {
      transform: translateY(0) scale(0.97);
    }
  }
</style>
