---
interface FixRow {
  was: string;
  now: string;
}

const fixes: FixRow[] = [
  {
    was: 'Apagones y mala señal te paraban.',
    now: 'Funciona sin internet, siempre.'
  },
  {
    was: 'La libreta y el Excel, un lío.',
    now: 'Inventario y ventas, al día.'
  },
  {
    was: 'El cuadre a mano, nunca exacto.',
    now: 'Cuadre diario, aprobado por ti.'
  }
];
---

<section id="problema" class="problema dark-band">
  <div class="container">
    <h2>El día a día de tu negocio no espera por el internet.</h2>

    <div class="plate-panel fix-plate">
      <span class="screw screw--tl" aria-hidden="true"></span>
      <span class="screw screw--tr" aria-hidden="true"></span>
      <span class="screw screw--bl" aria-hidden="true"></span>
      <span class="screw screw--br" aria-hidden="true"></span>
      <ul class="fix-list">
        {fixes.map(fix => (
          <li class="fix-row">
            <p class="fix-was"><del>{fix.was}</del></p>
            <p class="fix-now">
              <svg class="fix-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
              {fix.now}
            </p>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .problema {
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .problema h2 {
    margin-bottom: clamp(var(--space-lg), 5vw, var(--space-xl));
    font-size: clamp(var(--fs-title), 4vw, var(--fs-headline));
    max-width: 24ch;
  }

  .fix-plate {
    padding: clamp(var(--space-md), 4vw, var(--space-lg));
  }

  .fix-list {
    display: flex;
    flex-direction: column;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .fix-row {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: clamp(var(--space-md), 4vw, var(--space-lg)) clamp(var(--space-sm), 3vw, var(--space-md));
    border-bottom: 1px solid var(--line);
  }

  .fix-row:last-child {
    border-bottom: none;
  }

  .fix-row .fix-was {
    margin: 0;
    font-size: clamp(0.9375rem, 2.5vw, var(--fs-body));
    font-weight: 600;
    color: var(--ink-muted);
  }

  .fix-row .fix-was del {
    text-decoration-color: var(--accent);
    text-decoration-thickness: 2px;
  }

  .fix-row .fix-now {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin: 0;
    font-size: clamp(var(--fs-body), 2.5vw, var(--fs-lead));
    font-weight: 700;
    color: var(--ink);
  }

  .fix-arrow {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    color: var(--accent);
  }

  @media (min-width: 40rem) {
    .fix-row {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: clamp(var(--space-md), 3vw, var(--space-lg));
    }

    .fix-row .fix-was {
      flex: 1;
    }

    .fix-row .fix-now {
      flex: 1;
    }
  }
</style>
