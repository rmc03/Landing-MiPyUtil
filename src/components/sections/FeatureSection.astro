---
interface Props {
  title: string;
  reverse?: boolean;
  band?: boolean;
  id?: string;
  class?: string;
}

const { title, reverse = false, band = false, id, class: className } = Astro.props;
---

<section id={id} class={`feature-section ${className || ''} ${band ? 'band' : ''}`}>
  <div class="container">
    <div class={`feature-layout ${reverse ? 'reverse' : ''}`}>
      <div class="feature-visual">
        <slot name="visual" />
      </div>
      <div class="feature-content">
        <h2>{title}</h2>
        <slot />
      </div>
    </div>
  </div>
</section>

<style>
  .feature-section.band {
    background: var(--board-panel);
  }

  .feature-layout {
    display: grid;
    gap: clamp(var(--space-lg), 6vw, var(--space-2xl));
    align-items: center;
  }

  .feature-visual {
    order: 2;
  }

  .feature-content {
    order: 1;
  }

  .feature-content h2 {
    margin-bottom: clamp(var(--space-md), 4vw, var(--space-lg));
  }

  .feature-content :global(ul) {
    list-style: none;
    margin: clamp(var(--space-md), 4vw, var(--space-lg)) 0;
  }

  .feature-content :global(li) {
    padding-inline-start: 1.4em;
    position: relative;
    margin-bottom: clamp(var(--space-sm), 3vw, var(--space-md));
    font-size: clamp(0.9375rem, 2.5vw, 1rem);
    line-height: 1.6;
  }

  .feature-content :global(li::before) {
    content: '';
    position: absolute;
    inset-inline-start: 0;
    top: 0.5em;
    width: 8px;
    height: 8px;
    background: var(--accent);
    border-radius: 2px;
  }

  .feature-content :global(.inline-cta) {
    font-size: clamp(var(--fs-caption), 2vw, var(--fs-small));
    margin-top: clamp(var(--space-md), 4vw, var(--space-lg));
  }

  @media (min-width: 48rem) {
    .feature-layout {
      grid-template-columns: 1fr 1fr;
      gap: clamp(var(--space-2xl), 6vw, var(--space-3xl));
    }

    .feature-visual {
      order: unset;
    }

    .feature-content {
      order: unset;
    }

    .feature-layout.reverse .feature-visual {
      order: 2;
    }
  }

  @media (min-width: 64rem) {
    .feature-layout {
      gap: var(--space-3xl);
    }
  }
</style>
