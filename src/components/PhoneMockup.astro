---
import ScreenSkeleton from './ui/ScreenSkeleton.astro';

export interface Props {
  screenshot: string;
  alt: string;
  compact?: boolean;
}

const { screenshot, alt, compact = false } = Astro.props;
const lightSrc = `/screens/${screenshot}`;
const darkSrc = `/screens/${screenshot.replace(/\.png$/i, '-dark.png')}`;
const screenId = screenshot.replace(/\.png$/i, '');
---

<div class:list={['phone-mockup', { compact }]}>
  <div class="phone-frame">
    <div class="phone-notch"></div>
    <div class="phone-screen">
      <ScreenSkeleton screen={screenId} />
      <img
        class="phone-shot"
        src={lightSrc}
        data-light-src={lightSrc}
        data-dark-src={darkSrc}
        alt={alt}
        loading="lazy"
      />
    </div>
  </div>
</div>

<script>
  const shots = Array.from(document.querySelectorAll<HTMLImageElement>('.phone-shot'));
  const root = document.documentElement;
  const darkFailed = new WeakSet<HTMLImageElement>();

  function applyTheme(img: HTMLImageElement) {
    const light = img.dataset.lightSrc!;
    const dark = img.dataset.darkSrc!;
    const current = img.getAttribute('src');

    if (root.dataset.theme === 'dark' && !darkFailed.has(img) && current !== dark) {
      img.setAttribute('src', dark);
    } else if (root.dataset.theme !== 'dark' && current !== light) {
      img.setAttribute('src', light);
    }
  }

  shots.forEach((img) => {
    img.addEventListener('error', () => {
      const current = img.getAttribute('src');
      if (current === img.dataset.darkSrc) {
        darkFailed.add(img);
        img.setAttribute('src', img.dataset.lightSrc!);
      } else {
        img.classList.add('img-failed');
      }
    });
    applyTheme(img);
  });

  const observer = new MutationObserver(() => shots.forEach(applyTheme));
  observer.observe(root, { attributes: true, attributeFilter: ['data-theme'] });
</script>

<style>
  .phone-mockup {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    max-width: 100%;
  }

  .phone-frame {
    position: relative;
    width: 100%;
    max-width: min(280px, 90vw);
    aspect-ratio: 9 / 19.5;
    background: var(--ink);
    border-radius: clamp(20px, 5vw, var(--radius-phone)); /* impeccable-disable-line design-system-radius -- radio fluido del marco */
    padding: clamp(8px, 2vw, 12px);
    box-shadow: var(--shadow-subtle);
  }

  @media (prefers-reduced-motion: no-preference) {
    .phone-frame {
      transition: transform var(--dur-routine) var(--ease-out-expo), box-shadow var(--dur-routine) var(--ease-out-expo);
    }

    .phone-frame:hover {
      transform: translateY(-3px);
      box-shadow: var(--shadow-card);
    }
  }

  .dark-band .phone-frame {
    background: var(--surface-tertiary);
    box-shadow: var(--shadow-subtle);
  }

  .phone-notch {
    position: absolute;
    top: clamp(8px, 2vw, 12px);
    left: 50%;
    transform: translateX(-50%);
    width: clamp(80px, 20vw, 120px);
    height: clamp(16px, 4vw, 24px);
    background: var(--surface);
    border-radius: 0 0 clamp(12px, 3vw, 16px) clamp(12px, 3vw, 16px); /* impeccable-disable-line design-system-radius -- radio fluido de la muesca */
    z-index: 2;
  }

  .phone-screen {
    width: 100%;
    height: 100%;
    background: var(--surface);
    border-radius: calc(clamp(20px, 5vw, var(--radius-phone)) - 8px); /* impeccable-disable-line design-system-radius -- radio fluido del marco */
    overflow: hidden;
    position: relative;
  }

  .phone-screen .phone-shot {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .phone-screen .phone-shot.img-failed {
    display: none;
  }

  /* Compact (hero): teléfono más pequeño para no robar protagonismo al texto */
  .phone-mockup.compact .phone-frame {
    max-width: min(230px, 80vw);
  }

  @media (min-width: 375px) {
    .phone-frame {
      max-width: min(300px, 85vw);
    }

    .phone-mockup.compact .phone-frame {
      max-width: 230px;
    }
  }

  @media (min-width: 640px) {
    .phone-frame {
      max-width: 280px;
    }

    .phone-mockup.compact .phone-frame {
      max-width: 250px;
    }
  }

  @media (min-width: 768px) {
    .phone-frame {
      max-width: 300px;
    }
  }

  @media (min-width: 1024px) {
    .phone-frame {
      max-width: 320px;
    }

    .phone-mockup.compact .phone-frame {
      max-width: 260px;
    }
  }
</style>
