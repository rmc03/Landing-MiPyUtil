---
/**
 * THESIS: Sustituir el screenshot estático del hero por un dashboard vivo que demuestre
 * la propuesta de valor instantáneamente — datos reales actualizándose, métricas subiendo,
 * indicador offline parpadeando. La app en acción, no una captura muerta.
 * 
 * OWN-WORLD: Paleta Clean Focus (índigo + neutros), cards planas con shadow subtle,
 * tipografía Inter, números animados con ease-out-expo, indicador offline con pulso verde.
 * 
 * STORY: El visitante ve el panel Resumen de MiPyUtil funcionando en tiempo real:
 * ventas que suben, productos más vendidos, stock que cambia. Sin necesidad de leer,
 * entiende que esto es un sistema vivo que gestiona su negocio.
 * 
 * FIRST VIEWPORT: Dashboard compacto vertical con 3 bloques:
 * 1. Header con "Resumen" y badge OFFLINE pulsante
 * 2. Métricas principales (Ventas hoy, Ingresos, Productos vendidos) — números animados
 * 3. Lista de productos más vendidos con barras de progreso animadas
 * 
 * BEHAVIOR: Los números incrementan suavemente cada 3-4 segundos simulando ventas nuevas.
 * Las barras se animan con stagger. El badge offline pulsa. Respeta prefers-reduced-motion.
 */
---

<div class="live-dashboard">
  <div class="dashboard-header">
    <h3 class="dashboard-title">Resumen</h3>
    <span class="offline-badge" aria-label="Funciona sin conexión">
      <svg class="offline-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="2" y1="2" x2="22" y2="22"></line>
        <path d="M8.5 16.5a5 5 0 0 1 7 0"></path>
        <path d="M2 8.82a15 15 0 0 1 4.17-2.65"></path>
        <path d="M10.66 5c4.01-.36 8.14.9 11.34 3.76"></path>
        <path d="M16.85 11.25a10 10 0 0 1 2.22 1.68"></path>
        <path d="M5 13a10 10 0 0 1 5.24-2.76"></path>
      </svg>
      <span class="offline-text">OFFLINE</span>
    </span>
  </div>

  <div class="metrics-grid">
    <div class="metric-card">
      <div class="metric-label">Ventas hoy</div>
      <div class="metric-value" data-metric="sales" data-target="47">0</div>
    </div>
    <div class="metric-card">
      <div class="metric-label">Ingresos</div>
      <div class="metric-value" data-metric="revenue" data-target="3850">$0</div>
    </div>
    <div class="metric-card">
      <div class="metric-label">Productos vendidos</div>
      <div class="metric-value" data-metric="items" data-target="124">0</div>
    </div>
  </div>

  <div class="top-products">
    <h4 class="section-label">Más vendidos</h4>
    <div class="product-list">
      <div class="product-item" style="--item-delay: 0ms">
        <div class="product-info">
          <span class="product-name">Café espresso</span>
          <span class="product-count">28</span>
        </div>
        <div class="product-bar">
          <div class="product-bar-fill" data-progress="85"></div>
        </div>
      </div>
      <div class="product-item" style="--item-delay: 100ms">
        <div class="product-info">
          <span class="product-name">Pan con bistec</span>
          <span class="product-count">19</span>
        </div>
        <div class="product-bar">
          <div class="product-bar-fill" data-progress="62"></div>
        </div>
      </div>
      <div class="product-item" style="--item-delay: 200ms">
        <div class="product-info">
          <span class="product-name">Refresco lata</span>
          <span class="product-count">16</span>
        </div>
        <div class="product-bar">
          <div class="product-bar-fill" data-progress="50"></div>
        </div>
      </div>
      <div class="product-item" style="--item-delay: 300ms">
        <div class="product-info">
          <span class="product-name">Croquetas (3u)</span>
          <span class="product-count">12</span>
        </div>
        <div class="product-bar">
          <div class="product-bar-fill" data-progress="38"></div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Animate counters
  function animateCounter(element: HTMLElement, target: number, isRevenue: boolean = false) {
    const duration = prefersReducedMotion ? 0 : 1200;
    const currentValue = isRevenue 
      ? parseInt(element.textContent?.replace(/[$,]/g, '') || '0')
      : parseInt(element.textContent || '0');
    const startTime = performance.now();
    
    function update(currentTime: number) {
      const elapsed = currentTime - startTime;
      const progress = Math.min(elapsed / duration, 1);
      
      // Ease out expo
      const easeProgress = progress === 1 ? 1 : 1 - Math.pow(2, -10 * progress);
      
      const current = Math.floor(currentValue + (target - currentValue) * easeProgress);
      element.textContent = isRevenue ? `$${current.toLocaleString()}` : current.toString();
      
      if (progress < 1) {
        requestAnimationFrame(update);
      }
    }
    
    requestAnimationFrame(update);
  }

  // Animate progress bars
  function animateBar(bar: HTMLElement, targetPercent: number, delay: number = 0) {
    if (prefersReducedMotion) {
      bar.style.width = `${targetPercent}%`;
      return;
    }

    setTimeout(() => {
      bar.style.width = `${targetPercent}%`;
    }, delay);
  }

  // Initialize animations when dashboard enters viewport
  function initDashboard() {
    const dashboard = document.querySelector('.live-dashboard');
    if (!dashboard) return;

    let hasAnimated = false;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting && !hasAnimated) {
            hasAnimated = true;
            
            // Animate metrics
            const metrics = dashboard.querySelectorAll('[data-metric]');
            metrics.forEach((metric) => {
              const target = parseInt(metric.getAttribute('data-target') || '0');
              const type = metric.getAttribute('data-metric');
              const isRevenue = type === 'revenue';
              animateCounter(metric as HTMLElement, target, isRevenue);
            });

            // Animate bars with stagger
            const bars = dashboard.querySelectorAll('.product-bar-fill');
            bars.forEach((bar, index) => {
              const progress = parseInt(bar.getAttribute('data-progress') || '0');
              const delay = prefersReducedMotion ? 0 : 400 + (index * 100);
              animateBar(bar as HTMLElement, progress, delay);
            });

            // Start live updates after initial animation
            setTimeout(() => startLiveUpdates(), 2000);
            
            observer.disconnect();
          }
        });
      },
      { threshold: 0.2 }
    );

    observer.observe(dashboard);
  }

  // Update metrics periodically (simulate new sales)
  function startLiveUpdates() {
    if (prefersReducedMotion) return;

    const dashboard = document.querySelector('.live-dashboard');
    if (!dashboard) return;

    const salesMetric = dashboard.querySelector('[data-metric="sales"]') as HTMLElement;
    const revenueMetric = dashboard.querySelector('[data-metric="revenue"]') as HTMLElement;
    const itemsMetric = dashboard.querySelector('[data-metric="items"]') as HTMLElement;

    if (!salesMetric || !revenueMetric || !itemsMetric) return;

    setInterval(() => {
      // Random increment (1-3 sales)
      const increment = Math.floor(Math.random() * 3) + 1;
      const currentSales = parseInt(salesMetric.textContent || '0');
      const currentRevenue = parseInt(revenueMetric.textContent?.replace(/[$,]/g, '') || '0');
      const currentItems = parseInt(itemsMetric.textContent || '0');

      const newSales = currentSales + increment;
      const newRevenue = currentRevenue + increment * (Math.floor(Math.random() * 50) + 30);
      const newItems = currentItems + increment * (Math.floor(Math.random() * 3) + 1);

      // Update with smooth animation
      animateCounter(salesMetric, newSales);
      animateCounter(revenueMetric, newRevenue, true);
      animateCounter(itemsMetric, newItems);
    }, 4500); // Update every 4.5 seconds
  }

  // Initialize
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initDashboard);
  } else {
    initDashboard();
  }
</script>

<style>
  .live-dashboard {
    background: var(--surface);
    border-radius: var(--rounded-lg);
    padding: clamp(var(--space-lg), 4vw, var(--space-2xl));
    box-shadow: var(--shadow-subtle);
    width: 100%;
    max-width: 400px;
    margin: 0 auto;
  }

  .dashboard-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-xl);
  }

  .dashboard-title {
    font-size: var(--fs-title);
    font-weight: 700;
    color: var(--ink);
    margin: 0;
  }

  .offline-badge {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    background: var(--success);
    color: #FFFFFF;
    border-radius: var(--rounded-pill);
    font-size: var(--fs-caption);
    font-weight: 600;
    letter-spacing: 0.05em;
  }

  .offline-icon {
    width: 14px;
    height: 14px;
  }

  @media (prefers-reduced-motion: no-preference) {
    .offline-badge {
      animation: pulse-badge 2s ease-in-out infinite;
    }
  }

  @keyframes pulse-badge {
    0%, 100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.85;
      transform: scale(0.98);
    }
  }

  .metrics-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-md);
    margin-bottom: var(--space-2xl);
  }

  .metric-card {
    text-align: center;
  }

  .metric-label {
    font-size: var(--fs-caption);
    font-weight: 500;
    color: var(--ink-secondary);
    margin-bottom: 6px;
    line-height: 1.2;
  }

  .metric-value {
    font-size: var(--fs-stat);
    font-weight: 800;
    color: var(--primary);
    line-height: 1;
    font-feature-settings: 'tnum' 1;
    min-height: 2rem;
  }

  .top-products {
    border-top: 1px solid var(--line);
    padding-top: var(--space-lg);
  }

  .section-label {
    font-size: var(--fs-label);
    font-weight: 600;
    color: var(--ink-secondary);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin: 0 0 var(--space-md) 0;
  }

  .product-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .product-item {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  @media (prefers-reduced-motion: no-preference) {
    .product-item {
      opacity: 0;
      animation: item-in 400ms var(--ease-out-expo) both;
      animation-delay: var(--item-delay);
    }
  }

  @keyframes item-in {
    from {
      opacity: 0;
      transform: translateY(4px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .product-info {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-sm);
  }

  .product-name {
    font-size: var(--fs-small);
    font-weight: 500;
    color: var(--ink);
    flex: 1;
  }

  .product-count {
    font-size: var(--fs-small);
    font-weight: 700;
    color: var(--ink-secondary);
    font-feature-settings: 'tnum' 1;
  }

  .product-bar {
    height: 6px;
    background: var(--surface-secondary);
    border-radius: var(--rounded-pill);
    overflow: hidden;
  }

  .product-bar-fill {
    height: 100%;
    background: linear-gradient(90deg, var(--primary) 0%, var(--primary-light) 100%);
    width: 0;
    border-radius: var(--rounded-pill);
  }

  @media (prefers-reduced-motion: no-preference) {
    .product-bar-fill {
      transition: width 800ms var(--ease-out-expo);
    }
  }

  /* Responsive adjustments */
  @media (max-width: 374px) {
    .metrics-grid {
      gap: var(--space-sm);
    }

    .metric-value {
      font-size: clamp(1.5rem, 5vw, 2rem);
    }

    .metric-label {
      font-size: 0.6875rem;
    }
  }

  @media (min-width: 640px) {
    .live-dashboard {
      max-width: 420px;
    }
  }

  /* Dark mode support */
  @media (prefers-color-scheme: dark) {
    .live-dashboard {
      background: var(--dark-surface, var(--surface));
    }

    .dashboard-title {
      color: var(--dark-ink, var(--ink));
    }

    .metric-label {
      color: var(--dark-ink-secondary, var(--ink-secondary));
    }

    .metric-value {
      color: var(--primary-light);
    }

    .section-label {
      color: var(--dark-ink-secondary, var(--ink-secondary));
    }

    .product-name {
      color: var(--dark-ink, var(--ink));
    }

    .product-count {
      color: var(--dark-ink-secondary, var(--ink-secondary));
    }

    .product-bar {
      background: var(--dark-elevated, var(--surface-secondary));
    }

    .top-products {
      border-top-color: var(--dark-line, var(--line));
    }
  }
</style>
