---
interface ProblemaItem {
  icon: string;
  title: string;
  description: string;
}

const problemas: ProblemaItem[] = [
  {
    icon: 'lightning',
    title: 'Apagones y señal inestable.',
    description: 'Los sistemas web se caen y la tienda queda vendiendo "a papel".'
  },
  {
    icon: 'table',
    title: 'La libreta y el Excel.',
    description: 'Nunca sabes qué se agotó ni cuánto se vendió hoy.'
  },
  {
    icon: 'money',
    title: 'El faltante en la caja.',
    description: 'El cuadre se hace a mano y los números no te cuadran.'
  }
];

const icons = {
  lightning: 'M13 2L3 14h9l-1 8 10-12h-9l1-8z',
  table: 'M3 3h18v18H3V3zm0 6h18M9 21V9',
  money: 'M20 12V8H6a2 2 0 0 1-2-2c0-1.1.9-2 2-2h12v4M4 6v12c0 1.1.9 2 2 2h14v-4M18 12a2 2 0 0 0-2 2c0 1.1.9 2 2 2h4v-4h-4z'
};
---

<script is:inline>
  (() => {
    if (!('IntersectionObserver' in window)) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const root = document.documentElement;
    // Estado inicial oculto ANTES de que la sección se pinte.
    root.classList.add('js-reveal');

    const arm = () => {
      const targets = document.querySelectorAll(
        '#problema .problema-card, #problema .problema-cierre'
      );
      if (!targets.length) {
        // Failsafe: jamás dejar contenido invisible.
        root.classList.remove('js-reveal');
        return;
      }
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add('is-in');
            io.unobserve(entry.target);
          });
        },
        { threshold: 0, rootMargin: '0px 0px -12% 0px' }
      );
      targets.forEach((t) => io.observe(t));
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', arm, { once: true });
    } else {
      arm();
    }
  })();
</script>

<section id="problema" class="problema dark-band">
  <div class="container">
    <h2>El día a día de tu negocio no espera por el internet.</h2>

    <div class="problema-grid">
      {problemas.map(problema => (
        <div class="problema-card">
          <div class="problema-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d={icons[problema.icon as keyof typeof icons]} />
            </svg>
          </div>
          <h3>{problema.title}</h3>
          <p>{problema.description}</p>
        </div>
      ))}
    </div>

    <p class="problema-cierre">
      <svg class="check-offline" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <polyline points="20 6 9 17 4 12"></polyline>
      </svg>
      MiPyUtil guarda tus datos en el propio teléfono. Si se cae la conexión, sigues vendiendo igual.
    </p>
  </div>
</section>

<style>
  .dark-band {
    color: var(--ink);
    position: relative;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  @media (prefers-reduced-motion: no-preference) {
    /* Estado inicial: solo cuando el script inline confirmó JS + motion */
    :global(html.js-reveal) .problema-card,
    :global(html.js-reveal) .problema-cierre {
      opacity: 0;
      transform: translateY(12px);
    }

    :global(html.js-reveal) .problema-card.is-in,
    :global(html.js-reveal) .problema-cierre.is-in {
      animation: rise-in 500ms var(--ease-out-expo) forwards;
    }

    /* En desktop las tres tarjetas comparten fila: escalonar para que se lea */
    @media (min-width: 48rem) {
      :global(html.js-reveal) .problema-card:nth-child(2).is-in {
        animation-delay: 80ms;
      }
      :global(html.js-reveal) .problema-card:nth-child(3).is-in {
        animation-delay: 160ms;
      }
    }
  }

  @keyframes rise-in {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .dark-band h2,
  .dark-band h3,
  .dark-band p {
    color: var(--ink);
  }

  .problema h2 {
    margin-bottom: clamp(var(--space-lg), 5vw, var(--space-xl));
    font-size: clamp(var(--fs-title), 4vw, var(--fs-headline));
  }

  .problema-grid {
    display: grid;
    gap: clamp(var(--space-md), 4vw, var(--space-lg));
    margin-bottom: clamp(var(--space-lg), 5vw, var(--space-xl));
  }

  .problema-card {
    background: var(--surface);
    padding: clamp(var(--space-lg), 5vw, var(--space-xl));
    border-radius: var(--radius-lg);
    border: 1px solid var(--line);
    transition: border-color 200ms ease;
  }
  
  .problema-card:hover {
    border-color: var(--primary-light);
  }

  .problema-icon {
    width: clamp(40px, 10vw, 48px);
    height: clamp(40px, 10vw, 48px);
    margin-bottom: clamp(var(--space-md), 4vw, var(--space-lg));
    color: var(--primary-light);
  }

  .problema-icon svg {
    width: 100%;
    height: 100%;
  }

  .problema-card h3 {
    margin-bottom: clamp(var(--space-sm), 3vw, var(--space-md));
    color: var(--ink);
    font-size: clamp(var(--fs-title), 2.5vw, var(--fs-xl));
  }
  
  .problema-card p {
    color: var(--ink-secondary);
    font-size: clamp(0.9375rem, 2.5vw, var(--fs-body));
    line-height: 1.6;
  }

  .problema-cierre {
    font-size: clamp(var(--fs-body), 2.5vw, var(--fs-lead));
    font-weight: 500;
    line-height: var(--lh-lead);
    text-align: center;
    max-width: 60ch;
    margin: 0 auto;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    gap: clamp(var(--space-sm), 3vw, var(--space-md));
    padding: clamp(var(--space-md), 4vw, var(--space-lg));
    background: var(--primary-subtle);
    border-radius: var(--radius-lg);
    border: 1px solid var(--primary-light);
    flex-wrap: wrap;
  }

  .check-offline {
    width: clamp(20px, 5vw, 24px);
    height: clamp(20px, 5vw, 24px);
    flex-shrink: 0;
    color: var(--primary-light);
    margin-top: 2px;
  }

  @media (min-width: 40rem) {
    .problema-grid {
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    }

    .problema-cierre {
      flex-wrap: nowrap;
      align-items: center;
    }

    .check-offline {
      margin-top: 0;
    }
  }

  @media (min-width: 48rem) {
    .problema-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
