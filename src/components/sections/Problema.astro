---
interface Row {
  label: string;
  libreta: string;
  excel: string;
  app: string;
}

const rows: Row[] = [
  { label: 'Funciona en apagón', libreta: 'Sí', excel: 'No', app: 'Sí' },
  { label: 'Avisa cuando el inventario se acaba', libreta: 'No', excel: 'No', app: 'Automática' },
  { label: 'Cuadre de caja', libreta: 'A mano', excel: 'A mano', app: 'Automático' },
  { label: 'Un sistema para dueño y equipo', libreta: 'Cada uno la suya', excel: 'Uno a la vez', app: 'Multiusuario' },
  { label: 'Ganancias vs. mes anterior', libreta: 'No', excel: 'A mano', app: 'Automático' }
];

const comparisonLabel = 'Comparación entre llevar el negocio a mano, en Excel o con MiPyUtil';
---

<section id="problema" class="problema dark-band">
  <div class="container">
    <h2>El día a día de tu negocio no espera por el internet.</h2>

    <div class="plate-panel compare-plate">
      <span class="screw screw--tl" aria-hidden="true"></span>
      <span class="screw screw--tr" aria-hidden="true"></span>
      <span class="screw screw--bl" aria-hidden="true"></span>
      <span class="screw screw--br" aria-hidden="true"></span>

      {/* Móvil (<40rem): una capacidad por bloque, con los tres veredictos
          nombrados dentro del propio bloque. La tabla de 4 columnas no cabe
          por debajo de ~640px sin truncar valores como "Multiusuario". */}
      <ul class="compare-stack" aria-label={comparisonLabel}>
        {rows.map(row => (
          <li class="compare-item">
            <p class="compare-item__capability">{row.label}</p>
            <dl class="compare-item__verdicts">
              <div class="compare-verdict">
                <dt>Libreta</dt>
                <dd>{row.libreta}</dd>
              </div>
              <div class="compare-verdict">
                <dt>Excel</dt>
                <dd>{row.excel}</dd>
              </div>
              <div class="compare-verdict compare-verdict--winner">
                <dt>MiPyUtil</dt>
                <dd>{row.app}</dd>
              </div>
            </dl>
          </li>
        ))}
      </ul>

      {/* ≥40rem: la tabla real, donde las cuatro columnas sí caben. */}
      <table class="compare-table">
        <caption class="sr-only">{comparisonLabel}</caption>
        <colgroup>
          <col class="compare-col-label" />
          <col class="compare-col-data" />
          <col class="compare-col-data" />
          <col class="compare-col-app" />
        </colgroup>
        <thead>
          <tr>
            <th scope="col"><span class="sr-only">Capacidad</span></th>
            <th scope="col" class="compare-col-data">Libreta</th>
            <th scope="col" class="compare-col-data">Excel</th>
            <th scope="col" class="compare-col-winner">MiPyUtil</th>
          </tr>
        </thead>
        <tbody>
          {rows.map(row => (
            <tr>
              <th scope="row">{row.label}</th>
              <td class="compare-col-data">{row.libreta}</td>
              <td class="compare-col-data">{row.excel}</td>
              <td class="compare-col-winner">{row.app}</td>
            </tr>
          ))}
        </tbody>
      </table>

      <div class="compare-estimate">
        <p class="compare-estimate__tag">Estimado</p>
        <p class="compare-estimate__figures">
          <span class="compare-estimate__num">≈20 min</span>
          <svg class="compare-estimate__arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
          <span class="compare-estimate__num compare-estimate__num--after">menos de 2 min</span>
        </p>
        <p class="compare-estimate__caption">
          Lo que puede tardar un cuadre a mano, comparado con aprobarlo ya calculado en MiPyUtil.
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .problema {
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .problema h2 {
    margin-bottom: clamp(var(--space-xl), 5vw, var(--space-2xl));
    font-size: clamp(var(--fs-title), 4vw, var(--fs-headline));
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .compare-plate {
    background: var(--plate);
    padding: clamp(var(--space-md), 4vw, var(--space-lg));
  }

  /* === MÓVIL: una capacidad por bloque ===
     Fusionar "Libreta" y "Excel" perdería una distinción real (la libreta
     funciona en el apagón, Excel no), así que los tres veredictos siguen
     presentes; lo que cambia es la dirección de lectura: la capacidad manda
     la línea y debajo van sus tres respuestas. Cada veredicto lleva su
     fuente escrita al lado, no en una cabecera lejana que se pierde al
     desplazarse. */
  .compare-stack {
    list-style: none;
  }

  .compare-item {
    padding: var(--space-md) 0;
    border-bottom: 1px solid var(--line);
  }

  .compare-item:first-child {
    padding-top: 0;
  }

  .compare-item:last-child {
    border-bottom: none;
  }

  .compare-item__capability {
    margin-bottom: var(--space-xs);
    font-size: var(--fs-title);
    font-weight: 700;
    line-height: var(--lh-title);
    color: var(--ink);
  }

  /* Las tres fuentes se apilan en una sola columna: fuente a la izquierda,
     veredicto a la derecha. Así los tres veredictos comparten borde derecho
     y se comparan de arriba abajo, en vez de repartirse entre una rejilla de
     dos columnas y una barra suelta con tres bordes izquierdos distintos. */
  .compare-item__verdicts {
    display: flex;
    flex-direction: column;
  }

  .compare-verdict {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-md);
    min-width: 0;
    padding: 7px 0;
  }

  .compare-verdict dt {
    flex-shrink: 0;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--ink-muted);
  }

  .compare-verdict dd {
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.35;
    color: var(--ink-muted);
    text-align: right;
    overflow-wrap: break-word;
  }

  /* Misma lógica que la columna ganadora de la tabla: lavado suave del
     acento sobre la placa, nunca relleno sólido, para no meter un segundo
     acento saturado. Sin borde de color: la diferencia la hacen el lavado,
     el peso y el tamaño. El sangrado de 10px deja el lavado más ancho que
     el texto sin romper la alineación de las tres filas. */
  .compare-verdict--winner {
    margin: 2px -10px 0;
    padding: 8px 10px;
    background: color-mix(in srgb, var(--accent) 16%, var(--plate));
    border-radius: var(--radius-sm);
  }

  /* accent-deep, no accent: sobre este lavado el acento plano no alcanza
     4.5:1 en el tema claro. */
  .compare-verdict--winner dt {
    font-weight: 700;
    color: var(--accent-deep);
  }

  .compare-verdict--winner dd {
    font-size: 1rem;
    font-weight: 800;
    color: var(--ink);
  }

  /* === ≥40rem: la tabla === */
  .compare-table {
    display: none;
    width: 100%;
    table-layout: fixed;
    border-collapse: collapse;
  }

  .compare-table th,
  .compare-table td {
    text-align: left;
    padding: clamp(12px, 2.5vw, var(--space-md)) clamp(10px, 2vw, var(--space-md));
    font-size: clamp(0.875rem, 2vw, var(--fs-body));
  }

  /* Las tres columnas de datos (Libreta/Excel/MiPyUtil) centradas: son
     valores cortos que se comparan de un vistazo, no prosa. La columna de
     capacidades se queda a la izquierda porque es una etiqueta, no un dato. */
  .compare-table th.compare-col-data,
  .compare-table td.compare-col-data,
  .compare-table th.compare-col-winner,
  .compare-table td.compare-col-winner {
    text-align: center;
  }

  /* Encabezado en tono "placa remachada": una franja de board-panel, un
     tono más recesado que el cuerpo en plate, como una placa aparte
     atornillada sobre el panel. */
  .compare-table thead th {
    background: var(--board-panel);
    padding-top: clamp(var(--space-md), 3vw, var(--space-lg));
    padding-bottom: clamp(var(--space-md), 3vw, var(--space-lg));
    font-size: var(--fs-title);
    font-weight: 700;
    letter-spacing: 0.01em;
    color: var(--ink-muted);
    border-bottom: 1px solid var(--line-strong);
  }

  .compare-table tbody th {
    font-weight: 700;
    color: var(--ink);
  }

  .compare-table tbody td {
    color: var(--ink-muted);
    font-weight: 600;
  }

  .compare-table tbody tr {
    border-bottom: 1px solid var(--line);
  }

  .compare-table tbody tr:last-child {
    border-bottom: none;
  }

  /* Columna ganadora: un lavado suave del acento sobre la placa (mismo
     patrón que Offline Badge), nunca relleno sólido. El texto del cuerpo se
     queda en --ink, no en --accent: --accent sobre este lavado no alcanza
     4.5:1 en el tema claro. */
  .compare-table tbody td.compare-col-winner {
    background: color-mix(in srgb, var(--accent) 16%, var(--plate));
    color: var(--ink);
    font-weight: 800;
  }

  /* La cabecera ganadora no lleva el mismo lavado: mezclado sobre
     board-panel (más oscuro que plate) el contraste de --accent-deep cae
     por debajo de 4.5:1. La barra superior sólida ya marca la columna sin
     necesitar ese relleno. */
  .compare-table thead th.compare-col-winner {
    color: var(--accent-deep);
    border-top: 2px solid var(--accent);
  }

  /* Mismo ritmo vertical que el espacio entre filas de la tabla, para que
     esta franja no se sienta más separada de la última fila que las filas
     entre sí. */
  .compare-estimate {
    padding-top: clamp(12px, 2.5vw, var(--space-md));
    border-top: 1px solid var(--line);
  }

  /* La Regla de la Placa Honesta un nivel más arriba: una cifra ilustrativa
     se etiqueta como estimada en la propia UI, no solo en el copy de al lado. */
  .compare-estimate__tag {
    display: inline-block;
    margin-bottom: var(--space-sm);
    padding: 3px 8px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-sm);
    font-size: var(--fs-caption);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .compare-estimate__figures {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: clamp(var(--space-sm), 3vw, var(--space-lg));
    flex-wrap: wrap;
  }

  .compare-estimate__num {
    font-size: clamp(1.75rem, 5vw + 0.3rem, 2.5rem);
    font-weight: 800;
    letter-spacing: -0.01em;
    color: var(--ink-muted);
  }

  .compare-estimate__num--after {
    color: var(--ink);
  }

  .compare-estimate__arrow {
    width: clamp(18px, 3vw, 28px);
    height: clamp(18px, 3vw, 28px);
    flex-shrink: 0;
    color: var(--accent);
  }

  .compare-estimate__caption {
    margin-top: var(--space-sm);
    font-size: var(--fs-small);
    color: var(--ink-muted);
  }

  @media (min-width: 40rem) {
    .compare-stack {
      display: none;
    }

    .compare-table {
      display: table;
    }

    .compare-col-label {
      width: 36%;
    }

    .compare-col-data {
      width: 21%;
    }

    .compare-col-app {
      width: 22%;
    }
  }
</style>
