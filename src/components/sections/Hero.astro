---
import Button from '../ui/Button.astro';
import PhoneMockup from '../PhoneMockup.astro';

const words = ['Revoluciona', 'Gestiona', 'Optimiza', 'Controla', 'Perfecciona'];
---

<section id="hero" class="hero veta veta--a">
  <div class="container hero-grid">
    <div class="hero-copy">
      <h1>
        <span class="sr-only">Gestiona tu MiPyME.</span>
        <span aria-hidden="true">
          <span class="title-line">
            <span class="rotating-word" data-words={JSON.stringify(words)}>{words[0]}</span>
          </span>
          <span class="title-line">tu MiPyME.</span>
        </span>
      </h1>

      <p class="lead">
        MiPyUtil le da a cada dependiente su propia app para vender y cerrar
        turno, y a ti la tuya para controlar ventas, ingresos e inventario.{' '}
        <strong>Todo funciona sin internet.</strong>
      </p>

      <div class="cta-group">
        <Button variant="primary" type="link" href="#descarga" icon="download" stamp fullWidth>
          Descargar MiPyUtil
        </Button>
        <div class="secondary-ctas">
          <Button
            variant="secondary"
            type="link"
            href="https://wa.me/5353770707?text=Hola,%20me%20gustar%C3%ADa%20obtener%20m%C3%A1s%20informaci%C3%B3n%20sobre%20la%20app%20MiPyUtil"
            icon="whatsapp"
            target="_blank"
            fullWidth
          >
            WhatsApp
          </Button>
          <Button variant="secondary" type="link" href="https://t.me/MipyUtil" icon="telegram" target="_blank" fullWidth>
            Telegram
          </Button>
        </div>
        <p class="fine">Plan gratuito para siempre. Android 8+ y Windows, sin Play Store.</p>
      </div>
    </div>

    <figure class="hero-stage">
      <div class="stage-phones">
        <div class="stage-phone">
          <span class="role">Tu app</span>
          <PhoneMockup
            screen="resumen"
            time="11:50"
            alt="Pantalla Resumen del dueño: lo vendido este mes, cómo entró, la cuenta, la caja y los avisos del tablón (datos de ejemplo)"
            compact
            peek
          />
        </div>
        <div class="stage-phone stage-phone--team">
          <span class="role">La de tu equipo</span>
          <PhoneMockup
            screen="mi-turno"
            time="11:50"
            alt="Pantalla Mi turno de un dependiente: el dinero del turno y sus últimas ventas (datos de ejemplo)"
            compact
            peek
          />
        </div>
      </div>
      <figcaption>Pantallas de ejemplo con datos ficticios.</figcaption>
    </figure>
  </div>
</section>

<script>
  // Palabra rotativa del titular. Se detiene fuera de pantalla y con la pestaña oculta.
  const rotatingWord = document.querySelector<HTMLElement>('.rotating-word');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (rotatingWord && !reduceMotion) {
    const words: string[] = JSON.parse(rotatingWord.dataset.words || '[]');
    let index = 0;
    let timer: ReturnType<typeof setInterval> | null = null;
    let visible = true;

    const next = () => {
      rotatingWord.classList.add('word-exit');
      setTimeout(() => {
        index = (index + 1) % words.length;
        rotatingWord.textContent = words[index];
        rotatingWord.classList.remove('word-exit');
        rotatingWord.classList.add('word-enter');
        setTimeout(() => rotatingWord.classList.remove('word-enter'), 280);
      }, 180);
    };

    const sync = () => {
      const shouldRun = visible && !document.hidden;
      if (shouldRun && !timer) timer = setInterval(next, 3200);
      if (!shouldRun && timer) {
        clearInterval(timer);
        timer = null;
      }
    };

    new IntersectionObserver(
      (entries) => {
        visible = entries.some((entry) => entry.isIntersecting);
        sync();
      },
      { threshold: 0.1 }
    ).observe(rotatingWord);

    document.addEventListener('visibilitychange', sync);
  }
</script>

<style>
  .hero {
    padding-top: clamp(var(--space-lg), 5vw, 56px);
    padding-bottom: clamp(var(--space-xl), 6vw, var(--space-3xl));
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    row-gap: var(--space-xl);
  }

  .hero-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    min-width: 0;
  }

  .hero h1 {
    max-width: 20ch;
    margin-bottom: clamp(var(--space-md), 4vw, var(--space-lg));
    hyphens: auto;
  }

  .title-line {
    display: block;
    line-height: 1.05;
  }

  .title-line:first-child {
    margin-bottom: 0.05em;
  }

  /* === Palabra rotativa ===
     Salida corta y entrada con desenfoque suave: el desenfoque une las dos
     palabras en un solo movimiento en vez de dos objetos que se cruzan. */
  .rotating-word {
    display: inline-block;
    color: var(--accent);
  }

  @media (prefers-reduced-motion: no-preference) {
    .rotating-word {
      transition: transform 180ms var(--ease-out-expo), opacity 180ms ease-out, filter 180ms ease-out;
    }

    .rotating-word.word-exit {
      opacity: 0;
      filter: blur(2px);
      transform: translateY(-6px);
    }

    .rotating-word.word-enter {
      animation: word-in 280ms var(--ease-out-expo);
    }
  }

  @keyframes word-in {
    from {
      opacity: 0;
      filter: blur(2px);
      transform: translateY(8px);
    }
  }

  .lead {
    max-width: 46ch;
    margin-bottom: var(--space-lg);
    font-size: clamp(var(--fs-body), 2.5vw, var(--fs-lead));
    line-height: var(--lh-lead);
    color: var(--ink-muted);
  }

  .lead strong {
    color: var(--ink);
  }

  /* El botón principal ocupa todo el ancho de la columna (igual que el párrafo
     de arriba) y manda sobre los dos contactos; la línea final comparte ese
     mismo ancho. Con un botón más angosto que el texto, la jerarquía se aplana. */
  .cta-group {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: var(--space-md);
    width: 100%;
  }

  .secondary-ctas {
    display: flex;
    gap: var(--space-md);
    width: 100%;
  }

  .secondary-ctas > :global(*) {
    flex: 1;
  }

  .fine {
    max-width: none;
    font-size: var(--fs-body);
    line-height: var(--lh-lead);
    color: var(--ink-muted);
  }

  /* === Escenario: dos teléfonos, dos roles ===
     El dueño y su equipo usan la misma app con otro rol. Se muestra eso, en
     vez de tarjetas de notificación flotando. */
  .hero-stage {
    min-width: 0;
  }

  .stage-phones {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-md);
    align-items: start;
    max-width: 30rem;
    margin-inline: auto;
  }

  .stage-phone {
    display: grid;
    gap: var(--space-sm);
    min-width: 0;
  }

  .stage-phone--team {
    margin-top: clamp(20px, 7vw, 48px);
  }

  /* .compact incluida a propósito: iguala la especificidad del tamaño del
     teléfono y gana sin depender del orden de las hojas de estilo. */
  .stage-phone :global(.phone-mockup.compact) {
    --phone-w: 100%;
  }

  .role {
    justify-self: start;
    padding: 2px 8px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-sm);
    background: var(--plate);
    font-size: var(--fs-caption);
    font-weight: 700;
    line-height: 1.5;
    color: var(--ink-muted);
  }

  .hero-stage figcaption {
    margin-top: var(--space-sm);
    font-size: var(--fs-caption);
    color: var(--ink-muted);
    text-align: center;
  }

  /* Entrada: un solo gesto escalonado, ease-out fuerte. Lo demás en la
     página no se anima solo. */
  @media (prefers-reduced-motion: no-preference) {
    .hero h1,
    .hero .lead,
    .hero .cta-group,
    .stage-phone {
      animation: hero-rise 420ms var(--ease-out-expo) both;
    }

    .hero h1 { animation-delay: 0ms; }
    .hero .lead { animation-delay: 50ms; }
    .hero .cta-group { animation-delay: 100ms; }
    .stage-phone { animation-delay: 120ms; }
    .stage-phone--team { animation-delay: 190ms; }
  }

  @keyframes hero-rise {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
  }

  /* Desde 48rem el teléfono se muestra entero y los dos textos comparten fila. */
  @media (min-width: 48rem) {
    .hero-grid {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
      column-gap: clamp(var(--space-xl), 5vw, var(--space-3xl));
      align-items: center;
    }

    .hero-stage :global(.phone-mockup.peek) {
      aspect-ratio: auto;
      overflow: visible;
      -webkit-mask-image: none;
      mask-image: none;
    }
  }

  @media (min-width: 80rem) {
    .hero-grid {
      column-gap: var(--space-section-sm);
    }
  }
</style>
