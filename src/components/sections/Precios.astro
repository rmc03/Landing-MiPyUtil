---
// src/components/sections/Precios.astro
// Precios como filas de un tablón: cada plan es una tarjeta con filas etiqueta/valor
// (precio, límites), el toggle de facturación es un control de dos placas (nunca una
// píldora deslizante).
//
// Los planes mensuales cuestan en USD y se pueden pagar en CUP al cambio de
// elTOQUE. La tasa la sirve la función pública `tasa-publica` de Supabase
// (ver supabase/functions/tasa-publica). El HTML ya trae los precios en USD;
// el script de abajo añade los montos en CUP cuando llega la tasa. Si la tasa
// no llega o está vieja, esos montos desaparecen y se manda a WhatsApp.
//
// Mensual y anual viven los dos en el HTML; el toggle solo cambia
// `data-billing` en la sección y el CSS muestra uno u otro.
import Button from '../ui/Button.astro';

const plans = [
  {
    name: 'Gratuito',
    monthlyPrice: null,
    monthlyIntro: null,
    annualPrice: null,
    recommended: false,
    free: true,
    limits: [
      { label: 'Productos', value: '30' },
      { label: 'Dependientes', value: '3' },
      { label: 'Administradores', value: '1' }
    ],
    features: []
  },
  {
    name: 'Básico',
    monthlyPrice: '2',
    monthlyIntro: '1',
    annualPrice: '15',
    recommended: false,
    free: false,
    limits: [
      { label: 'Productos', value: '75' },
      { label: 'Dependientes', value: '3' },
      { label: 'Administradores', value: '2' }
    ],
    features: []
  },
  {
    name: 'Negocio',
    monthlyPrice: '3',
    monthlyIntro: '2',
    annualPrice: '20',
    recommended: true,
    free: false,
    limits: [
      { label: 'Productos', value: '150' },
      { label: 'Dependientes', value: '5' },
      { label: 'Administradores', value: '3' }
    ],
    features: []
  },
  {
    name: 'Pro',
    monthlyPrice: '4',
    monthlyIntro: '3',
    annualPrice: '30',
    recommended: false,
    free: false,
    limits: [
      { label: 'Productos', value: '300' },
      { label: 'Dependientes', value: '8' },
      { label: 'Administradores', value: '4' }
    ],
    features: ['Atención prioritaria.']
  }
];

const WHATSAPP_NUMBER = '5353770707';

// Función pública de Supabase (solo lectura): devuelve el dólar de elTOQUE y su antigüedad.
const TASA_URL =
  import.meta.env.PUBLIC_TASA_URL ?? 'https://sqnrvtwrvgxszkxuuyjb.supabase.co/functions/v1/tasa-publica';
// Pasadas estas horas sin actualizarse, la landing oculta los montos en CUP.
const HORAS_TASA_VIEJA = 24;

const pasos = [
  { titulo: 'Elige tu plan', texto: 'Se abre WhatsApp con el plan ya escrito.' },
  { titulo: 'Te confirmamos el monto', texto: 'En CUP y con la tasa de hoy, antes de que transfieras.' },
  { titulo: 'Transfieres y te activamos', texto: 'Pagas por Transfermóvil o EnZona y subimos tu plan.' }
];

const mensajeMensual = (nombre: string, intro: string | null, precio: string | null) =>
  `Hola, me interesa el plan mensual ${nombre} de la app MiPyUtil. Vi $${intro} USD el primer mes y $${precio} USD al mes después.`;
---

<section
  id="precios"
  class="precios-section"
  data-billing="monthly"
  data-tasa-estado="cargando"
  data-tasa-url={TASA_URL}
  data-tasa-max-horas={HORAS_TASA_VIEJA}
  data-whatsapp={WHATSAPP_NUMBER}
>
  <noscript><style is:inline>.cup-hoy, .tasa-cargando { display: none; }</style></noscript>
  <div class="container">
    <div class="section-header">
      <h2>Elige tu plan</h2>
      <p class="subtitle">Empieza gratis. Mejora cuando lo necesites. Despliegue inmediato, acceso total a inventario y soporte directo.</p>
    </div>

    <div class="controles">
      <div class="billing-toggle" role="group" aria-label="Frecuencia de pago">
        <button type="button" class="billing-option" data-billing="monthly" aria-pressed="true">Mensual</button>
        <button type="button" class="billing-option" data-billing="annual" aria-pressed="false">
          Anual
          <span class="save-chip">Grandes descuentos</span>
        </button>
      </div>

      <p class="tasa-nota solo-mensual" aria-live="polite">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="tasa-icono" aria-hidden="true"><path d="M4 8h15l-4-4"/><path d="M20 16H5l4 4"/></svg>
        <span class="tasa-textos">
          <span class="tasa-cargando">Consultando la tasa de hoy…</span>
          <span class="tasa-lista">Pagas en CUP al cambio de elTOQUE: <strong class="tasa-cifra">1 USD = <span class="tasa-valor"></span> CUP</strong>, actualizada <time class="tasa-hora"></time></span>
          <span class="tasa-sin">Pagas en CUP al cambio del día. Te damos la tasa por WhatsApp.</span>
        </span>
      </p>
    </div>

    <div class="pricing-grid">
      {plans.map((plan) => (
        <article class:list={['pricing-card', { recommended: plan.recommended }]}>
          <div class="card-header">
            <h3 class="plan-name">{plan.name}</h3>
            {plan.recommended && <span class="badge">Recomendado</span>}
          </div>

          {plan.free ? (
            <div class="card-price">
              <div class="fila fila--intro">
                <span class="fila-etiqueta">Para siempre</span>
                <div class="fila-valores">
                  <strong class="usd-monto">Gratis</strong>
                </div>
              </div>
              <p class="pago-tag">Sin tarjeta ni transferencia</p>
            </div>
          ) : (
            <div class="card-price">
              <div class="solo-mensual">
                <div class="fila fila--intro">
                  <span class="fila-etiqueta">1.<sup>er</sup> mes</span>
                  <div class="fila-valores">
                    <span class="usd"><strong class="usd-monto">${plan.monthlyIntro}</strong><span class="usd-unidad">USD</span></span>
                    <span class="cup-hoy" data-usd={plan.monthlyIntro}>≈ <span class="cup-num"></span> CUP</span>
                  </div>
                </div>
                <div class="fila">
                  <span class="fila-etiqueta">Luego, cada mes</span>
                  <div class="fila-valores">
                    <span class="usd"><strong class="usd-monto">${plan.monthlyPrice}</strong><span class="usd-unidad">USD</span></span>
                    <span class="cup-hoy" data-usd={plan.monthlyPrice}>≈ <span class="cup-num"></span> CUP</span>
                  </div>
                </div>
              </div>

              <div class="solo-anual">
                <div class="fila fila--intro">
                  <span class="fila-etiqueta">Un pago al año</span>
                  <div class="fila-valores">
                    <span class="usd"><strong class="usd-monto">${plan.annualPrice}</strong><span class="usd-unidad">USD / año</span></span>
                  </div>
                </div>
              </div>

              <p class="pago-tag">
                <span class="pago-opcion solo-mensual">
                  <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="pago-icono" aria-hidden="true"><path d="M4 8h15l-4-4"/><path d="M20 16H5l4 4"/></svg>
                  Transferencia CUP al cambio
                </span>
                <span class="pago-opcion solo-anual">
                  <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="pago-icono" aria-hidden="true"><rect width="20" height="14" x="2" y="5" rx="2"/><line x1="2" x2="22" y1="10" y2="10"/></svg>
                  Tarjeta Clásica (USD)
                </span>
              </p>
            </div>
          )}

          <dl class="card-limits">
            {plan.limits.map((limit) => (
              <div class="limit-row">
                <dt>{limit.label}</dt>
                <dd>{limit.value}</dd>
              </div>
            ))}
          </dl>

          {/* Siempre presente: cada tarjeta necesita las mismas 5 filas para el subgrid */}
          <div class:list={['card-features', { 'card-features--empty': plan.features.length === 0 }]}>
            {plan.features.length > 0 && (
              <ul>
                {plan.features.map((feature) => (
                  <li>
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="check-icon" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>
                    {feature}
                  </li>
                ))}
              </ul>
            )}
          </div>

          <div class="card-action">
            {plan.free ? (
              <Button
                variant="secondary"
                href="#descarga"
                icon="download"
                fullWidth
                class="plan-cta-btn"
              >
                Empezar gratis
              </Button>
            ) : (
              <Button
                variant={plan.recommended ? 'primary' : 'secondary'}
                href={`https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(mensajeMensual(plan.name, plan.monthlyIntro, plan.monthlyPrice))}`}
                icon="whatsapp"
                target="_blank"
                fullWidth
                class="plan-cta-btn"
                data-plan-name={plan.name}
                data-plan-intro={plan.monthlyIntro}
                data-plan-price={plan.monthlyPrice}
              >
                Elegir plan
              </Button>
            )}
          </div>
        </article>
      ))}
    </div>

    <div class="pasos solo-mensual">
      <h3 class="pasos-titulo">Así pagas en moneda nacional</h3>
      <ol class="pasos-lista">
        {pasos.map((paso, i) => (
          <li>
            <span class="paso-n">{i + 1}</span>
            <div>
              <strong>{paso.titulo}</strong>
              <p>{paso.texto}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>

    <p class="sr-only" id="precios-estado" aria-live="polite"></p>
  </div>
</section>

<style>
  .precios-section {
    padding: clamp(var(--space-2xl), 8vw, var(--space-section-lg)) 0;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  .section-header {
    margin-bottom: clamp(var(--space-lg), 5vw, var(--space-xl));
    max-width: 60ch;
  }

  .section-header h2 {
    margin-bottom: clamp(var(--space-xs), 2vw, var(--space-sm));
  }

  .subtitle {
    font-size: clamp(var(--fs-body), 2.5vw, var(--fs-lead));
    color: var(--ink-muted);
    line-height: 1.6;
  }

  /* Mensual y anual viven los dos en el HTML; `data-billing` de la sección decide cuál se ve */
  .precios-section[data-billing='monthly'] .solo-anual,
  .precios-section[data-billing='annual'] .solo-mensual {
    display: none;
  }

  /* === Controles: toggle de facturación + tasa del día === */
  .controles {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-md) var(--space-lg);
    margin-bottom: clamp(var(--space-lg), 5vw, var(--space-xl));
  }

  /* Toggle: dos placas, nunca una píldora */
  .billing-toggle {
    display: inline-flex;
    gap: 2px;
    background: var(--board-panel);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    padding: 3px;
    max-width: 100%;
    overflow-x: auto;
  }

  .billing-option {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: clamp(4px, 1vw, 8px);
    background: transparent;
    border: none;
    border-radius: var(--radius-sm);
    padding: clamp(9px, 2vw, 11px) clamp(14px, 3vw, 20px);
    min-height: 44px;
    font-family: var(--font-body);
    font-size: clamp(var(--fs-caption), 2vw, var(--fs-small));
    font-weight: 700;
    color: var(--ink-muted);
    cursor: pointer;
    white-space: nowrap;
    transition: background-color var(--dur-routine) ease, color var(--dur-routine) ease;
  }

  .billing-option[aria-pressed='true'] {
    background: var(--plate);
    color: var(--ink);
    box-shadow: var(--shadow-soft);
  }

  .billing-option:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .save-chip {
    display: inline-block;
    font-size: var(--fs-caption);
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--accent);
    background: var(--board);
    border-radius: var(--radius-sm);
    padding: 3px 8px;
    white-space: nowrap;
  }

  .billing-option[aria-pressed='true'] .save-chip {
    background: var(--accent);
    color: var(--accent-on);
  }

  /* Tasa del día: una línea de apoyo, no un cartel */
  .tasa-nota {
    display: flex;
    align-items: flex-start;
    gap: var(--space-sm);
    min-height: 1.6em;
    max-width: 46ch;
    font-size: var(--fs-small);
    line-height: 1.45;
    color: var(--ink-muted);
    font-variant-numeric: tabular-nums;
  }

  .tasa-icono {
    flex-shrink: 0;
    margin-top: 2px;
    color: var(--accent);
  }

  /* La ecuación y la hora no se parten entre líneas */
  .tasa-nota strong {
    color: var(--ink);
    font-weight: 800;
    white-space: nowrap;
  }

  .tasa-hora {
    white-space: nowrap;
  }

  /* Un solo texto visible según el estado de la consulta de la tasa */
  .tasa-cargando,
  .tasa-lista,
  .tasa-sin {
    display: none;
  }

  .precios-section[data-tasa-estado='cargando'] .tasa-cargando,
  .precios-section[data-tasa-estado='listo'] .tasa-lista,
  .precios-section[data-tasa-estado='sin-tasa'] .tasa-sin {
    display: inline;
  }

  /* === Tarjetas === */
  .pricing-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(var(--space-md), 4vw, var(--space-lg));
    transition: opacity var(--dur-feedback) ease;
  }

  .pricing-grid.cambiando {
    opacity: 0;
  }

  .pricing-card {
    position: relative;
    background: var(--plate);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: clamp(18px, 5vw, var(--space-lg));
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .pricing-card.recommended {
    border-color: var(--accent);
    box-shadow: var(--shadow-stamp);
  }

  .badge {
    position: absolute;
    top: 0;
    left: clamp(18px, 5vw, var(--space-lg));
    transform: translateY(-50%);
    display: inline-block;
    background: var(--accent);
    color: var(--accent-on);
    font-size: var(--fs-caption);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 4px 10px;
    border-radius: var(--radius-sm);
    white-space: nowrap;
  }

  .card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
    margin-bottom: var(--space-md);
  }

  .plan-name {
    font-size: clamp(var(--fs-title), 2.5vw, 1.375rem);
    font-weight: 700;
    color: var(--ink);
  }

  /* === Precio: filas de tablón (etiqueta arriba, USD a la izquierda, CUP a la derecha) === */
  .card-price {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    margin-bottom: var(--space-lg);
    min-width: 0;
  }

  .fila {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .fila + .fila {
    margin-top: var(--space-md);
    padding-top: var(--space-md);
    border-top: 1px dashed var(--line-strong);
  }

  .fila-etiqueta {
    font-size: var(--fs-label);
    font-weight: 700;
    line-height: 1.3;
    color: var(--ink-muted);
  }

  .fila--intro .fila-etiqueta {
    color: var(--accent);
  }

  /* En celular y tablet el CUP va pegado al USD: la tarjeta es ancha y, empujado al borde,
     el cambio se separaba del precio que explica. En escritorio se alinea a la derecha (ver abajo). */
  .fila-valores {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: flex-start;
    gap: 2px var(--space-md);
    font-variant-numeric: tabular-nums;
  }

  .usd {
    display: inline-flex;
    align-items: baseline;
    gap: 5px;
  }

  .usd-monto {
    font-size: 1.5rem;
    font-weight: 800;
    line-height: 1.15;
    color: var(--ink);
  }

  .fila--intro .usd-monto {
    font-size: clamp(1.75rem, 6vw, 2.125rem);
    color: var(--accent);
  }

  .usd-unidad {
    font-size: var(--fs-label);
    font-weight: 700;
    color: var(--ink-muted);
  }

  .fila--intro .usd-unidad {
    color: var(--accent);
  }

  /* Equivalente en CUP. Mientras se consulta la tasa conserva su espacio (sin saltos de
     layout); si la tasa no llega, desaparece. */
  .cup-hoy {
    margin: 0;
    font-size: var(--fs-small);
    font-weight: 600;
    color: var(--ink-muted);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  /* La cifra en el color de texto principal (blanco en oscuro) para que el precio en CUP
     resalte; "≈" y "CUP" quedan en tono apagado. */
  .cup-num {
    color: var(--ink);
    font-weight: 700;
  }

  .precios-section[data-tasa-estado='cargando'] .cup-hoy {
    visibility: hidden;
  }

  .precios-section[data-tasa-estado='sin-tasa'] .cup-hoy {
    display: none;
  }

  /* Cómo se paga (o, en el Gratuito, que no cuesta nada). Al pie del bloque de precio:
     en escritorio el chip queda a la misma altura en las cuatro tarjetas. */
  .pago-tag {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    width: fit-content;
    max-width: 100%;
    margin: auto 0 0;
    padding: 4px 8px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-sm);
    font-size: var(--fs-caption);
    font-weight: 700;
    line-height: 1.3;
    color: var(--ink-muted);
  }

  .pago-opcion {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .pago-icono {
    color: var(--accent);
    flex-shrink: 0;
  }

  /* Plan Gratuito: mismo ritmo que la fila "1.er mes" de los planes de pago */
  .fila--intro .usd-monto:only-child {
    line-height: 1;
  }

  /* === Límites: filas etiqueta/valor === */
  .card-limits {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--line);
    margin: 0 0 var(--space-md);
  }

  .limit-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    padding: 10px 0;
    border-bottom: 1px solid var(--line);
  }

  .limit-row dt {
    font-size: var(--fs-small);
    color: var(--ink-muted);
  }

  .limit-row dd {
    font-size: var(--fs-small);
    font-weight: 700;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }

  .card-features {
    margin-bottom: var(--space-md);
    flex-grow: 1;
  }

  .card-features ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .card-features li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-xs);
    font-size: var(--fs-small);
    font-weight: 600;
    color: var(--ink);
  }

  .check-icon {
    color: var(--accent);
    flex-shrink: 0;
  }

  /* En una sola columna no hay filas compartidas: la fila vacía no ocupa espacio */
  .card-features--empty {
    display: none;
  }

  .card-action {
    margin-top: auto;
  }

  /* Relleno lateral menor: en la tarjeta estrecha de escritorio "Empezar gratis" no debe
     partirse en dos líneas (el botón saldría más alto que los demás). */
  .card-action :global(.plan-cta-btn) {
    padding-inline: var(--space-md);
  }

  /* === Así pagas en moneda nacional === */
  .pasos {
    margin-top: clamp(var(--space-lg), 5vw, var(--space-2xl));
    background: var(--plate);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: clamp(18px, 5vw, var(--space-lg));
  }

  .pasos-titulo {
    font-size: clamp(var(--fs-title), 2.5vw, 1.25rem);
    font-weight: 800;
    margin-bottom: var(--space-md);
  }

  .pasos-lista {
    list-style: none;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-md);
  }

  .pasos-lista li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-md);
    align-items: start;
  }

  .paso-n {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: var(--radius-md);
    background: var(--accent);
    color: var(--accent-on);
    font-weight: 800;
    font-variant-numeric: tabular-nums;
  }

  .pasos-lista strong {
    display: block;
    line-height: 1.3;
    margin-bottom: 2px;
  }

  .pasos-lista p {
    font-size: var(--fs-small);
    color: var(--ink-muted);
  }

  /* 2 columnas en tablet; 4 solo cuando el contenedor está a su ancho máximo */
  @media (min-width: 40rem) {
    .pricing-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      /* row-gap 0: el gap del padre se heredaría entre las filas internas del subgrid */
      row-gap: 0;
      column-gap: var(--space-lg);
    }

    /* Subgrid: cabecera, precio, límites, extras y botón alineados entre tarjetas */
    .pricing-card {
      display: grid;
      grid-template-rows: subgrid;
      grid-row: span 5;
      row-gap: 0;
      margin-bottom: var(--space-xl);
    }

    /* Con filas compartidas la fila de extras debe existir aunque esté vacía */
    .card-features--empty {
      display: block;
      margin-bottom: 0;
    }

    .card-action {
      align-self: end;
    }
  }

  @media (min-width: 52rem) {
    .pasos-lista {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 0;
    }

    .pasos-lista li {
      padding-inline: var(--space-lg);
      border-left: 1px solid var(--line);
    }

    .pasos-lista li:first-child {
      padding-left: 0;
      border-left: none;
    }
  }

  @media (min-width: 72rem) {
    .pricing-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      column-gap: var(--space-md);
    }

    .pricing-card {
      padding: var(--space-lg);
      margin-bottom: 0;
    }

    /* Cuatro columnas estrechas: los montos en CUP a la derecha forman una columna legible */
    .fila-valores {
      justify-content: space-between;
      gap: 2px var(--space-sm);
    }

    .badge {
      left: var(--space-lg);
    }
  }
</style>

<script>
  interface Tasa {
    usd: number;
    tomadaEn: string;
    edadSeg: number;
    recibidoMs: number;
  }

  const CLAVE_CACHE = 'mipyutil:tasa-usd';
  // Una tasa guardada en el navegador se reutiliza este tiempo sin volver a pedirla.
  const VIGENCIA_CACHE_MS = 10 * 60 * 1000;
  const ESPERA_MAX_MS = 4000;

  // Monto con separador de miles "." y coma decimal, sin redondear: solo se
  // limpia el error de coma flotante a centavos (2266.5 sale "2.266,5").
  const formatoMonto = (n: number): string => {
    const [entera, decimales] = (Math.round(n * 100) / 100).toFixed(2).split('.');
    const miles = entera.replace(/\B(?=(\d{3})+(?!\d))/g, '.');
    const dec = decimales.replace(/0+$/, '');
    return dec ? `${miles},${dec}` : miles;
  };

  // Fecha y hora de Cuba a partir del instante que manda el servidor: no depende
  // del reloj del teléfono, que en Cuba suele estar mal puesto.
  const textoHora = (iso: string): string =>
    new Intl.DateTimeFormat('es', {
      timeZone: 'America/Havana',
      day: 'numeric',
      month: 'short',
      hour: 'numeric',
      minute: '2-digit',
      hour12: true
    }).format(new Date(iso));

  const validar = (x: any): Tasa | null => {
    const usd = Number(x?.usd);
    const edadSeg = Number(x?.edadSeg);
    const recibidoMs = Number(x?.recibidoMs);
    if (!Number.isFinite(usd) || usd <= 0) return null;
    if (!Number.isFinite(edadSeg) || edadSeg < 0 || !Number.isFinite(recibidoMs)) return null;
    if (typeof x?.tomadaEn !== 'string' || Number.isNaN(Date.parse(x.tomadaEn))) return null;
    return { usd, tomadaEn: x.tomadaEn, edadSeg, recibidoMs };
  };

  const leerCache = (): Tasa | null => {
    try {
      const crudo = localStorage.getItem(CLAVE_CACHE);
      return crudo ? validar(JSON.parse(crudo)) : null;
    } catch {
      return null;
    }
  };

  // Antigüedad de la tasa: la que calculó el servidor al responder, más lo que
  // pasó desde entonces en este navegador (diferencia de relojes propios, válida
  // aunque la fecha del teléfono esté mal).
  const edadActualSeg = (t: Tasa): number => t.edadSeg + Math.max(0, (Date.now() - t.recibidoMs) / 1000);

  const pedirTasa = async (url: string): Promise<Tasa | null> => {
    const controlador = new AbortController();
    const temporizador = setTimeout(() => controlador.abort(), ESPERA_MAX_MS);
    try {
      const res = await fetch(url, { signal: controlador.signal });
      if (!res.ok) return null;
      const cuerpo = await res.json();
      const tasa = validar({
        usd: cuerpo?.usd,
        tomadaEn: cuerpo?.tomada_en,
        edadSeg: cuerpo?.edad_seg,
        recibidoMs: Date.now()
      });
      if (tasa) {
        try {
          localStorage.setItem(CLAVE_CACHE, JSON.stringify(tasa));
        } catch {
          /* sin almacenamiento: se pide de nuevo la próxima vez */
        }
      }
      return tasa;
    } catch {
      return null;
    } finally {
      clearTimeout(temporizador);
    }
  };

  // Tasa fresca de la caché local si la hay; si no, la pide. Si la consulta falla
  // devuelve la última guardada (aunque sea vieja) para que quien decide sea la
  // regla de antigüedad máxima, no la red.
  const obtenerTasa = async (url: string): Promise<Tasa | null> => {
    const guardada = leerCache();
    if (guardada) {
      const transcurrido = Date.now() - guardada.recibidoMs;
      if (transcurrido >= 0 && transcurrido < VIGENCIA_CACHE_MS) return guardada;
    }
    return (await pedirTasa(url)) ?? guardada;
  };

  document.addEventListener('DOMContentLoaded', () => {
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const TRANSITION_MS = 140;

    const seccion = document.querySelector<HTMLElement>('#precios');
    const group = document.querySelector('.billing-toggle');
    if (!seccion || !group) return;

    const grid = seccion.querySelector<HTMLElement>('.pricing-grid');
    const estadoVoz = seccion.querySelector<HTMLElement>('#precios-estado');
    const whatsapp = seccion.dataset.whatsapp ?? '';
    const tasaUrl = seccion.dataset.tasaUrl ?? '';
    const maxEdadSeg = Number(seccion.dataset.tasaMaxHoras ?? 24) * 3600;

    const options = Array.from(group.querySelectorAll<HTMLElement>('.billing-option'));
    const planButtons = Array.from(seccion.querySelectorAll<HTMLAnchorElement>('.plan-cta-btn'));
    const cupLines = Array.from(seccion.querySelectorAll<HTMLElement>('.cup-hoy'));
    const valorTasa = seccion.querySelector<HTMLElement>('.tasa-valor');
    const horaTasa = seccion.querySelector<HTMLTimeElement>('.tasa-hora');

    // Solo hay tasa cuando es reciente; si no, la página queda en USD y WhatsApp.
    let tasa: Tasa | null = null;
    let cambiando = false;

    const mensajeWhatsApp = (btn: HTMLAnchorElement): string => {
      const nombre = btn.dataset.planName ?? '';
      if (seccion.dataset.billing === 'annual') {
        return `Hola, me interesa el plan anual ${nombre} de la app MiPyUtil`;
      }
      let mensaje = `Hola, me interesa el plan mensual ${nombre} de la app MiPyUtil. Vi $${btn.dataset.planIntro} USD el primer mes y $${btn.dataset.planPrice} USD al mes después.`;
      if (tasa) {
        mensaje += ` Tasa que vi: 1 USD = ${formatoMonto(tasa.usd)} CUP (elTOQUE, ${textoHora(tasa.tomadaEn)}).`;
      }
      return mensaje;
    };

    const actualizarEnlaces = () => {
      planButtons.forEach((btn) => {
        if (btn.dataset.planName) {
          btn.href = `https://wa.me/${whatsapp}?text=${encodeURIComponent(mensajeWhatsApp(btn))}`;
        }
      });
    };

    const aplicarTasa = (nueva: Tasa | null) => {
      const vigente = nueva !== null && edadActualSeg(nueva) <= maxEdadSeg;
      tasa = vigente ? nueva : null;
      seccion.dataset.tasaEstado = tasa ? 'listo' : 'sin-tasa';

      if (tasa) {
        const { usd, tomadaEn } = tasa;
        if (valorTasa) valorTasa.textContent = formatoMonto(usd);
        if (horaTasa) {
          horaTasa.textContent = textoHora(tomadaEn);
          horaTasa.dateTime = tomadaEn;
        }
        cupLines.forEach((linea) => {
          const num = linea.querySelector<HTMLElement>('.cup-num');
          if (num) num.textContent = formatoMonto(Number(linea.dataset.usd) * usd);
        });
      }
      actualizarEnlaces();
    };

    const consultarTasa = async () => {
      if (!tasaUrl) return aplicarTasa(null);
      aplicarTasa(await obtenerTasa(tasaUrl));
    };

    consultarTasa();

    // Pestaña abierta por horas: al volver a ella se renueva la tasa si ya venció la caché.
    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'visible') consultarTasa();
    });

    // Mensual y anual ya están los dos en el HTML: cambiar es cambiar `data-billing`.
    const applyBilling = async (mode: string) => {
      if (cambiando || seccion.dataset.billing === mode) return;
      cambiando = true;

      options.forEach((opt) => {
        opt.setAttribute('aria-pressed', String(opt.dataset.billing === mode));
      });

      if (grid && !reduceMotion) {
        grid.classList.add('cambiando');
        await new Promise((resolve) => setTimeout(resolve, TRANSITION_MS));
      }

      seccion.dataset.billing = mode;
      if (estadoVoz) {
        estadoVoz.textContent = mode === 'annual' ? 'Mostrando precios anuales.' : 'Mostrando precios mensuales.';
      }
      actualizarEnlaces();

      if (grid && !reduceMotion) {
        void grid.offsetHeight;
        grid.classList.remove('cambiando');
      }
      cambiando = false;
    };

    options.forEach((opt) => {
      opt.addEventListener('click', () => applyBilling(opt.dataset.billing || ''));
    });
  });
</script>
