---
import PhoneMockup from '../PhoneMockup.astro';
import AppScreen from '../ui/AppScreen.astro';
import { realScreenshot } from '../../lib/screens';
import type { Screen } from '../../lib/screens';

interface Moment {
  time: string;
  screen: Screen;
  state?: 'activo' | 'inicio';
  clock: string;
  alt: string;
  title: string;
  description: string;
}

const moments: Moment[] = [
  {
    time: '8:00 AM',
    screen: 'mi-turno',
    state: 'inicio',
    clock: '8:00',
    alt: 'Pantalla Mi turno con el turno recién abierto y sin ventas todavía (datos de ejemplo)',
    title: 'El dependiente abre su turno.',
    description: 'Llega, abre el teléfono, inicia el turno y está listo para vender.'
  },
  {
    time: 'Durante el día',
    screen: 'mi-turno',
    clock: '11:50',
    alt: 'Pantalla Mi turno con el dinero del turno y las ventas del día (datos de ejemplo)',
    title: 'Vende y cobra.',
    description: 'Efectivo, transferencia o mixto, con el cambio calculado y el inventario descontado automáticamente.'
  },
  {
    time: 'Al cerrar',
    screen: 'cuadres',
    clock: '8:05',
    alt: 'Pantalla Cuadres con un cuadre pendiente de aprobar (datos de ejemplo)',
    title: 'Cierra y rinde cuentas.',
    description: 'Envía su cuadre. Tú lo apruebas o lo rechazas desde tu casa.'
  }
];
---

<section id="como-funciona" class="como-funciona veta veta--b">
  <div class="container">
    <h2>Así se trabaja un día con MiPyUtil.</h2>
    <p class="section-lead">Desde que abre la tienda hasta que se aprueba el cuadre.</p>
    <p class="example-note">Pantallas de ejemplo con datos ficticios.</p>

    <div class="day">
      <ol class="moments">
        {moments.map((moment, i) => (
          <li class:list={['moment', { 'is-active': i === 0 }]} data-index={i}>
            <div class="moment-copy">
              <p class="moment-time">{moment.time}</p>
              <h3>{moment.title}</h3>
              <p class="moment-text">{moment.description}</p>
            </div>
            <div class="moment-phone">
              <PhoneMockup screen={moment.screen} state={moment.state} time={moment.clock} alt={moment.alt} compact peek />
            </div>
          </li>
        ))}
      </ol>

      {/* Escritorio: un solo teléfono que sigue la lectura. Cada pantalla se
          apila en la misma celda y solo la del momento activo es visible. */}
      <div class="day-stage">
        <div class="stage-sticky">
          <PhoneMockup alt="Pantalla de la app que cambia con cada momento del día (datos de ejemplo)">
            {moments.map((moment, i) => {
              const shot = moment.state === 'inicio' ? undefined : realScreenshot(moment.screen);
              return (
                <div class:list={['stage-screen', { 'is-on': i === 0 }]} data-index={i}>
                  {shot ? (
                    <img class="stage-shot" src={`/screens/${shot}`} alt="" width="1080" height="2340" loading="lazy" decoding="async" />
                  ) : (
                    <AppScreen screen={moment.screen} state={moment.state} time={moment.clock} />
                  )}
                </div>
              );
            })}
          </PhoneMockup>
        </div>
      </div>
    </div>

    <p class="section-close">
      <svg class="revert-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <polyline points="1 4 1 10 7 10"></polyline>
        <path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"></path>
      </svg>
      Si rechazas un cuadre, el inventario se revierte automáticamente. Nadie se queda con el beneficio de la duda.
    </p>
  </div>
</section>

<script>
  // El momento que cruza el centro de la pantalla manda: enciende su marca y
  // cambia la pantalla del teléfono fijo. Sin listener de scroll.
  const section = document.querySelector<HTMLElement>('#como-funciona');

  if (section && 'IntersectionObserver' in window) {
    const moments = Array.from(section.querySelectorAll<HTMLElement>('.moment'));
    const screens = Array.from(section.querySelectorAll<HTMLElement>('.stage-screen'));

    const setActive = (index: number) => {
      moments.forEach((el, i) => el.classList.toggle('is-active', i === index));
      screens.forEach((el, i) => el.classList.toggle('is-on', i === index));
    };

    // El activo es el último momento cuyo borde superior ya pasó la mitad de la
    // pantalla. Se recalcula desde las posiciones reales (no desde qué momento
    // "entró"), así un salto brusco de scroll no deja el teléfono atrasado.
    const update = () => {
      const line = window.innerHeight * 0.5;
      let active = 0;
      moments.forEach((el, i) => {
        if (el.getBoundingClientRect().top <= line) active = i;
      });
      setActive(active);
    };

    // Dos observadores como disparadores: la franja central (cruce de la línea)
    // y el viewport (entrada y salida). `scrollend` cubre el salto más brusco.
    const band = new IntersectionObserver(update, { rootMargin: '-42% 0px -42% 0px' });
    const viewport = new IntersectionObserver(update, { threshold: [0, 1] });
    moments.forEach((el) => {
      band.observe(el);
      viewport.observe(el);
    });
    window.addEventListener('scrollend', update);
    update();
  }
</script>

<style>
  .como-funciona h2 {
    margin-bottom: clamp(var(--space-sm), 3vw, var(--space-md));
  }

  .section-lead {
    margin-bottom: var(--space-xs);
    font-size: clamp(var(--fs-body), 2.5vw, var(--fs-lead));
    line-height: var(--lh-lead);
    color: var(--ink-muted);
  }

  .example-note {
    margin-bottom: clamp(var(--space-lg), 5vw, var(--space-2xl));
    font-size: var(--fs-caption);
    color: var(--ink-muted);
  }

  .day {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }

  /* Riel de la jornada: una línea y un remache por momento. La hora es el
     encabezado; no hace falta numerar lo que ya está ordenado en el tiempo. */
  .moments {
    position: relative;
    list-style: none;
  }

  .moments::before {
    content: '';
    position: absolute;
    top: 8px;
    bottom: 8px;
    left: 5px;
    width: 1px;
    background: var(--line-strong);
  }

  .moment {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-xs);
    padding: 0 0 clamp(var(--space-xl), 7vw, var(--space-2xl)) 2rem;
  }

  .moment:last-child {
    padding-bottom: 0;
  }

  .moment::before {
    content: '';
    position: absolute;
    top: 0.3em;
    left: 0;
    width: 11px;
    height: 11px;
    border: 2px solid var(--line-strong);
    border-radius: 50%;
    background: var(--board);
    transition: background-color var(--dur-routine) ease-out, border-color var(--dur-routine) ease-out;
  }

  .moment.is-active::before {
    border-color: var(--accent);
    background: var(--accent);
  }

  .moment-time {
    margin-bottom: var(--space-xs);
    font-size: var(--fs-headline);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.01em;
    color: var(--ink-muted);
    font-variant-numeric: tabular-nums;
    transition: color var(--dur-routine) ease-out;
  }

  .moment.is-active .moment-time {
    color: var(--accent);
  }

  .moment h3 {
    font-size: clamp(var(--fs-title), 2.5vw, 1.375rem);
  }

  .moment-text {
    color: var(--ink-muted);
    font-size: clamp(0.9375rem, 2.5vw, var(--fs-body));
    line-height: 1.6;
  }

  .moment-phone {
    margin-top: var(--space-md);
  }

  .day-stage {
    display: none;
  }

  .section-close {
    display: flex;
    align-items: flex-start;
    gap: var(--space-sm);
    max-width: 60ch;
    margin-top: clamp(var(--space-xl), 6vw, var(--space-2xl));
    font-size: clamp(var(--fs-body), 2.5vw, var(--fs-lead));
    font-weight: 600;
    line-height: var(--lh-lead);
    color: var(--ink-muted);
  }

  .revert-icon {
    flex-shrink: 0;
    width: clamp(20px, 5vw, 24px);
    height: clamp(20px, 5vw, 24px);
    margin-top: 2px;
    color: var(--accent);
  }

  /* Tablet: texto a la izquierda, teléfono asomado a la derecha en cada momento. */
  @media (min-width: 40rem) and (max-width: 63.99rem) {
    .moment {
      grid-template-columns: minmax(0, 1fr) 13.5rem;
      column-gap: var(--space-xl);
      align-items: start;
    }

    .moment-phone {
      margin-top: 0;
    }
  }

  /* Escritorio: un teléfono fijo, tres momentos que pasan. */
  @media (min-width: 64rem) {
    .day {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
      column-gap: var(--space-3xl);
      align-items: start;
    }

    /* Alto suficiente para que el teléfono fijo alcance a cambiar de pantalla
       mientras se lee cada momento, sin dejar un vacío del tamaño de otra
       sección entre uno y el siguiente. */
    .moment {
      min-height: clamp(220px, 34vh, 340px);
      padding-bottom: 0;
      align-content: start;
    }

    .moment:last-child {
      min-height: 0;
    }

    .moment-phone {
      display: none;
    }

    .day-stage {
      display: block;
      align-self: stretch;
    }

    .stage-sticky {
      position: sticky;
      top: max(88px, calc(50vh - 300px));
      display: grid;
      justify-items: center;
      gap: var(--space-md);
    }

    .stage-sticky :global(.phone-mockup) {
      --phone-w: 270px;
    }

    /* Pantallas apiladas: la saliente se apaga rápido y la entrante llega un
       poco después y más despacio. El desenfoque ligero une las dos en un solo
       cambio en vez de dos objetos cruzándose. */
    .stage-screen {
      position: absolute;
      inset: 0;
      opacity: 0;
      filter: blur(3px);
      transform: scale(0.985);
      transition: opacity 120ms ease-out, filter 120ms ease-out, transform 120ms ease-out;
      pointer-events: none;
    }

    .stage-screen.is-on {
      opacity: 1;
      filter: none;
      transform: none;
      transition-duration: 240ms;
      transition-timing-function: var(--ease-out-expo);
      transition-delay: 60ms;
    }

    .stage-shot {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
  }
</style>
