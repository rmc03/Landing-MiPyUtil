---
interface Props {
  variant?: 'primary' | 'secondary';
  icon?: 'download' | 'whatsapp' | 'telegram' | 'android' | 'windows';
  href?: string;
  type?: 'button' | 'link';
  onClick?: string;
  disabled?: boolean;
  loading?: boolean;
  fullWidth?: boolean;
  stamp?: boolean;
  class?: string;
  target?: string;
  rel?: string;
  [key: string]: any;
}

const {
  variant = 'primary',
  icon,
  href = '#',
  type = 'link',
  onClick,
  disabled = false,
  loading = false,
  fullWidth = false,
  stamp = false,
  target,
  rel,
  class: className,
  ...rest
} = Astro.props;
---

{type === 'button' ? (
  <button
    class={`btn btn-${variant} ${fullWidth ? 'btn-full' : ''} ${stamp ? 'btn-stamp' : ''} ${className || ''}`}
    onclick={onClick}
    type="button"
    disabled={disabled || loading}
    aria-busy={loading}
    {...rest}
  >
    {loading && (
      <svg class="spinner" viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="12" cy="12" r="10" stroke="currentColor" fill="none" stroke-width="3" stroke-dasharray="63" stroke-dashoffset="0">
          <animate attributeName="stroke-dashoffset" from="0" to="63" dur="1s" repeatCount="indefinite" />
        </circle>
      </svg>
    )}
    <span class:list={{ 'btn-content': true, 'loading': loading }}>
      {icon === 'download' && (
        <svg class="btn-icon btn-icon--download" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
          <polyline points="7 10 12 15 17 10"></polyline>
          <line x1="12" y1="15" x2="12" y2="3"></line>
        </svg>
      )}
      {icon === 'android' && (
        <svg class="btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M4 10v6" />
          <path d="M20 10v6" />
          <path d="M7 9h10v8a1 1 0 0 1-1 1H8a1 1 0 0 1-1-1V9a5 5 0 0 1 10 0" />
          <circle cx="10" cy="7.5" r="0.75" fill="currentColor" stroke="none" />
          <circle cx="14" cy="7.5" r="0.75" fill="currentColor" stroke="none" />
          <path d="M8 3l1.5 2.5" />
          <path d="M16 3l-1.5 2.5" />
          <path d="M9 18v3" />
          <path d="M15 18v3" />
        </svg>
      )}
      {icon === 'windows' && (
        <svg class="btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3" y="3" width="8" height="8" rx="1" />
          <rect x="13" y="3" width="8" height="8" rx="1" />
          <rect x="3" y="13" width="8" height="8" rx="1" />
          <rect x="13" y="13" width="8" height="8" rx="1" />
        </svg>
      )}
      {icon === 'whatsapp' && (
        <svg class="btn-icon btn-icon--whatsapp" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M3 21l1.65-3.8a9 9 0 1 1 3.4 2.9L3 21" />
          <path d="M9 10a.5.5 0 0 0 1 0V9a.5.5 0 0 0-1 0v1a5 5 0 0 0 5 5h1a.5.5 0 0 0 0-1h-1a.5.5 0 0 0 0 1" />
        </svg>
      )}
      {icon === 'telegram' && (
        <svg class="btn-icon btn-icon--telegram" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M15 10l-4 4l6 6l4-16-18 7 4 2 2 6 3-4" />
        </svg>
      )}
      <slot />
    </span>
  </button>
) : (
  <a
    href={href}
    target={target}
    rel={rel || (target === '_blank' ? 'noopener noreferrer' : undefined)}
    class={`btn btn-${variant} ${fullWidth ? 'btn-full' : ''} ${stamp ? 'btn-stamp' : ''} ${className || ''}`}
    {...rest}
  >
    <span class="btn-content">
      {icon === 'download' && (
        <svg class="btn-icon btn-icon--download" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
          <polyline points="7 10 12 15 17 10"></polyline>
          <line x1="12" y1="15" x2="12" y2="3"></line>
        </svg>
      )}
      {icon === 'android' && (
        <svg class="btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M4 10v6" />
          <path d="M20 10v6" />
          <path d="M7 9h10v8a1 1 0 0 1-1 1H8a1 1 0 0 1-1-1V9a5 5 0 0 1 10 0" />
          <circle cx="10" cy="7.5" r="0.75" fill="currentColor" stroke="none" />
          <circle cx="14" cy="7.5" r="0.75" fill="currentColor" stroke="none" />
          <path d="M8 3l1.5 2.5" />
          <path d="M16 3l-1.5 2.5" />
          <path d="M9 18v3" />
          <path d="M15 18v3" />
        </svg>
      )}
      {icon === 'windows' && (
        <svg class="btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3" y="3" width="8" height="8" rx="1" />
          <rect x="13" y="3" width="8" height="8" rx="1" />
          <rect x="3" y="13" width="8" height="8" rx="1" />
          <rect x="13" y="13" width="8" height="8" rx="1" />
        </svg>
      )}
      {icon === 'whatsapp' && (
        <svg class="btn-icon btn-icon--whatsapp" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M3 21l1.65-3.8a9 9 0 1 1 3.4 2.9L3 21" />
          <path d="M9 10a.5.5 0 0 0 1 0V9a.5.5 0 0 0-1 0v1a5 5 0 0 0 5 5h1a.5.5 0 0 0 0-1h-1a.5.5 0 0 0 0 1" />
        </svg>
      )}
      {icon === 'telegram' && (
        <svg class="btn-icon btn-icon--telegram" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M15 10l-4 4l6 6l4-16-18 7 4 2 2 6 3-4" />
        </svg>
      )}
      <slot />
    </span>
  </a>
)}

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: clamp(6px, 1.5vw, 8px);
    padding: clamp(12px, 2.5vw, 16px) clamp(20px, 4vw, 26px);
    font-size: clamp(0.9375rem, 2.5vw, var(--fs-body));
    font-weight: 800;
    font-family: var(--font-body);
    border-radius: var(--radius-md);
    transition: background-color var(--dur-routine) ease,
                border-color var(--dur-routine) ease,
                color var(--dur-routine) ease,
                box-shadow var(--dur-feedback) ease,
                transform var(--dur-feedback) ease;
    text-align: center;
    cursor: pointer;
    border: 1.5px solid transparent;
    position: relative;
    text-decoration: none;
    line-height: 1.4;
    white-space: normal;
    min-height: 44px;
  }

  .btn-full {
    width: 100%;
  }

  @media (pointer: coarse) {
    .btn {
      min-height: 48px;
    }
  }

  .btn[disabled] {
    opacity: 0.5;
    cursor: not-allowed;
    pointer-events: none;
  }

  /* === PRIMARY === */
  .btn-primary {
    background: var(--accent);
    color: var(--accent-on);
    border-color: var(--accent);
  }

  .btn-primary:hover {
    background: var(--accent-deep);
    border-color: var(--accent-deep);
  }

  /* === SECONDARY === */
  .btn-secondary {
    background: var(--plate);
    color: var(--ink);
    border-color: var(--line-strong);
  }

  .btn-secondary:hover {
    background: var(--board-panel);
    color: var(--accent);
    border-color: var(--accent);
  }

  /* === ESTAMPADO ===
     Gesto de firma, máximo dos usos por página (ver DESIGN.md). */
  .btn-stamp {
    box-shadow: var(--shadow-stamp);
  }

  .btn-stamp:hover,
  .btn-stamp:focus-visible {
    box-shadow: var(--shadow-stamp-pressed);
    transform: translate(2px, 2px);
  }

  @media (prefers-reduced-motion: reduce) {
    .btn-stamp:hover,
    .btn-stamp:focus-visible {
      transform: none;
    }
  }

  /* === SPINNER === */
  .spinner {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
  }

  /* === CONTENT === */
  .btn-content {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
  }

  .btn-content.loading {
    opacity: 0.6;
  }

  /* === ICONS === */
  .btn-icon {
    width: clamp(18px, 4vw, 20px);
    height: clamp(18px, 4vw, 20px);
    flex-shrink: 0;
    transition: transform var(--dur-routine) var(--ease-out-expo);
  }

  /* === FOCUS === */
  .btn:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  /* === MOTION === */
  @media (prefers-reduced-motion: no-preference) {
    .btn:hover .btn-icon--download,
    .btn:focus-visible .btn-icon--download {
      transform: translateY(2px);
    }

    .btn:hover .btn-icon--whatsapp,
    .btn:focus-visible .btn-icon--whatsapp {
      transform: translateX(2px);
    }

    .btn:hover .btn-icon--telegram,
    .btn:focus-visible .btn-icon--telegram {
      transform: translate(1px, -1px);
    }
  }

  @media (hover: none) and (pointer: coarse) {
    .btn:active {
      transform: translateY(0) scale(0.97);
    }
  }
</style>
