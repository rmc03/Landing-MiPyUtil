---
const negocios = [
  'Puntos de Venta',
  'Cafeterías y bares',
  'Tiendas de ropa o calzado',
  'Talleres de celulares y electrónica',
  'Ferreterías',
  'Almacenes'
];
---

<section id="para-quien" class="para-quien">
  <div class="container">
    <h2>Hecho para el negocio que ya existe.</h2>
    
    <div class="negocios-grid">
      {negocios.map(negocio => (
        <div class="negocio-card">
          <h3>{negocio}</h3>
        </div>
      ))}
    </div>

    <p class="section-note">
      ¿Tu negocio no está en la lista? <a href="#">Escríbenos por WhatsApp o Telegram</a> y lo adaptamos.
    </p>
  </div>
</section>

<style>
  .para-quien h2 {
    margin-bottom: clamp(var(--space-lg), 5vw, var(--space-xl));
    font-size: clamp(var(--fs-title), 4vw, var(--fs-headline));
  }

  .negocios-grid {
    display: grid;
    gap: clamp(var(--space-md), 4vw, var(--space-lg));
    margin-bottom: clamp(var(--space-lg), 5vw, var(--space-xl));
  }

  .negocio-card {
    background: var(--surface);
    padding: clamp(var(--space-lg), 5vw, var(--space-xl));
    border-radius: var(--radius-lg);
    border: 1px solid var(--line);
    text-align: center;
    transition: border-color 200ms ease;
    min-height: 80px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  .negocio-card:hover {
    border-color: var(--primary);
  }
  
  .negocio-card h3 {
    color: var(--ink);
    font-size: clamp(var(--fs-title), 2.5vw, var(--fs-xl));
    margin: 0;
  }

  .section-note {
    font-size: clamp(var(--fs-caption), 2vw, var(--fs-small));
    color: var(--ink-secondary);
    text-align: center;
    line-height: 1.6;
  }

  @media (min-width: 40rem) {
    .negocios-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 64rem) {
    .negocios-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
