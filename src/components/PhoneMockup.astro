---
import ScreenSkeleton from './ui/ScreenSkeleton.astro';

export interface Props {
  screenshot: string;
  alt: string;
  compact?: boolean;
}

const { screenshot, alt, compact = false } = Astro.props;
const lightSrc = `/screens/${screenshot}`;
const darkSrc = `/screens/${screenshot.replace(/\.png$/i, '-dark.png')}`;
const screenId = screenshot.replace(/\.png$/i, '');
---

<div class:list={['phone-mockup', { compact }]}>
  <div class="phone-frame">
    <div class="phone-notch"></div>
    <div class="phone-screen">
      <ScreenSkeleton screen={screenId} />
      <img
        class="phone-shot"
        src={darkSrc}
        data-light-src={lightSrc}
        data-dark-src={darkSrc}
        alt={alt}
        loading="lazy"
      />
    </div>
  </div>
</div>

<script>
  const shots = Array.from(document.querySelectorAll<HTMLImageElement>('.phone-shot'));
  const darkFailed = new WeakSet<HTMLImageElement>();

  shots.forEach((img) => {
    img.addEventListener('error', () => {
      const current = img.getAttribute('src');
      if (current === img.dataset.darkSrc && !darkFailed.has(img)) {
        darkFailed.add(img);
        img.setAttribute('src', img.dataset.lightSrc!);
      } else {
        img.classList.add('img-failed');
      }
    });
  });
</script>

<style>
  .phone-mockup {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    max-width: 100%;
  }

  .phone-frame {
    position: relative;
    width: 100%;
    max-width: min(260px, 85vw);
    aspect-ratio: 9 / 19.5;
    background: var(--ink);
    border-radius: clamp(16px, 4vw, var(--radius-phone)); /* impeccable-disable-line design-system-radius -- radio fluido del marco */
    padding: clamp(6px, 1.5vw, 12px);
    box-shadow: var(--shadow-subtle);
  }

  @media (prefers-reduced-motion: no-preference) {
    .phone-frame {
      transition: transform var(--dur-routine) var(--ease-out-expo), box-shadow var(--dur-routine) var(--ease-out-expo);
    }

    .phone-frame:hover {
      transform: translateY(-3px);
      box-shadow: var(--shadow-card);
    }
  }

  .dark-band .phone-frame {
    background: var(--surface-tertiary);
    box-shadow: var(--shadow-subtle);
  }

  .phone-notch {
    position: absolute;
    top: clamp(6px, 1.5vw, 12px);
    left: 50%;
    transform: translateX(-50%);
    width: clamp(70px, 18vw, 120px);
    height: clamp(14px, 3.5vw, 24px);
    background: var(--surface);
    border-radius: 0 0 clamp(10px, 2.5vw, 16px) clamp(10px, 2.5vw, 16px); /* impeccable-disable-line design-system-radius -- radio fluido de la muesca */
    z-index: 2;
  }

  .phone-screen {
    width: 100%;
    height: 100%;
    background: var(--surface);
    border-radius: calc(clamp(16px, 4vw, var(--radius-phone)) - 6px); /* impeccable-disable-line design-system-radius -- radio fluido del marco */
    overflow: hidden;
    position: relative;
  }

  .phone-screen .phone-shot {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .phone-screen .phone-shot.img-failed {
    display: none;
  }

  /* Compact (hero): teléfono más pequeño para no robar protagonismo al texto */
  .phone-mockup.compact .phone-frame {
    max-width: min(200px, 75vw);
  }

  @media (min-width: 23.4375rem) {
    .phone-frame {
      max-width: min(280px, 80vw);
    }

    .phone-mockup.compact .phone-frame {
      max-width: min(220px, 75vw);
    }
  }

  @media (min-width: 40rem) {
    .phone-frame {
      max-width: 270px;
    }

    .phone-mockup.compact .phone-frame {
      max-width: 240px;
    }
  }

  @media (min-width: 48rem) {
    .phone-frame {
      max-width: 290px;
    }

    .phone-mockup.compact .phone-frame {
      max-width: 250px;
    }
  }

  @media (min-width: 64rem) {
    .phone-frame {
      max-width: 320px;
    }

    .phone-mockup.compact .phone-frame {
      max-width: 260px;
    }
  }
</style>
