---
/**
 * THESIS: La landing es la app. Refusa el patrón SaaS genérico (hero + grid + pricing)
 * y replica el panel de control de MiPyUtil: cada sección es una pantalla real.
 * 
 * OWN-WORLD: Clean Focus, tema violeta (#7C3AED, del ícono de la app) sobre neutros oscuros
 * (#16161F background, #1F1F2E surface). Plus Jakarta Sans
 * everywhere (400/500/600/700/800). Radios 8/12/16/32, cards planas, sombra subtle solo
 * en mockups. Screenshots dentro de mockups de teléfono como material central.
 * 
 * STORY: Dueño de MiPyME cubana reconoce su tienda, entiende que inventario/ventas/turnos/cuadre
 * viven en un teléfono que funciona offline, y descarga la APK por WhatsApp/Telegram.
 * 
 * MODULARIZED: Cada sección está en su propio componente para mejor mantenibilidad y reutilización.
 */

import Layout from '../layouts/Layout.astro';
import Hero from '../components/sections/Hero.astro';
import Problema from '../components/sections/Problema.astro';
import ComoFunciona from '../components/sections/ComoFunciona.astro';
import FeatureSection from '../components/sections/FeatureSection.astro';
import Precios from '../components/sections/Precios.astro';
import Descarga from '../components/sections/Descarga.astro';
import FAQ from '../components/sections/FAQ.astro';
---

<Layout
  title="MiPyUtil"
  description="Inventario, ventas y turnos. Todo sin internet."
>
  <Hero />
  <Problema />
  <ComoFunciona />
  
  <!-- Ventas -->
  <FeatureSection
    id="ventas"
    screenshot="03-confirmar-pago.png"
    alt="Pantalla confirmar pago mostrando modos efectivo, transferencia y mixto con QR"
    title="Cobra en efectivo… y también por transferencia."
    class="ventas"
    band
  >
    <ul class="feature-list">
      <li>Modo <strong>Efectivo</strong>, <strong>Transferencia</strong> o <strong>Mixto</strong> con cálculo de cambio al vuelo.</li>
      <li>Muestra tu <strong>QR de pago</strong> en pantalla completa: el cliente escanea desde su app bancaria y paga.</li>
      <li>Gestiona hasta <strong>5 QRs propios</strong> y comparte los del negocio con tu equipo.</li>
    </ul>
    <p class="inline-cta">
      <a href="https://wa.me/5353770707?text=Hola,%20quisiera%20consultar%20sobre%20las%20cuentas%20bancarias%20soportadas%20en%20MiPyUtil" target="_blank" rel="noopener noreferrer">¿Cuentas bancarias soportadas? Escríbenos y te confirmamos tu banco.</a>
    </p>
  </FeatureSection>

  <!-- Inventario -->
  <FeatureSection
    id="inventario"
    screenshot="04-inventario.png"
    alt="Lista de inventario con productos, fotos, búsqueda y alertas de stock bajo"
    title="Saber qué tienes, antes de que te pregunte un cliente."
    class="inventario"
    reverse
  >
    <ul class="feature-list">
      <li>Productos con foto, categoría y precio.</li>
      <li><strong>Alertas de stock bajo:</strong> el inventario te avisa antes de que se agote.</li>
      <li>Búsqueda rápida y exportación del inventario a archivo.</li>
      <li>Cada venta y cada entrada quedan en el <strong>historial de movimientos</strong>.</li>
    </ul>
  </FeatureSection>

  <!-- Ganancias -->
  <FeatureSection
    id="ganancias"
    screenshot="07-ganancias.png"
    alt="Pantalla de ganancias mostrando ventas totales, costo de productos, pagos al equipo y ganancia neta"
    title="Sabe cuánto ganas de verdad, no solo cuánto vendes."
    class="ganancias"
    band
  >
    <ul class="feature-list">
      <li><strong>Resta el costo de tus productos y los pagos a tu equipo</strong> de forma automática.</li>
      <li>Compara tu ganancia de <strong>hoy, la semana o el mes</strong> contra el período anterior.</li>
      <li>Ve tus <strong>productos más vendidos</strong> sin sacar cuentas a mano.</li>
    </ul>
  </FeatureSection>

  <!-- Precios -->
  <Precios />

  <Descarga />
  <FAQ />
</Layout>
